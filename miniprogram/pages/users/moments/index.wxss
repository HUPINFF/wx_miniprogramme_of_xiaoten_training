/* pages/users/moments/index.wxss */

/* ==================== 全局变量 ==================== */
page {
  --bg: #f5f7fa;
  --primary: #07c160;
  --primary-light: #e8f5e9;
  --card: #ffffff;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;
  --shadow-1: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-2: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-3: 0 8rpx 24rpx rgba(0,0,0,0.08);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 20rpx;
  padding-bottom: 60rpx;
}

/* ==================== 网格布局 - 两列 ==================== */
.moments-grid {
  width: calc(100% - 40rpx);
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* ==================== 卡片样式 ==================== */
.moment-card {
  background-color: var(--card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-2);
  border: 2rpx solid #f3f4f6;
  transition: var(--transition);
  position: relative;
}

.moment-card:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-3);
  border-color: var(--primary);
}

/* ==================== 图片/视频区域 ==================== */
.moment-image {
  width: 100%;
  height: 260rpx;
  display: block;
}

.moment-video {
  width: 100%;
  height: 260rpx;
}

/* 图片加载占位 */
.moment-image[src=""] {
  background: linear-gradient(135deg, #e8f5e9, #f0fdf4);
}

/* ==================== 信息区域 ==================== */
.moment-title-wrapper {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
}

.video-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9, #3b7bc8);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 217, 0.2);
}

.moment-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

/* 日期信息 */
.moment-date {
  font-size: 22rpx;
  color: var(--text-hint);
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.moment-date::before {
  content: '📅';
  font-size: 20rpx;
}

/* ==================== 空状态 ==================== */
.empty {
  text-align: center;
  padding: 160rpx 40rpx;
  color: var(--text-hint);
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty::before {
  content: '📸';
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 8rpx;
}

/* ==================== 加载更多 ==================== */
.load-more {
  text-align: center;
  padding: 36rpx;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: var(--transition);
}

.load-more:active {
  opacity: 0.7;
}

.load-more::after {
  content: '↓';
  font-size: 24rpx;
}

/* ==================== 加载状态 ==================== */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(10rpx);
  padding: 48rpx 56rpx;
  border-radius: var(--radius-md);
  color: #fff;
  z-index: 1000;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.loading text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ==================== 顶部渐变装饰（可选） ==================== */
.page-header {
  position: relative;
  padding: 20rpx 0 30rpx;
  text-align: center;
}

.page-header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}