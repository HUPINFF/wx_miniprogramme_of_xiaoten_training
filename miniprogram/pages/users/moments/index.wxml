<view class="container">
  <nav-bar title="更多精彩瞬间"></nav-bar>

  <!-- 精彩瞬间列表（网格布局） -->
  <view class="moments-grid">
    <block wx:for="{{momentsList}}" wx:key="_id">
      <view class="moment-card" bind:tap="viewMomentDetail" data-id="{{item._id}}">
        <!-- 图片 -->
        <image 
          wx:if="{{item.mediaType !== 'video'}}" 
          class="moment-image" 
          src="{{item.image}}" 
          mode="aspectFill"
          lazy-load
        ></image>
        
        <!-- 视频：catch:tap 挂住冒泡，否则点视频想播放却被整卡的「跳详情」劫持 -->
        <video
          wx:else
          catch:tap="stopPropagation"
          class="moment-video"
          src="{{item.video}}" 
          controls 
          show-center-play-btn 
          show-play-btn 
          enable-progress-gesture 
          object-fit="cover" 
          autoplay="{{false}}" 
          poster=""
        ></video>
        
        <!-- 信息区域 -->
        <view class="moment-title-wrapper">
          <text wx:if="{{item.mediaType === 'video'}}" class="video-tag">▶ 视频</text>
          <text class="moment-title">{{item.title}}</text>
          <text class="moment-date" wx:if="{{item.createTime}}">{{item.createTime}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{momentsList.length === 0 && !loading}}" class="empty">
    <text>暂无精彩瞬间</text>
  </view>

  <!-- 加载更多 -->
  <view wx:if="{{hasMore && momentsList.length > 0}}" class="load-more" bindtap="loadMore">
    <text wx:if="{{!loadingMore}}">加载更多</text>
    <text wx:else>加载中...</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>