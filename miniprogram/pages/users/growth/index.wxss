/* ==================== 全局变量 ==================== */
page {
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --accent: #00d2ff;
  --bg-page: #f0f2f5;
  --bg-card: #ffffff;
  --text-primary: #1a1a2e;
  --text-secondary: #4a4a68;
  --text-tertiary: #8a8aa3;
  --border-light: rgba(255, 255, 255, 0.2);
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  
  background-color: var(--bg-page);
}

/* 渐变背景层（从上到下：绿色 → 白色透明） */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(180deg, #07c160 0%, #e8f5e9 60%, rgba(255, 255, 255, 0) 100%);
  z-index: 0;
}

/* 底部波浪过渡（让渐变自然融入白色背景） */
.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg-page) 100%);
}

/* ==================== 页面内容层 ==================== */
.page-content {
  position: relative;
  z-index: 1;
  padding-top: 80rpx; /* 状态栏高度 */
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  padding: 30rpx 40rpx 40rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 400;
}

/* ==================== 最新进步卡片 ==================== */
/* 卡片语言对齐 .chart-section：radius-lg + shadow-md + 同一条绿→青渐变条 */
.hl-card {
  margin: 0 30rpx 10rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.hl-accent {
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
}

/* 退步时不报警。这张卡是给家长看的，红字只会让人焦虑，
   换个琥珀色 + 「继续加油」，但成绩本身照实显示，不粉饰 */
.hl-card.is-down .hl-accent {
  background: linear-gradient(90deg, #ffb020 0%, #ffd666 100%);
}

.hl-body {
  padding: 28rpx 30rpx 30rpx;
}

.hl-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.hl-emoji {
  font-size: 30rpx;
}

.hl-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-dark);
  letter-spacing: 1rpx;
}

.hl-card.is-down .hl-label {
  color: #d48806;
}

.hl-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.hl-metric {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.hl-values {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

/* 主数字：整张卡唯一的重音，和下方图表标题的主色一致 */
.hl-current {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--text-primary);
}

.hl-arrow {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.hl-previous {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.hl-foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f2f5;
}

.hl-delta {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.hl-card.is-down .hl-delta {
  color: #d48806;
}

.hl-dot,
.hl-compare {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ==================== 本月概览条 ====================
   一行两个最容易读懂的数字，先回答「练了多少、进步了几项」，
   细节交给下面的进步卡和分组卡。 */
.overview-strip {
  display: flex;
  align-items: stretch;
  margin: 0 30rpx 24rpx;
  padding: 24rpx 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10rpx);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-num-row {
  display: flex;
  align-items: baseline;
}

.overview-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.overview-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.overview-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.overview-divider {
  width: 1rpx;
  background: #eef0f3;
  margin: 4rpx 0;
}

/* ==================== 进步卡的一句话解读 ==================== */
.hl-story {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ==================== 能力成长（分组卡） ====================
   10 项指标归成 5 个能力域。卡片两列瀑布排布；
   组头一句徽标讲这组的结论（N 项进步/待突破/未测），
   组内每行一个指标：名字 + 最新值 + 方向感知的变化。
   行可点 → 切换下方曲线，取代原来的指标 Tab。 */
.ability-section {
  margin: 8rpx 0 0;
}

.ability-head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 34rpx 20rpx;
}

.ability-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.ability-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.ability-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 20rpx;
  gap: 20rpx;
}

.ability-card {
  width: 345rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx 16rpx;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

/* 5 张卡两列排布，最后一张落单时拉通全宽（协调灵敏 3 项指标，正好宽裕） */
.ability-card:nth-last-child(1):nth-child(odd) {
  width: 100%;
}

.ability-card-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.ability-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
}

.ability-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.ability-badge {
  margin-left: auto;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--bg-page);
  color: var(--text-tertiary);
}

.ability-badge.up {
  background: var(--primary-light);
  color: var(--primary);
}

.ability-badge.none {
  background: var(--bg-page);
  color: var(--text-tertiary);
}

.ability-metrics {
  display: flex;
  flex-direction: column;
}

.metric-row {
  display: flex;
  align-items: baseline;
  padding: 14rpx 12rpx;
  border-radius: var(--radius-sm);
  margin: 0 -12rpx;
  transition: background 0.2s ease;
}

.metric-row-hover {
  background: var(--bg-page);
}

.metric-row.active {
  background: var(--primary-light);
}

.metric-name {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.metric-row.active .metric-name {
  color: var(--primary);
  font-weight: 600;
}

.metric-value {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.metric-value.empty {
  color: var(--text-tertiary);
  font-weight: 400;
  font-size: 24rpx;
}

.metric-delta {
  flex-shrink: 0;
  min-width: 96rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-tertiary);
}

.metric-delta.up {
  color: var(--primary);
}

.metric-delta.down {
  color: #d48806;
}

/* ==================== 教练的观察 ==================== */
.coach-note {
  margin: 24rpx 30rpx 0;
  padding: 30rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.coach-note-hover {
  background: var(--bg-page);
}

.note-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.note-label {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-light);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.note-meta {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.note-more {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.note-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* ==================== 时间选择器 ==================== */
.time-tab-wrapper {
  padding: 20rpx 30rpx 30rpx;
}

.time-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: var(--radius-lg);
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.time-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  transition: all 0.3s ease;
}

.time-tab-item:active {
  opacity: 0.7;
}

.time-icon {
  font-size: 28rpx;
}

.time-tab-item text:last-child {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.time-tab-divider {
  width: 2rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.08);
}

.time-tab-item.active {
  background: var(--primary);
}

.time-tab-item.active text {
  color: #fff;
  font-weight: 600;
}

/* ==================== 图表区域（白色背景）==================== */
.chart-section {
  position: relative;
  z-index: 1;
  margin: 0 30rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.chart-accent {
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
}

.chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
}

.chart-title-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chart-icon {
  font-size: 36rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.chart-badge {
  padding: 8rpx 20rpx;
  background: var(--primary-light);
  border-radius: var(--radius-sm);
}

.badge-text {
  font-size: 22rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

/* ==================== 图表内容 ==================== */
.chart-body {
  padding: 0 30rpx 30rpx;
}

.chart-scroll {
  white-space: nowrap;
  width: 100%;
  -webkit-overflow-scrolling: touch;
}

.chart-scroll ::-webkit-scrollbar {
  display: none;
}

.line-chart {
  height: 420rpx;
  display: inline-block;
  vertical-align: top;
}

.chart-footer {
  margin-top: 20rpx;
}

.swipe-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.swipe-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #e0e0e0, transparent);
}

.swipe-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  white-space: nowrap;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-illustration {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-circle {
  position: absolute;
  border-radius: 50%;
}

.empty-circle.outer {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, var(--primary-light) 0%, #e3f2fd 100%);
  opacity: 0.6;
  animation: pulse 3s ease-in-out infinite;
}

.empty-circle.inner {
  width: 140rpx;
  height: 140rpx;
  top: 30rpx;
  left: 30rpx;
  background: linear-gradient(135deg, #e8f5e9 0%, #bbdefb 100%);
  opacity: 0.8;
  animation: pulse 3s ease-in-out infinite 0.5s;
}

.empty-emoji {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 80rpx;
  z-index: 2;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.empty-action text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.empty-action .arrow {
  font-size: 28rpx;
  transition: transform 0.3s ease;
}

.empty-action:active .arrow {
  transform: translateX(8rpx);
}

.safe-area {
  height: 40rpx;
}

/* ==================== 视频时间轴区域 ==================== */
.timeline-section {
  position: relative;
  z-index: 1;
  margin: 0 30rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.timeline-title-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.timeline-icon {
  font-size: 36rpx;
}

.timeline-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.timeline-badge {
  padding: 8rpx 20rpx;
  background: var(--primary-light);
  border-radius: var(--radius-sm);
}

/* ==================== 时间轴主体 ==================== */
.timeline-body {
  padding: 20rpx 0;
}

.timeline-item {
  display: flex;
  padding: 20rpx 30rpx;
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 74rpx;
  top: 80rpx;
  bottom: -20rpx;
  width: 2rpx;
  background: linear-gradient(180deg, var(--primary) 0%, #e8f5e9 100%);
}

.timeline-item:last-child::before {
  display: none;
}

/* 月份标记 */
.timeline-month {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  flex-shrink: 0;
  padding-top: 10rpx;
  position: relative;
  z-index: 2;
}

.month-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--primary);
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  margin-bottom: 16rpx;
  margin-right: 25rpx;
}

.month-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
  white-space: nowrap;
}

/* 内容区域 */
.timeline-content {
  flex: 1;
  margin-top:25rpx;
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: 2rpx dashed #e0e0e0;
}

.media-group {
  margin-bottom: 24rpx;
}

.media-group:last-child {
  margin-bottom: 0;
}

.media-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.media-icon {
  font-size: 28rpx;
}

.media-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
  transition: transform 0.2s ease;
}

.photo-item:active {
  transform: scale(0.95);
}

.photo-img {
  width: 100%;
  height: 100%;
}

/* 视频网格 */
.video-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.video-item {
  width: 100%;
  aspect-ratio: 16/9;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
  position: relative;
}

.video-media {
  width: 100%;
  height: 100%;
}

.video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  pointer-events: none;
}

.play-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  position: relative;
}

.play-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 55%;
  transform: translate(-50%, -50%);
  border-left: 24rpx solid var(--primary);
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
}

/* 空状态 */
.timeline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.timeline-empty .empty-illustration {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.timeline-empty .empty-emoji {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 100rpx;
}

.timeline-empty .empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.timeline-empty .empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
}

/* 加载状态 */
.timeline-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.timeline-loading .loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: var(--primary);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

.timeline-loading text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* ==================== 对比海报区域 ==================== */
.compare-section {
  position: relative;
  z-index: 1;
  margin: 0 30rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.compare-header {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.compare-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.compare-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.compare-content {
  padding: 24rpx 30rpx;
}

.compare-row {
  margin-bottom: 24rpx;
}

.compare-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.compare-selects {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.compare-select-item {
  flex: 1;
}

.compare-select-item.full-width {
  width: 100%;
}

.select-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
}

.select-btn text {
  font-size: 26rpx;
  color: var(--text-primary);
}

.select-arrow {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.select-btn.disabled {
  background: #e8f5e9;
  border-color: var(--primary);
}

.select-btn.disabled text {
  color: var(--primary);
  font-weight: 500;
}

.compare-vs {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 600;
  flex-shrink: 0;
}

.week-selector {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.week-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.week-item.active {
  background: #e8f5e9;
  border-color: var(--primary);
}

.week-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.week-checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.week-checkbox text {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.week-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.compare-btn {
  width: 95%;
  padding: 24rpx;
  background: #e0e0e0;
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.compare-btn.active {
  background: linear-gradient(135deg, var(--primary) 0%, #05a350 100%);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.compare-btn text {
  font-size: 28rpx;
  color: #999999;
  font-weight: 600;
}

.compare-btn.active text {
  color: #ffffff;
}

.compare-chart {
  padding: 20rpx 24rpx 30rpx;
  border-top: 2rpx solid #f5f5f5;
}

.compare-chart-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.compare-canvas-wrapper {
  width: 680rpx;
  margin: 0 auto 16rpx;
  position: relative;
}

.compare-chart-canvas {
  width: 680rpx;
  height: 600rpx;
  background: #ffffff;
  border-radius: 12rpx;
  display: block;
}

.compare-legend {
  display: flex;
  gap: 40rpx;
  justify-content: center;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.legend-dot.first {
  background: #ff6b6b;
}

.legend-dot.last {
  background: #07c160;
}

.legend-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}