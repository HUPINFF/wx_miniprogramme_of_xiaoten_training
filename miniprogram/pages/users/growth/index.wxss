/* ==================== 全局变量 ==================== */
page {
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --accent: #00d2ff;
  --bg-page: #f0f2f5;
  --bg-card: #ffffff;
  --text-primary: #1a1a2e;
  --text-secondary: #4a4a68;
  --text-tertiary: #8a8aa3;
  --border-light: rgba(255, 255, 255, 0.2);
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;

  background-color: var(--bg-page);
}

/* 渐变背景层（从上到下：绿色 → 白色透明） */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(180deg, #07c160 0%, #e8f5e9 60%, rgba(255, 255, 255, 0) 100%);
  z-index: 0;
}

/* 底部波浪过渡（让渐变自然融入白色背景） */
.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg-page) 100%);
}

/* ==================== 页面内容层 ==================== */
.page-content {
  position: relative;
  z-index: 1;
  padding-top: 80rpx; /* 状态栏高度 */
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  padding: 30rpx 40rpx 40rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 400;
}

/* ==================== 版块入口卡 ====================
   两张大卡压在渐变背景上：半透明白 + 毛玻璃，
   图标块沿用 --primary-light 的浅绿语言。 */
.entry-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 30rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  transition: transform 0.2s ease;
}

.entry-card-hover {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 1);
}

.entry-icon {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-light);
  border-radius: var(--radius-md);
  font-size: 48rpx;
  margin-right: 24rpx;
}

.entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 摘要行：入口卡上唯一带颜色的行，家长不点进去也能看到答案 */
.entry-summary {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.entry-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 44rpx;
  line-height: 1;
  color: var(--text-tertiary);
}

.safe-area {
  height: 40rpx;
}
