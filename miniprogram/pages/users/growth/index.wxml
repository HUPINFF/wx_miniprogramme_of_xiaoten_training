<!-- 渐变背景层（固定定位，覆盖顶部区域） -->
<view class="gradient-bg"></view>

<!-- 页面内容 -->
<view class="page-content">

  <!-- 顶部标题区：把「成长记录」变成「孩子的成长」 -->
  <view class="header-area">
    <text class="header-title">{{childInfo.name ? childInfo.name + '的成长' : '成长记录'}}</text>
    <text class="header-subtitle">每一次训练，都在悄悄改变他</text>
  </view>

  <!-- 四个版块入口：各自摘要行先在这里给家长一个答案，细节点进去看 -->
  <view class="entry-list">

    <!-- ① 基本能力成长：原页面的能力分组卡 + 成长曲线整体搬到了 growth-ability -->
    <view class="entry-card" hover-class="entry-card-hover" bind:tap="goAbility">
      <view class="entry-icon">📊</view>
      <view class="entry-body">
        <text class="entry-title">基本能力成长</text>
        <text class="entry-desc">能力值 · 最新进步 · 成长曲线</text>
        <text class="entry-summary" wx:if="{{abilitySummary}}">{{abilitySummary}}</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <!-- ② 训练记录：每一次课的流水（新的在上），点进看单次课详情 -->
    <view class="entry-card" hover-class="entry-card-hover" bind:tap="goTrainingRecords">
      <view class="entry-icon">🏃</view>
      <view class="entry-body">
        <text class="entry-title">训练记录</text>
        <text class="entry-desc">每次课的完成情况 · 照片 · 视频</text>
        <text class="entry-summary" wx:if="{{trainingSummary}}">{{trainingSummary}}</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <!-- ③ 训练照片与视频：原页面的照片/视频时间轴整体搬到了 growth-records -->
    <view class="entry-card" hover-class="entry-card-hover" bind:tap="goRecords">
      <view class="entry-icon">🎬</view>
      <view class="entry-body">
        <text class="entry-title">训练照片与视频</text>
        <text class="entry-desc">训练照片 · 视频 · 成长影像</text>
        <text class="entry-summary" wx:if="{{recordsSummary}}">{{recordsSummary}}</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <!-- ④ 成长报告：教练撰写的月度/季度总结，海报式成品 -->
    <view class="entry-card" hover-class="entry-card-hover" bind:tap="goReports">
      <view class="entry-icon">📄</view>
      <view class="entry-body">
        <text class="entry-title">成长报告</text>
        <text class="entry-desc">教练撰写的月度 / 季度成长总结</text>
        <text class="entry-summary" wx:if="{{reportsSummary}}">{{reportsSummary}}</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

  </view>

</view>

<view class="safe-area"></view>
