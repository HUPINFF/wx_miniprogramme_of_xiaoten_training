/* pages/users/class-records/index.wxss —— 训练记录列表（iOS 风格，单层书写） */
.container {
  min-height: 100vh;
  background-color: #F2F2F7;
  padding-bottom: 40rpx;
}

/* 筛选栏：iOS 分段控件 */
.filter-bar {
  display: flex;
  margin: 16rpx 24rpx 24rpx;
  background-color: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 999rpx;
  padding: 6rpx;
}
.filter-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  border-radius: 999rpx;
  transition: all 0.2s;
}
.filter-item.active {
  background: #007aff;
  color: #ffffff;
  font-weight: 500;
}

/* 记录列表 */
.record-list {
  padding: 0 24rpx;
}

.record-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: opacity 0.15s;
}
.record-card-active {
  opacity: 0.85;
}

/* 左侧日期：大号「18」+ 9月18日 + 周四 */
.record-date {
  width: 110rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid rgba(60, 60, 67, 0.1);
  margin-right: 24rpx;
  padding-right: 20rpx;
  align-self: stretch;
  justify-content: center;
}
.record-date .day {
  font-size: 44rpx;
  font-weight: 700;
  color: #007aff;
  line-height: 1.1;
}
.record-date .month-day {
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.6);
  margin-top: 6rpx;
}
.record-date .weekday {
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-top: 2rpx;
}

/* 右侧信息 */
.record-info {
  flex: 1;
  min-width: 0;
}

.record-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.course-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 状态章：配色对齐训练详情页的状态语义 */
.status-chip {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.status-chip.status-finished {
  background: rgba(52, 199, 89, 0.12);
  color: #34c759;
}
.status-chip.status-in_class {
  background: rgba(255, 149, 0, 0.15);
  color: #ff9500;
}
.status-chip.status-pending,
.status-chip.status-scheduled {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
}

.record-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.6);
  margin-bottom: 10rpx;
}

/* 完成进度 / 媒体数小标签 */
.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.6);
  background-color: rgba(60, 60, 67, 0.06);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.tag-done {
  color: #34c759;
  background-color: rgba(52, 199, 89, 0.1);
}

/* 箭头 */
.arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: rgba(60, 60, 67, 0.25);
  margin-left: 12rpx;
}

/* 加载更多 / 空态 / 加载中 */
.load-more,
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.34);
}
.load-more {
  color: #007aff;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}
.empty-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(255, 255, 255, 0.96);
  padding: 40rpx;
  border-radius: 20rpx;
  color: rgba(60, 60, 67, 0.6);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(60, 60, 67, 0.1);
  border-top-color: #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
