<view class="container">
  <nav-bar title="训练记录" showBack="{{true}}"></nav-bar>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{filterType === 'all' ? 'active' : ''}}" bind:tap="onFilterChange" data-type="all">全部</view>
    <view class="filter-item {{filterType === 'thisMonth' ? 'active' : ''}}" bind:tap="onFilterChange" data-type="thisMonth">本月</view>
    <view class="filter-item {{filterType === 'lastMonth' ? 'active' : ''}}" bind:tap="onFilterChange" data-type="lastMonth">上月</view>
  </view>

  <!-- 记录列表：新的在上、旧的在下；一行一次课，点进训练详情 -->
  <view class="record-list">
    <block wx:for="{{recordList}}" wx:key="_id">
      <view class="record-card" hover-class="record-card-active" bind:tap="viewRecordDetail" data-id="{{item._id}}">
        <!-- 左侧日期 -->
        <view class="record-date">
          <text class="day">{{item.day}}</text>
          <text class="month-day" wx:if="{{item.monthDay}}">{{item.monthDay}}</text>
          <text class="weekday" wx:if="{{item.weekday}}">{{item.weekday}}</text>
        </view>

        <!-- 右侧课程信息 -->
        <view class="record-info">
          <view class="record-title-row">
            <text class="course-name">{{item.name}}</text>
            <text class="status-chip status-{{item.statusType}}">{{item.statusText}}</text>
          </view>
          <text class="record-meta">{{item.coachName}}教练<text wx:if="{{item.timeText}}"> · {{item.timeText}}</text></text>
          <!-- 完成进度 / 媒体数：没有就不占行 -->
          <view class="record-tags" wx:if="{{item.doneText || item.photoCount || item.videoCount}}">
            <text class="tag tag-done" wx:if="{{item.doneText}}">✓ {{item.doneText}}</text>
            <text class="tag" wx:if="{{item.photoCount}}">📸 {{item.photoCount}}张</text>
            <text class="tag" wx:if="{{item.videoCount}}">🎬 {{item.videoCount}}段</text>
          </view>
        </view>

        <text class="arrow">›</text>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:if="{{recordList.length === 0 && !loading}}" class="empty">
      <text class="empty-icon">📋</text>
      <text class="empty-text">还没有训练记录</text>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{hasMore && recordList.length > 0}}" class="load-more" bind:tap="loadMore">
      <text wx:if="{{!loadingMore}}">加载更多</text>
      <text wx:else>加载中...</text>
    </view>
    <view wx:elif="{{!hasMore && recordList.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
