/* pages/users/course-detail/index.wxss 课程详情：首页同款渐变头部 + 白卡内容流。
   变量与首页同源（page 级 wxss 每页独立，要在这份里再声明一遍）；
   原文件基样式 + iOS 覆盖双层叠加，本次合并重写为一层，配色统一品牌绿 */
page {
  --primary: #07c160;
  --primary-light: #e8f5e9;
  --bg: #f5f7fa;
  --card: #ffffff;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn 0.4s ease-out both;
}

/* ==================== 渐变背景（首页同一配方，短一截） ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 30%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background: var(--bg);
  position: relative;
}

/* ==================== 顶部标题区（紧凑款：封面区自带课程名，不重复铺副标题） ==================== */
.header-area {
  position: relative;
  z-index: 1;
  padding: 92rpx 40rpx 36rpx;
  display: flex;
  justify-content: center;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

/* 返回键：白透圆钮浮在标题行左侧 */
.back-btn {
  position: absolute;
  left: 30rpx;
  top: 98rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 40rpx;
  line-height: 60rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.back-btn-active {
  background: rgba(255, 255, 255, 0.32);
}

/* ==================== 内容流 ==================== */
.page-content {
  position: relative;
  z-index: 1;
  padding: 0 24rpx 170rpx;
}

/* 封面区域：无封面时浅绿渐变占位（与列表页占位同族） */
.cover-section {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #e8f5e9 0%, #d3ecd9 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-placeholder text {
  font-size: 120rpx;
  opacity: 0.6;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
}

.course-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.course-hours-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

/* ==================== 信息卡片 ==================== */
.info-card,
.advice-card,
.custom-section {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.info-row {
  margin-bottom: 30rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.label-icon {
  font-size: 32rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 内容底色改中性浅灰（原为蓝调 #f8faff），让品牌绿只出现在关键处 */
.info-content {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.info-content text {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.8;
}

/* ==================== 建议区域 ==================== */
.advice-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.advice-card {
  margin-bottom: 0;
}

/* 左色条区分受众：家长绿（成长）、教练橙（教学的温度） */
.advice-card.parent {
  border-left: 6rpx solid var(--primary);
}

.advice-card.coach {
  border-left: 6rpx solid #ff9500;
}

.advice-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.advice-icon {
  font-size: 36rpx;
}

.advice-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.advice-content {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 22rpx;
}

.advice-content text {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

/* ==================== 自定义内容（图文/视频） ==================== */
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.title-icon {
  font-size: 32rpx;
}

.section-title text:nth-child(2) {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.content-count {
  font-size: 24rpx;
  color: var(--text-hint);
  font-weight: 400;
}

.custom-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.custom-item {
  background: #f7f8fa;
  border-radius: 16rpx;
  overflow: hidden;
}

.custom-media {
  position: relative;
  width: 100%;
}

.media-image {
  width: 100%;
  height: 400rpx;
  display: block;
  background: #f0f0f3;
}

.media-video {
  width: 100%;
  height: 400rpx;
  display: block;
  background: #f0f0f3;
}

.media-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.badge-icon {
  color: #fff;
  font-size: 32rpx;
  margin-left: 6rpx;
}

.custom-desc {
  padding: 20rpx;
  background: var(--card);
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.custom-desc text {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

/* ==================== 底部联系按钮（品牌绿 CTA） ==================== */
.bottom-button {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  padding: 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 10000;
}

.bottom-button:active {
  opacity: 0.88;
}

.button-icon {
  font-size: 38rpx;
}

.button-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.empty-icon {
  font-size: 110rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* ==================== 加载浮层 ==================== */
.loading-cover {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 50rpx 70rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(7, 193, 96, 0.15);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}
