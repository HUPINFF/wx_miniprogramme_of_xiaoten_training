/* pages/users/course-detail/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #f8fafc 0%, #eef4ff 50%, #f0f7ff 100%);
}

.page-content {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 封面区域 */
.cover-section {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #67b26f 100%);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-placeholder text {
  font-size: 120rpx;
  opacity: 0.6;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.course-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.course-hours-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10rpx);
}

/* 课程信息卡片 */
.info-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f5;
}

.info-row {
  margin-bottom: 28rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.label-icon {
  font-size: 32rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

.info-content {
  background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e8f0fe;
}

.info-content text {
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.8;
}

/* 建议区域 */
.advice-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.advice-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f5;
}

.advice-card.parent {
  border-left: 6rpx solid #07c160;
}

.advice-card.coach {
  border-left: 6rpx solid #4a90d9;
}

.advice-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.advice-icon {
  font-size: 36rpx;
}

.advice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}

.advice-content {
  background: #f8f9fc;
  border-radius: 12rpx;
  padding: 20rpx;
}

.advice-content text {
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.7;
}

/* 自定义内容区域 */
.custom-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f5;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.title-icon {
  font-size: 32rpx;
}

.section-title text:nth-child(2) {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}

.content-count {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.custom-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.custom-item {
  background: #f8f9fc;
  border-radius: 16rpx;
  overflow: hidden;
}

.custom-media {
  position: relative;
  width: 100%;
}

.media-image {
  width: 100%;
  height: 400rpx;
  display: block;
  background: #f5f5f5;
}

.media-video {
  width: 100%;
  height: 400rpx;
  display: block;
  background: #f5f5f5;
}

.media-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-icon {
  color: #fff;
  font-size: 32rpx;
  margin-left: 6rpx;
}

.custom-desc {
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f5;
}

.custom-desc text {
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.7;
}

/* 底部联系按钮 */
.bottom-button {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  padding: 28rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 10000;
}

.button-icon {
  font-size: 40rpx;
}

.button-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f5;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #8896a6;
}

/* 加载状态 */
.loading-cover {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 60rpx 80rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e8f0fe;
  border-top-color: #4a90d9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #8896a6;
}