/* pages/users/profile/index.wxss */

/* ==================== 全局变量（iOS 化） ==================== */
page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --primary-light: rgba(0, 122, 255, 0.1);
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --shadow-1: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  --shadow-2: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  --shadow-3: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;
  --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 60rpx;
}

/* ==================== 渐变背景 ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 25%, #34d399 50%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
  pointer-events: none;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  padding: 90rpx 40rpx 50rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 400;
  letter-spacing: 1rpx;
  background: rgba(255,255,255,0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

/* ==================== 用户信息卡片 ==================== */
.user-card {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  display: flex;
  align-items: center;
  background-color: var(--card);
  border-radius: var(--radius-xl);
  margin: 0 auto 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-2);
  transition: var(--transition);
}

.user-card:active {
  transform: scale(0.98);
}

.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #f0f0f0;
  border: 4rpx solid #fff;
  box-shadow: var(--shadow-2);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
  margin-bottom: 8rpx;
}

.edit-btn {
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, var(--primary-light), #f0fdf4);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  border: 2rpx solid rgba(7, 193, 96, 0.1);
  transition: var(--transition);
}

.edit-btn:active {
  background: var(--primary);
  color: #fff;
  transform: scale(0.95);
}

/* ==================== 孩子区域 ==================== */
.child-section {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  border-radius: var(--radius-xl);
  margin: 0 auto 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-2);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--border);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ==================== 孩子卡片（白色清新风格） ==================== */
.child-card {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 0;
  position: relative;
  overflow: hidden;
  border: 2rpx solid var(--border);
  box-shadow: var(--shadow-1);
}

/* 左侧装饰色条 */
.child-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  width: 6rpx;
  height: 60%;
  background: linear-gradient(180deg, var(--primary), #34d399);
  border-radius: 0 4rpx 4rpx 0;
}

/* 右上角装饰圆 */
.child-card::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, rgba(7, 193, 96, 0.04), rgba(7, 193, 96, 0.08));
  border-radius: 50%;
}

.child-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.child-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.child-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 1rpx;
}

.child-age {
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.child-gender {
  font-size: 24rpx;
  background: linear-gradient(135deg, #e0f2fe, #dbeafe);
  color: #3b82f6;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.child-actions {
  display: flex;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.edit-child {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
  transition: var(--transition);
}

.edit-child:active {
  background: var(--primary);
  color: #fff;
  transform: scale(0.95);
}

.delete-child {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #fef2f2;
  color: #ef4444;
  font-weight: 500;
  transition: var(--transition);
}

.delete-child:active {
  background: #ef4444;
  color: #fff;
  transform: scale(0.95);
}

/* 生日信息 */
.child-birthday {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
  font-size: 24rpx;
  position: relative;
  z-index: 1;
}

.birthday-label {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 500;
}

.birthday-value {
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 500;
}

/* 孩子ID信息 */
.child-id {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--border);
  position: relative;
  z-index: 1;
}

.id-value {
  font-size: 22rpx;
  color: var(--text-hint);
  flex: 1;
}

/* 课时明细按钮 */
.hours-btn {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #fafbfc, #f0fdf4);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border);
  transition: var(--transition);
  position: relative;
  z-index: 1;
}

.hours-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.hours-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.hours-arrow {
  font-size: 28rpx;
  color: var(--text-hint);
  font-weight: 300;
}

.hours-btn:active {
  background: var(--primary-light);
  border-color: var(--primary);
  transform: scale(0.98);
}

/* ==================== 添加孩子按钮 ==================== */
.add-child-btn {
  width: 100%;
  background: linear-gradient(135deg, #07c160 0%, #05a350 100%);
  color: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.25);
  transition: var(--transition);
}

.add-child-btn::after {
  border: none;
}

.add-child-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ==================== 空状态 ==================== */
.empty-child {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 0;
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* ==================== 教练区域 ==================== */
.coach-section {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  margin: 0 auto 24rpx;
  box-shadow: var(--shadow-2);
}

.coach-section .section-header {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--border);
}

.coach-section .section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.coach-card {
  padding: 24rpx;
  background: linear-gradient(135deg, #fafbfc, #f0fdf4);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--border);
}

.coach-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
  margin-bottom: 12rpx;
}

.coach-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* ==================== 所有教练按钮 ==================== */
.all-coaches-btn {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  border-radius: var(--radius-xl);
  padding: 28rpx 32rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-2);
  transition: var(--transition);
}

.all-coaches-btn:active {
  background-color: #f8f9fa;
  transform: scale(0.98);
}

.coaches-btn-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #e8f5e9, #f0fdf4);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coaches-btn-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.coaches-btn-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
  font-weight: 300;
}

/* ==================== 功能菜单 ==================== */
.menu-list {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  border-radius: var(--radius-xl);
  margin: 0 auto 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-2);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border);
  transition: var(--transition);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8f9fa;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  font-size: 40rpx;
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #f5f7fa, #f0fdf4);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
  font-weight: 300;
}

/* ==================== 退出登录按钮 ==================== */
.logout-btn {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: var(--radius-xl);
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  transition: var(--transition);
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background-color: #fff5f5;
  transform: scale(0.98);
}

/* ==================== iOS 精修（追加覆盖，后面规则优先） ==================== */

/* 头区：白底 + iOS 大标题 */
.gradient-bg {
  height: 400rpx;
  background: linear-gradient(180deg, #ffffff 0%, #ffffff 55%, #f7f7fa 100%);
}
.gradient-bg::after {
  display: none;
}
.header-area {
  padding: 92rpx 44rpx 30rpx;
  align-items: flex-start;
}
.header-title {
  color: #000000;
  text-shadow: none;
  letter-spacing: 0;
}
.header-subtitle {
  color: rgba(60, 60, 67, 0.6);
  background: transparent;
  padding: 0;
  border-radius: 0;
  backdrop-filter: none;
  letter-spacing: 0;
}

/* 白色面板统一去投影 */
.user-card,
.child-section,
.coach-section,
.all-coaches-btn,
.menu-list {
  box-shadow: none;
}
.user-card:active,
.all-coaches-btn:active {
  transform: none;
}

/* 用户行 */
.user-avatar {
  border: 3rpx solid #fff;
  box-shadow: none;
}
.edit-btn {
  background: transparent;
  border: none;
  color: #007aff;
  padding: 10rpx 4rpx;
  border-radius: 0;
  font-weight: 500;
}
.edit-btn:active {
  background: rgba(0, 122, 255, 0.08);
  color: #0056cf;
  transform: none;
}

/* 分组小标题 hairline 分隔 */
.section-header {
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.14);
}

/* 孩子信息：去装饰、控件收敛为 iOS 芯片 */
.child-card {
  box-shadow: none;
  border-color: rgba(60, 60, 67, 0.08);
}
.child-card::before {
  display: none;
}
.child-card::after {
  display: none;
}
.child-age {
  background: rgba(0, 122, 255, 0.1);
}
.child-gender {
  background: #f2f2f7;
  color: rgba(60, 60, 67, 0.6);
}
.edit-child {
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
}
.edit-child:active {
  background: #007aff;
  transform: none;
}
.delete-child {
  background: rgba(255, 59, 48, 0.12);
  color: #ff3b30;
}
.delete-child:active {
  background: #ff3b30;
  transform: none;
}
.child-birthday,
.child-id {
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}
/* 课时明细 → 行内入口 */
.hours-btn {
  background: #f7f7fa;
  border: none;
}
.hours-btn:active {
  background: #ececf1;
  border-color: transparent;
  transform: none;
}
.hours-arrow,
.menu-arrow,
.coaches-btn-arrow {
  color: rgba(60, 60, 67, 0.25);
  font-weight: 500;
}

/* 添加孩子 → iOS 系统蓝实心 */
.add-child-btn {
  background: #007aff;
  border-radius: 24rpx;
  height: 92rpx;
  box-shadow: none;
}
.add-child-btn:active {
  opacity: 0.85;
}

/* 教练面板 */
.coach-card {
  background: #f7f7fa;
  border: none;
}

/* 所有教练入口（图标衬底灰化） */
.coaches-btn-icon {
  background: #f2f2f7;
  color: #007aff;
}

/* 功能菜单 → iOS inset group 单元格 */
.menu-item {
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}
.menu-item:active {
  background-color: rgba(60, 60, 67, 0.04);
}
.menu-icon {
  background: #f2f2f7;
  color: #007aff;
  border-radius: 12rpx;
}

/* 退出登录 → iOS 红字白底 */
.logout-btn {
  background-color: var(--card);
  color: #ff3b30;
  border: none;
  border-radius: var(--radius-xl);
  box-shadow: none;
}
.logout-btn:active {
  background-color: #f7f7fa;
  transform: none;
}