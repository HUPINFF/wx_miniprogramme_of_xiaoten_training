/* pages/users/profile/index.wxss */

/* ==================== 全局变量 ==================== */
page {
  --bg: #f5f7fa;
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --primary-glow: rgba(7, 193, 96, 0.12);
  --card: #ffffff;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;
  --border: #f3f4f6;
  --shadow-1: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-2: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-3: 0 8rpx 24rpx rgba(0,0,0,0.08);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --skeleton-base: #f0f0f0;
  --skeleton-shine: #e0e0e0;
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 60rpx;
}

/* ==================== 渐变背景 ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 25%, #34d399 50%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
  pointer-events: none;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  padding: 90rpx 40rpx 50rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 400;
  letter-spacing: 1rpx;
  background: rgba(255,255,255,0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

/* ==================== 用户信息卡片 ==================== */
.user-card {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  display: flex;
  align-items: center;
  background-color: var(--card);
  border-radius: var(--radius-xl);
  margin: 0 auto 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-2);
  transition: var(--transition);
}

.user-card:active {
  transform: scale(0.98);
}

.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #f0f0f0;
  border: 4rpx solid #fff;
  box-shadow: var(--shadow-2);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
  margin-bottom: 8rpx;
}

.edit-btn {
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, var(--primary-light), #f0fdf4);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  border: 2rpx solid rgba(7, 193, 96, 0.1);
  transition: var(--transition);
}

.edit-btn:active {
  background: var(--primary);
  color: #fff;
  transform: scale(0.95);
}

/* ==================== 孩子区域 ==================== */
.child-section {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  border-radius: var(--radius-xl);
  margin: 0 auto 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-2);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--border);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ==================== 孩子卡片（白色清新风格） ==================== */
.child-card {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 0;
  position: relative;
  overflow: hidden;
  border: 2rpx solid var(--border);
  box-shadow: var(--shadow-1);
}

/* 左侧装饰色条 */
.child-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  width: 6rpx;
  height: 60%;
  background: linear-gradient(180deg, var(--primary), #34d399);
  border-radius: 0 4rpx 4rpx 0;
}

/* 右上角装饰圆 */
.child-card::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, rgba(7, 193, 96, 0.04), rgba(7, 193, 96, 0.08));
  border-radius: 50%;
}

.child-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.child-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.child-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: 1rpx;
}

.child-age {
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.child-gender {
  font-size: 24rpx;
  background: linear-gradient(135deg, #e0f2fe, #dbeafe);
  color: #3b82f6;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.child-actions {
  display: flex;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.edit-child {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
  transition: var(--transition);
}

.edit-child:active {
  background: var(--primary);
  color: #fff;
  transform: scale(0.95);
}

.delete-child {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #fef2f2;
  color: #ef4444;
  font-weight: 500;
  transition: var(--transition);
}

.delete-child:active {
  background: #ef4444;
  color: #fff;
  transform: scale(0.95);
}

/* 生日信息 */
.child-birthday {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
  font-size: 24rpx;
  position: relative;
  z-index: 1;
}

.birthday-label {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 500;
}

.birthday-value {
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 500;
}

/* 孩子ID信息 */
.child-id {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--border);
  position: relative;
  z-index: 1;
}

.id-value {
  font-size: 22rpx;
  color: var(--text-hint);
  flex: 1;
}

/* 课时明细按钮 */
.hours-btn {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #fafbfc, #f0fdf4);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border);
  transition: var(--transition);
  position: relative;
  z-index: 1;
}

.hours-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.hours-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.hours-arrow {
  font-size: 28rpx;
  color: var(--text-hint);
  font-weight: 300;
}

.hours-btn:active {
  background: var(--primary-light);
  border-color: var(--primary);
  transform: scale(0.98);
}

/* ==================== 添加孩子按钮 ==================== */
.add-child-btn {
  width: 100%;
  background: linear-gradient(135deg, #07c160 0%, #05a350 100%);
  color: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.25);
  transition: var(--transition);
}

.add-child-btn::after {
  border: none;
}

.add-child-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ==================== 空状态 ==================== */
.empty-child {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 0;
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* ==================== 教练区域 ==================== */
.coach-section {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  margin: 0 auto 24rpx;
  box-shadow: var(--shadow-2);
}

.coach-section .section-header {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--border);
}

.coach-section .section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.coach-card {
  padding: 24rpx;
  background: linear-gradient(135deg, #fafbfc, #f0fdf4);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--border);
}

.coach-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
  margin-bottom: 12rpx;
}

.coach-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* ==================== 所有教练按钮 ==================== */
.all-coaches-btn {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  border-radius: var(--radius-xl);
  padding: 28rpx 32rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-2);
  transition: var(--transition);
}

.all-coaches-btn:active {
  background-color: #f8f9fa;
  transform: scale(0.98);
}

.coaches-btn-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #e8f5e9, #f0fdf4);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coaches-btn-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.coaches-btn-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
  font-weight: 300;
}

/* ==================== 功能菜单 ==================== */
.menu-list {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  border-radius: var(--radius-xl);
  margin: 0 auto 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-2);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border);
  transition: var(--transition);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8f9fa;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  font-size: 40rpx;
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #f5f7fa, #f0fdf4);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
  font-weight: 300;
}

/* ==================== 退出登录按钮 ==================== */
.logout-btn {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  background-color: var(--card);
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: var(--radius-xl);
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  transition: var(--transition);
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background-color: #fff5f5;
  transform: scale(0.98);
}


/* ==================== 骨架屏 / 渐隐动画 ====================
   搬来的版块大量使用 .fade-in 和 skeleton-* ，而这些基础类在 home 里位于
   版块之外（动画定义在文件头部，.skeleton 基类和 .skeleton-tag 在骨架屏基类区），
   当初不在搬迁范围内，所以必须在这里补一份，否则骨架屏全是透明方块。 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn 0.5s ease-in-out;
}

@keyframes skeleton-loading {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.skeleton {
  background: linear-gradient(
    90deg,
    var(--skeleton-base) 25%,
    var(--skeleton-shine) 50%,
    var(--skeleton-base) 75%
  );
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

.skeleton-tag {
  height: 40rpx;
  width: 120rpx;
  border-radius: 20rpx;
}

/* ==========================================================================
   以下样式自 pages/users/home/index.wxss 搬入（v1.03 信息架构重做）
   八宫格 / 最新动态 / 成长案例 / 家长点评 / 精彩瞬间 /
   课程体系 / 关于我们 / 加入我们 / 联系我们
   对应的 wxml 块与 js 加载函数一并搬入本页。

   搬迁时有意跳过 home 版的 .section-header 与 .section-title —— 这两个是共用类，
   本页原有「我的孩子」「我的教练」也在用，保留本页定义（带 border-bottom 分隔线），
   搬来的版块沿用同一份，全页视觉才统一。改这里的标题样式会影响全部版块。
   ========================================================================== */

/* ==================== 快捷入口 ==================== */
/* 五个入口一行（2026-09-22 精简定稿）：gap/padding 收窄给 5 列留位 */
.quick-entry {
  margin: 0 30rpx 30rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
  background: var(--card);
  padding: 32rpx 20rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-2);
  position: relative;
  z-index: 1;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-radius: var(--radius-md);
  transition: var(--transition);
}

.entry-item:active {
  background: var(--primary-glow);
  transform: scale(0.92);
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-light), #f0fdf4);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: var(--transition);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.08);
}

.entry-item:active .entry-icon {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  transform: rotate(10deg) scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.entry-text {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 骨架屏快捷入口 */
.skeleton-quick-entry {
  margin: 0 30rpx 30rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  background: var(--card);
  padding: 36rpx 24rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-2);
}

.skeleton-entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  margin: 0 auto;
}

.skeleton-entry-text {
  height: 24rpx;
  width: 80rpx;
  border-radius: 6rpx;
  margin: 12rpx auto 0;
}

/* ==================== 通用区块 ==================== */
.section {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
  position: relative;
  z-index: 1;
  transition: var(--transition);
}


.section-more {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  transition: var(--transition);
}

.section-more:active {
  background: var(--primary);
  color: #fff;
  transform: scale(0.95);
}

/* 骨架屏区块标题 */
.skeleton-section-title {
  height: 40rpx;
  width: 240rpx;
  border-radius: 8rpx;
}

/* ==================== 最新动态 ==================== */
.news-list {
  display: flex;
  flex-direction: column;
}

.news-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
  transition: var(--transition);
  border-radius: var(--radius-sm);
}

.news-item:last-child {
  border-bottom: none;
}

.news-item:active {
  background: var(--primary-light);
  transform: scale(0.98);
  padding: 24rpx 16rpx;
}

.news-dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, var(--primary), #34d399);
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 8rpx rgba(7, 193, 96, 0.4);
}

.news-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.news-time {
  font-size: 22rpx;
  color: var(--text-hint);
  flex-shrink: 0;
  background: var(--bg);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

/* 骨架屏动态列表 */
.skeleton-news-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.skeleton-news-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.skeleton-news-title {
  flex: 1;
  height: 28rpx;
  border-radius: 6rpx;
}

.skeleton-news-time {
  width: 100rpx;
  height: 32rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* ==================== 家长点评 ==================== */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  background: #fafbfc;
  border-radius: var(--radius-md);
  padding: 28rpx;
  border: 2rpx solid var(--border);
  transition: var(--transition);
}

.comment-item:active {
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.1);
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid #fff;
  box-shadow: var(--shadow-1);
}

.comment-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
}

.comment-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 6rpx;
}

.comment-rating .star {
  font-size: 24rpx;
}

.comment-rating .rating-text {
  font-size: 24rpx;
  color: #f59e0b;
  margin-left: 8rpx;
  font-weight: 700;
}

.comment-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
