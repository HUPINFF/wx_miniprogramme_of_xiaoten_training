<view class="container">
  <view class="gradient-bg"></view>

  <view class="header-area">
    <text class="header-title"> 我的</text>
    <text class="header-subtitle">配置我的信息</text>
  </view>

  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="user-name">{{userInfo.name || userInfo.nickName || '家长'}}</text>
      <!-- <text class="user-phone">{{userInfo.phone || '未绑定手机号'}}</text> -->
    </view>
    <view class="edit-btn" bind:tap="editProfile">
      <text>编辑</text>
    </view>
  </view>

  <!-- 孩子卡片信息 -->
  <view class="child-section">
    <view class="section-header">
      <text class="section-title">我的孩子</text>
    </view>

    <block wx:if="{{childInfo}}">
      <view class="child-card">
        <view class="child-header">
          <view class="child-info">
            <text class="child-name">{{childInfo.name}}</text>
            <text class="child-age">{{childInfo.age}}岁</text>
            <text class="child-gender">{{childInfo.gender === 'male'?'男孩':'女孩'}}</text>
          </view>
          <view class="child-actions">
            <text class="edit-child" bind:tap="editChild">编辑</text>
            <text class="delete-child" bind:tap="deleteChild">删除</text>
          </view>
        </view>
        <!-- 生日信息 -->
        <view class="child-birthday" wx:if="{{childInfo.birthday}}">
          <text class="birthday-label">生日：</text>
          <text class="birthday-value">{{childInfo.birthday}}</text>
        </view>
        <!-- 孩子ID信息 -->
        <view class="child-id" wx:if="{{childInfo._id}}">
          <text class="id-value">孩子ID: {{childInfo._id}}</text>
        </view>
        <!-- 课时明细按钮 -->
        <view class="hours-btn" bind:tap="goToHoursDetail">
          <text class="hours-icon">📊</text>
          <text class="hours-text">课时明细</text>
          <text class="hours-arrow">></text>
        </view>
      </view>
    </block>

    <!-- 无孩子时的占位 -->
    <view wx:else class="empty-child">
      <text class="empty-icon">👶</text>
      <text class="empty-text">暂无孩子信息</text>
      <text class="empty-hint">点击上方"添加孩子"按钮添加</text>
    </view>
    <!-- 添加孩子按钮 （仅在无孩子时显示）-->
    <button wx:if="{{!childInfo}}" class="add-child-btn" bind:tap="addChild">+添加孩子</button>
  </view>

  <!-- 【新增】我的教练面板 -->
  <view class="coach-section" wx:if="{{coachInfo}}">
    <view class="section-header">
      <text class="section-title">👨‍🏫 我的教练</text>
    </view>
    <view class="coach-card">
      <text class="coach-name">{{coachInfo.name}} 教练</text>
      <text class="coach-desc">个人简介：{{coachInfo.bio || '暂无简介'}}</text>
    </view>
  </view>

  <!-- 【新增】所有教练入口 -->
  <view class="all-coaches-btn" bind:tap="goToAllCoaches">
    <text class="coaches-btn-icon">👥</text>
    <text class="coaches-btn-text">所有教练</text>
    <text class="coaches-btn-arrow">></text>
  </view>

  <!-- ======================================================================
       以下版块自 pages/users/home/index.wxss 搬入（v1.03 信息架构重做）
       对应的样式在 index.wxss 末尾，加载函数与跳转 handler 在 index.js。
       骨架屏由 data.loading 控制（见 loadContentSections）。
       ====================================================================== -->

  <!-- 快捷入口（2026-09-22 用户精简为五个：训练数据/课程表/课堂点评/我的反馈/成长案例；
       网格改 5 列，正好一行） -->
  <view wx:if="{{!loading}}" class="quick-entry fade-in">
    <view class="entry-item" bind:tap="goToTrainingData">
      <view class="entry-icon">📊</view>
      <text class="entry-text">训练数据</text>
    </view>

    <view class="entry-item" bind:tap="goToSchedule">
      <view class="entry-icon">📅</view>
      <text class="entry-text">课程表</text>
    </view>

    <view class="entry-item" bind:tap="goToClassComments">
      <view class="entry-icon">💬</view>
      <text class="entry-text">课堂点评</text>
    </view>

    <view class="entry-item" bind:tap="goToFeedback">
      <view class="entry-icon">⭐</view>
      <text class="entry-text">我的反馈</text>
    </view>

    <view class="entry-item" bind:tap="goToChildProfile">
      <view class="entry-icon">👤</view>
      <text class="entry-text">成长案例</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="skeleton-quick-entry">
    <block wx:for="{{5}}" wx:key="*this">
      <view class="entry-item">
        <view class="skeleton skeleton-entry-icon"></view>
        <view class="skeleton skeleton-entry-text"></view>
      </view>
    </block>
  </view>

  <!-- 最新动态/公告 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title" wx:if="{{!loading}}">📢 最新动态</text>
      <view class="skeleton skeleton-section-title" wx:if="{{loading}}"></view>
      <text class="section-more" wx:if="{{!loading}}" bind:tap="viewAllNews">查看更多</text>
      <view class="skeleton skeleton-tag" wx:if="{{loading}}" style="width: 120rpx; height: 40rpx; border-radius: 20rpx;"></view>
    </view>

    <view wx:if="{{!loading}}" class="news-list fade-in">
      <view class="news-item" wx:for="{{newList}}" wx:key="index" bind:tap="viewNews" data-id="{{item.id}}">
        <view class="news-dot"></view>
        <text class="news-title">{{item.title}}</text>
        <text class="news-time">{{item.time}}</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="news-list">
      <view class="skeleton-news-item" wx:for="{{3}}" wx:key="*this">
        <view class="skeleton skeleton-news-dot"></view>
        <view class="skeleton skeleton-news-title"></view>
        <view class="skeleton skeleton-news-time"></view>
      </view>
    </view>
  </view>

  <!-- 成长案例 -->
  <view class="section" wx:if="{{!loading && growthList.length > 0}}">
    <view class="section-header">
      <text class="section-title">🌱 成长案例</text>
      <text class="section-more" bind:tap="viewAllGrowth">查看全部</text>
    </view>
    <view class="growth-list fade-in">
      <view class="growth-item" wx:for="{{growthList}}" wx:key="_id" wx:if="{{index < 5}}" bind:tap="viewGrowthDetail" data-id="{{item._id}}">
        <view class="growth-cover">
          <image wx:if="{{item.coverImage}}" class="growth-cover-img" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view wx:if="{{!item.coverImage}}" class="growth-no-cover">
            <text>{{item.category === 'height' ? '📈' : '💪'}}</text>
          </view>
          <view class="growth-badge-small {{item.category === 'height' ? 'height' : 'fitness'}}">
            <text>{{item.category === 'height' ? '追高' : '体适能'}}</text>
          </view>
        </view>
        <view class="growth-info">
          <text class="growth-title">{{item.title}}</text>
          <text class="growth-desc">{{item.description || '暂无描述'}}</text>
          <view class="growth-meta">
            <text class="growth-count">📷 {{item.itemCount || 0}}</text>
            <text class="growth-time">{{item.createdAt}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 家长点评 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title" wx:if="{{!loading}}">💬 家长点评</text>
      <view class="skeleton skeleton-section-title" wx:if="{{loading}}"></view>
      <text class="section-more" wx:if="{{!loading}}" bind:tap="viewAllComments">查看全部</text>
      <view class="skeleton skeleton-tag" wx:if="{{loading}}" style="width: 120rpx; height: 40rpx; border-radius: 20rpx;"></view>
    </view>

    <view wx:if="{{!loading && comments.length > 0}}" class="comment-list fade-in">
      <view class="comment-item" wx:for="{{comments}}" wx:key="_id" bind:tap="viewCommentDetail" data-id="{{item._id}}">
        <view class="comment-header">
          <image class="comment-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="comment-info">
            <text class="comment-name">{{item.nickName}}</text>
            <view class="comment-rating">
              <text class="star" wx:for="{{5}}" wx:key="*this" wx:for-item="starItem" style="{{starItem < item.rating ? 'color: #ff9500;' : 'color: #ddd;'}}">★</text>
              <text class="rating-text">{{item.rating}}分</text>
            </view>
          </view>
        </view>
        <view class="comment-tags" wx:if="{{item.tags && item.tags.length > 0}}">
          <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
        <text class="comment-content">{{item.content}}</text>
        <view class="comment-footer">
          <text class="comment-time">{{item.createTime}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!loading && comments.length === 0}}" class="empty-comments">
      <text>暂无点评</text>
    </view>

    <view wx:if="{{loading}}" class="comment-list">
      <view class="skeleton-comment-item" wx:for="{{2}}" wx:key="*this">
        <view class="skeleton-comment-header">
          <view class="skeleton skeleton-comment-avatar"></view>
          <view>
            <view class="skeleton skeleton-comment-name"></view>
            <view class="skeleton skeleton-comment-rating"></view>
          </view>
        </view>
        <view class="skeleton-comment-tags">
          <view class="skeleton skeleton-tag" wx:for="{{3}}" wx:key="*this" style="width: 100rpx; height: 40rpx; border-radius: 12rpx;"></view>
        </view>
        <view class="skeleton skeleton-comment-content"></view>
        <view class="skeleton skeleton-comment-content"></view>
        <view class="skeleton skeleton-comment-time"></view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{loading}}">
    <view class="section-header">
      <view class="skeleton skeleton-section-title"></view>
      <view class="skeleton skeleton-tag" style="width: 120rpx; height: 40rpx; border-radius: 20rpx;"></view>
    </view>
    <view class="growth-list">
      <view class="skeleton-growth-item" wx:for="{{2}}" wx:key="*this">
        <view class="skeleton skeleton-growth-cover"></view>
        <view class="skeleton-growth-info">
          <view class="skeleton skeleton-growth-title"></view>
          <view class="skeleton skeleton-growth-desc"></view>
          <view class="skeleton skeleton-growth-desc"></view>
          <view class="skeleton-growth-meta">
            <view class="skeleton skeleton-growth-meta-text"></view>
            <view class="skeleton skeleton-growth-meta-text"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 精彩瞬间（优化版） -->
  <view class="section">
    <view class="section-header">
      <text class="section-title" wx:if="{{!loading}}">📸 精彩瞬间</text>
      <view class="skeleton skeleton-section-title" wx:if="{{loading}}"></view>
      <text class="section-more" wx:if="{{!loading}}" bind:tap="viewMoreMoments">更多</text>
      <view class="skeleton skeleton-tag" wx:if="{{loading}}" style="width: 100rpx; height: 40rpx; border-radius: 20rpx;"></view>
    </view>

    <scroll-view wx:if="{{!loading}}" class="moment-scroll" scroll-x="true">
      <view class="moment-list fade-in">
        <view class="moment-item" wx:for="{{moments}}" wx:key="index" bind:tap="viewMoment" data-id="{{item._id}}">
          <view class="moment-image-wrapper">
            <image wx:if="{{item.mediaType !== 'video'}}" class="moment-image" src="{{item.image}}" mode="aspectFill"></image>
            <!-- catch:tap 挂住冒泡，否则点视频想播放却被整卡的「跳详情」劫持 -->
            <video wx:else catch:tap="stopPropagation" class="moment-video" src="{{item.video}}" controls show-center-play-btn show-play-btn enable-progress-gesture object-fit="cover" autoplay="{{false}}" poster=""></video>
          </view>
          <view class="moment-info">
            <text class="moment-title">{{item.title}}</text>
            <view class="moment-meta">
              <view class="moment-views">👁️ 查看</view>
              <text class="moment-date">精彩时刻</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <scroll-view wx:if="{{loading}}" class="moment-scroll" scroll-x="true">
      <view class="skeleton-moment-list">
        <view class="skeleton-moment-item" wx:for="{{4}}" wx:key="*this">
          <view class="skeleton skeleton-moment-image"></view>
          <view class="skeleton-moment-info">
            <view class="skeleton skeleton-moment-title"></view>
            <view class="skeleton skeleton-moment-meta"></view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 课程体系 -->
  <view class="section" wx:if="{{!loading && courseList.length > 0}}">
    <view class="section-header">
      <text class="section-title">📚 课程体系</text>
      <text class="section-more" bind:tap="viewAllCourses">查看全部</text>
    </view>
    <scroll-view class="course-scroll" scroll-x="true">
      <view class="course-list fade-in">
        <view class="course-card" wx:for="{{courseList}}" wx:key="_id" bind:tap="viewCourseDetail" data-id="{{item._id}}">
          <view class="course-cover">
            <image wx:if="{{item.coverImage}}" class="course-cover-img" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view wx:if="{{!item.coverImage}}" class="course-no-cover">
              <text>📚</text>
            </view>
            <view class="course-tag">热门</view>
          </view>
          <view class="course-info">
            <text class="course-name">{{item.courseName}}</text>
            <text class="course-desc" wx:if="{{item.description}}">{{item.description}}</text>
            <text class="course-hours">📅 {{item.trainingHours}}课时</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section" wx:if="{{loading}}">
    <view class="section-header">
      <view class="skeleton skeleton-section-title"></view>
      <view class="skeleton skeleton-tag" style="width: 120rpx; height: 40rpx; border-radius: 20rpx;"></view>
    </view>
    <scroll-view class="course-scroll" scroll-x="true">
      <view class="skeleton-course-list">
        <view class="skeleton-course-card" wx:for="{{3}}" wx:key="*this">
          <view class="skeleton skeleton-course-cover"></view>
          <view class="skeleton-course-info">
            <view class="skeleton skeleton-course-name"></view>
            <view class="skeleton skeleton-course-desc"></view>
            <view class="skeleton skeleton-course-desc"></view>
            <view class="skeleton skeleton-course-hours"></view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 机构介绍 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title" wx:if="{{!loading}}">🏆 关于我们</text>
      <view class="skeleton skeleton-section-title" wx:if="{{loading}}"></view>
      <text class="section-more" wx:if="{{!loading}}" bind:tap="aboutUs">了解更多</text>
      <view class="skeleton skeleton-tag" wx:if="{{loading}}" style="width: 120rpx; height: 40rpx; border-radius: 20rpx;"></view>
    </view>

    <view wx:if="{{!loading}}" class="about-content fade-in">
      <image class="about-logo" src="/images_1/logo_20251126_34991.uugai.com-1764133166493.png" mode="aspectFill"/>
      <text class="about-text">专业青少年体育训练机构，专注于6-15岁青少年体能训练、专项技能提升。拥有国家级教练团队，科学训练体系，已服务超过5000名学员。</text>
    </view>

    <view wx:if="{{loading}}" class="skeleton-about-content">
      <view class="skeleton skeleton-about-logo"></view>
      <view class="skeleton skeleton-about-text"></view>
      <view class="skeleton skeleton-about-text"></view>
      <view class="skeleton skeleton-about-text"></view>
    </view>
  </view>

  <!-- 加入我们 -->
  <view wx:if="{{!loading}}" class="join-section fade-in" bind:tap="goToBookCoach">
    <view class="join-bg">
      <view class="join-content">
        <view class="join-icon">
          <text>👨🏫</text>
        </view>
        <view class="join-text">
          <text class="join-title">加入我们</text>
          <text class="join-desc">联系教练，开启运动之旅</text>
        </view>
        <view class="join-arrow">
          <text>›</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="skeleton-join-section">
    <view class="skeleton-join-bg">
      <view class="skeleton skeleton-join-icon"></view>
      <view class="skeleton-join-text">
        <view class="skeleton skeleton-join-title"></view>
        <view class="skeleton skeleton-join-desc"></view>
      </view>
      <view class="skeleton skeleton-join-arrow"></view>
    </view>
  </view>

  <!-- 联系我们 -->
  <view class="contact-section">
    <view class="contact-title" wx:if="{{!loading}}">📞 联系我们</view>
    <view class="skeleton skeleton-section-title" wx:if="{{loading}}" style="margin: 0 auto 28rpx; display: block;"></view>

    <view wx:if="{{!loading}}" class="contact-info fade-in">
      <view class="contact-item" bind:tap="callPhone">
        <text class="contact-icon">📱</text>
        <text>咨询热线：19212218300</text>
      </view>

      <view class="contact-item" bind:tap="viewAddress">
        <text class="contact-icon">📍</text>
        <text>训练地址:天津师范大学</text>
      </view>

      <view class="contact-item" bind:tap="viewWechat">
        <text class="contact-icon">💬</text>
        <text>官方微信：The120307</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="skeleton-contact-list">
      <view class="skeleton-contact-item" wx:for="{{3}}" wx:key="*this">
        <view class="skeleton skeleton-contact-icon"></view>
        <view class="skeleton skeleton-contact-text"></view>
      </view>
    </view>
  </view>

  <!-- ================== 搬入的版块到此为止 ================== -->

  <!-- 功能彩蛋 -->
  <view class="menu-list">
    <view class="menu-item" bind:tap="goToSettings">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-title">设置</text>
      </view>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <button class="logout-btn" bind:tap="logout">退出登录</button>
</view>

<!-- 添加/编辑孩子弹窗 -->
<add-child-modal 
  show="{{showAddChildModal}}" 
  editData="{{editChildData}}"
  bind:close="closeModal"
  bind:confirm="onConfirmChild"
/>


<!-- 编辑资料弹窗 -->
<edit-profile-modal 
  show="{{showEditProfileModal}}"
  userData="{{editProfileData}}"
  bind:close="closeEditProfileModal"
  bind:confirm="onConfirmEditProfile"
/>

