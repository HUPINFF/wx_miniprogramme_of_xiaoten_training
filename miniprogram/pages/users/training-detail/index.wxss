/* pages/users/training-detail/index.wxss */

/* ==================== 页面变量 ====================
   沿用教练端详情页的变量块，本页不引入全局颜色层（换腾鑫绿是另一件已 defer 的事）。
   头图渐变必须和 components/nav-bar 保持一致，否则导航栏下方会切出一条硬边。 */
page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-md: 20rpx;
  --radius-lg: 28rpx;

  --hero-from: #3b82f6;
  --hero-to: #10b981;
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
}

/* ==================== 头图 ====================
   本页唯一「大声」的区域。它接在 nav-bar 的渐变下面继续往下走，
   所以两段颜色是连着的，看起来是一块，而不是「导航栏 + 一块色板」。

   ⚠️ 底色恒等于 nav-bar 的品牌渐变，四种状态都不要去改它。
      一改，导航栏下方立刻切出一条硬边（曾经 .hero-finished 把 --hero-from
      换成石板蓝，左边就是一道可见的接缝）。
      要区分状态就往**上面**叠一层「顶端全透明、越往下越浓」的色：
      顶端透明所以接缝永远不存在，往下才慢慢透出状态色。 */
.hero {
  position: relative;
  padding: 20rpx 40rpx 104rpx;
  background: linear-gradient(135deg, var(--hero-from) 0%, var(--hero-to) 100%);
  overflow: hidden;
}

/* 上课中：往下逐渐转暖。

   这不只是配色——首页那张「正在上课」卡也是暖橙渐变，家长点进来落在这块
   暖色上，两页才像同一件事的前后两屏。暖色从 46% 起才明显，避开顶部接缝。 */
.hero-in_class {
  background:
    linear-gradient(180deg,
      rgba(255, 168, 52, 0) 0%,
      rgba(255, 164, 48, 0.30) 46%,
      rgba(233, 124, 26, 0.52) 100%),
    linear-gradient(135deg, var(--hero-from) 0%, var(--hero-to) 100%);
}

/* 上课中：右上角一团暖光。不改一个字也能一眼看出「正在进行」 */
.hero-in_class::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 199, 87, 0.55) 0%, rgba(255, 199, 87, 0) 70%);
  z-index: 0;
  pointer-events: none;
}

/* 已完成：往下压暗去饱和，和「正在进行」拉开距离 */
.hero-finished {
  background:
    linear-gradient(180deg,
      rgba(30, 41, 59, 0) 0%,
      rgba(30, 41, 59, 0.28) 46%,
      rgba(15, 23, 42, 0.52) 100%),
    linear-gradient(135deg, var(--hero-from) 0%, var(--hero-to) 100%);
}

/* 底部融进页面底色。和首页 .gradient-bg::after 同一个手法 ——
   不融的话，渐变色块会在卡片上方留一条硬边 */
.hero::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 104rpx;
  background: linear-gradient(180deg, rgba(242, 242, 247, 0) 0%, var(--bg) 100%);
  z-index: 0;
  pointer-events: none;
}

.hero-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 1rpx;
  padding-right: 20rpx;
}

.hero-pill {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* 只有「上课中」才有这个点，跟着呼吸 */
.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 10rpx;
  animation: livePulse 1.8s ease-in-out infinite;
}

@keyframes livePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.7); }
}

.hero-fact {
  position: relative;
  z-index: 1;
  margin-top: 36rpx;
}

.hero-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 4rpx;
  margin-bottom: 6rpx;
}

.hero-value {
  display: block;
  font-size: 68rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  letter-spacing: -1rpx;
  /* 秒级刷新的数字必须用等宽数字，否则每分钟宽度跳一次，整行都在抖 */
  font-variant-numeric: tabular-nums;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

/* 已完成的头图放的是一整句话（本次训练内容），68rpx 会撑爆好几行。
   降一档字号，仍然明显大于正文，但不再喧宾夺主。
   用 -webkit-line-clamp 封在 3 行：内容下面那张卡里也有，头图不必全文复述。 */
.hero-value-compact {
  font-size: 40rpx;
  line-height: 1.4;
  letter-spacing: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.hero-sub {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ==================== 内容区 ====================
   负 margin 让第一张卡压住头图底部：视觉上是「浮」在渐变上，而不是接在下面 */
.body {
  position: relative;
  z-index: 1;
  margin-top: -64rpx;
  padding: 0 24rpx 60rpx;
}

/* ==================== 白色分组卡 ==================== */
.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(60, 60, 67, 0.06);
  animation: cardIn 0.44s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* 逐张入场，不要一起蹦出来。四张往后不再递增，免得最后一张等太久 */
.card:nth-child(1) { animation-delay: 0.04s; }
.card:nth-child(2) { animation-delay: 0.10s; }
.card:nth-child(3) { animation-delay: 0.16s; }
.card:nth-child(4) { animation-delay: 0.22s; }
/* 第 5 张起（教练反馈卡）沿用上一档延迟——不写的话它是 0s，会比第 1 张还早出现 */
.card:nth-child(n+5) { animation-delay: 0.22s; }

@keyframes cardIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 卡标题压成安静的灰色、字号也小于正文 —— 内容才是主角 */
.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-sub);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--border);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 22rpx 0;
}

/* 用 :not(:last-child) 画分隔线：wxml 里用的是 wx:if（真的不创建节点），
   某行被隐藏时最后一行的边框会自动消失，不会留一条悬空的线 */
.info-row:not(:last-child) {
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}

.label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--text-sub);
  padding-right: 24rpx;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  word-break: break-all;
}

/* 实际开课时间是这一页的硬信息，给它一点颜色 */
.value-strong {
  color: var(--primary);
  font-weight: 700;
}

/* 长文本行改成上下排。

   ⚠️ 右对齐只适合「9月15日」「王教练」这种一眼扫完的短值。教练填的
      训练内容/重点/难点是一整句话，右对齐后会：换行后第二行比第一行短、
      两行都靠右，读起来要来回找行首；同时被左侧标签挤压成窄窄一条。
      所以这几行改成标签在上、正文在下、左对齐。 */
.info-row-stacked {
  display: block;
}

.info-row-stacked .label {
  display: block;
  padding-right: 0;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: var(--text-hint);
}

.info-row-stacked .value {
  display: block;
  text-align: left;
  font-weight: 400;
  line-height: 1.6;
}

/* ==================== 上课教练 ==================== */
.coach-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0 4rpx;
}

.coach-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f2f7;
}

/* 头像还没查回来时的占位，别让它闪一下白 */
.coach-avatar-empty {
  background: linear-gradient(135deg, #eef2f7 0%, #e2e8f0 100%);
}

.coach-meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.coach-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.coach-role {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.call-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--primary) 0%, #3b82f6 100%);
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.28);
}

.call-btn-active {
  opacity: 0.86;
  transform: scale(0.97);
}

/* ==================== 训练记录（照片 + 视频） ==================== */
.media-group + .media-group {
  margin-top: 28rpx;
}

.media-caption {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 14rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 14rpx;
  overflow: hidden;
  background: #f2f2f7;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.photo-item-active {
  opacity: 0.8;
}

.video-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.video-item {
  position: relative;
  width: 100%;
  aspect-ratio: 4/3;
  border-radius: 14rpx;
  overflow: hidden;
  background: #000;
}

.video-item video {
  width: 100%;
  height: 100%;
}

/* 视频故意不加 controls：整块点开全屏播放，和外面这层的点击是同一个动作。
   两者都加会「内联播一次、全屏又弹一次」 */
.play-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 22rpx 0 22rpx 36rpx;
  border-color: transparent transparent transparent rgba(255, 255, 255, 0.92);
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.45));
}

.empty-media {
  text-align: center;
  color: var(--text-hint);
  font-size: 26rpx;
  padding: 48rpx 0;
}

/* ==================== 教练反馈 ====================
   这节课教练写的评价（评分/进步标签/正文）。照片视频上面「训练记录」卡已经放过，
   这里只放文字部分；完整版（含朋友圈分享文案）在反馈详情页。 */
.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--border);
}

/* 标题放进标题行后，自身的下边距和分隔线交给行来画，分隔线才是通栏的 */
.card-title-row .card-title {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.fb-more {
  font-size: 24rpx;
  color: var(--primary);
}

.fb-more-active {
  opacity: 0.7;
}

.fb-coach-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0 4rpx;
}

.fb-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f2f2f7;
}

/* 没头像时用姓名首字占位（同反馈详情页的做法） */
.fb-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff9d4d 0%, #ff7a3d 100%);
}

.fb-coach-meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.fb-coach-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 星星与反馈详情页同款（.star.on #FF9500），小一号 */
.stars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
}

.star {
  font-size: 30rpx;
  line-height: 1;
  color: rgba(60, 60, 67, 0.18);
}

.star.on {
  color: #FF9500;
  text-shadow: 0 2rpx 8rpx rgba(255, 149, 0, 0.28);
}

.fb-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 0 4rpx;
}

.fb-tag {
  /* 同一份数据在反馈详情页是绿色标签，这里保持同色，点过去不跳色 */
  font-size: 24rpx;
  color: #2FAE52;
  background: rgba(52, 199, 89, 0.13);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.fb-content {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-main);
  padding: 20rpx 0 6rpx;
}

.fb-none {
  text-align: center;
  color: var(--text-hint);
  font-size: 26rpx;
  padding: 40rpx 0 16rpx;
}

/* ==================== 加载遮罩 ==================== */
.loading-cover {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(0, 122, 255, 0.16);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}
