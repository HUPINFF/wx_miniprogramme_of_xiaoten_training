/* ========================================
   所有教练页面 — Fresh Green Theme
   样式与 book-coach 保持一致
   ======================================== */

page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --primary-dark: #0056CF;
  --primary-light: rgba(0, 122, 255, 0.1);
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page {
  min-height: 100vh;
  background-color: var(--bg);
}

/* ========================================
   顶部导航栏
   ======================================== */
.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(34, 197, 94, 0.08);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-left,
.nav-right {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 56rpx;
  color: #2d3436;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2e2a;
  letter-spacing: 4rpx;
}

/* ========================================
   操作筛选栏
   ======================================== */
.filter-bar {
  position: fixed;
  top: calc(var(--sbh) + 88rpx);
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(34, 197, 94, 0.06);
}

.filter-group-left {
  display: flex;
  align-items: center;
}

.result-count {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 400;
}

.filter-group-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.view-toggle {
  display: flex;
  align-items: center;
  background: #e8f1ed;
  border-radius: 24rpx;
  padding: 3rpx;
}

.toggle-item {
  padding: 8rpx 24rpx;
  border-radius: 22rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.toggle-item.active {
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(34, 197, 94, 0.12);
}

.toggle-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #94a3b8;
  transition: color 0.3s;
}

.toggle-item.active .toggle-label {
  color: #22c55e;
  font-weight: 600;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #e8f1ed;
  transition: all 0.2s;
}


/* ========================================
   内容滚动区
   ======================================== */
.content-scroll {
  position: fixed;
  top: calc(var(--sbh) + 88rpx + 88rpx);
  left: 0;
  right: 0;
  bottom: 0;
}

/* ========================================
   教练网格
   ======================================== */
.coach-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 20rpx 20rpx 40rpx;
}

/* ========================================
   教练卡片
   ======================================== */
.coach-card {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  animation: cardFadeIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.coach-card:active {
  transform: scale(0.97);
}

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 头像区域 ===== */
.card-avatar-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #e8f1ed;
}

.card-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 45%;
  background: linear-gradient(transparent, rgba(255, 255, 255, 0.85));
  pointer-events: none;
}

.rank-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(34, 197, 94, 0.85);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.4;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

/* ===== 卡片信息体 ===== */
.card-body {
  padding: 12rpx 16rpx 8rpx;
}

.card-header {
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2e2a;
  letter-spacing: 1rpx;
}

.card-bio {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ===== CTA 底部 — 申请更换按钮 ===== */
.card-cta-btn {
  display: block;
  margin: 4rpx 16rpx 16rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 32rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.25);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-cta-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(34, 197, 94, 0.15);
}

.card-cta-btn.is-current {
  background: #e2e8f0;
  color: #94a3b8;
  box-shadow: none;
}

.card-cta-btn.is-current:active {
  transform: none;
}

.card-cta-btn.is-pending {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.25);
}

.card-cta-btn.is-pending:active {
  box-shadow: 0 2rpx 8rpx rgba(249, 115, 22, 0.15);
}

/* ========================================
   列表模式
   ======================================== */
.page.list .coach-container {
  grid-template-columns: 1fr;
}

.page.list .card-avatar-wrap {
  aspect-ratio: auto;
  height: 520rpx;
}

.page.list .card-body {
  padding: 20rpx 24rpx 16rpx;
}

.page.list .card-cta-btn {
  margin: 4rpx 24rpx 20rpx;
}

.page.list .card-name {
  font-size: 34rpx;
}

/* ========================================
   加载状态
   ======================================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(34, 197, 94, 0.1);
  border-top-color: #22c55e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* ========================================
   空状态
   ======================================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #f0fdf4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-emoji {
  font-size: 56rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94a3b8;
}

.bottom-spacer {
  height: 120rpx;
}

/* ==================== iOS 精修（追加覆盖，后面规则优先） ==================== */
/* 保留自建毛玻璃 top-nav / filter-bar 观感，仅统一颜色与 hairline */

.nav-back-icon {
  color: #000;
}
.nav-title {
  color: #000;
  letter-spacing: 0;
}
.result-count {
  color: rgba(60, 60, 67, 0.6);
}

.top-nav {
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
}
.filter-bar {
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
}

/* 视图切换 → iOS segmented */
.view-toggle {
  background: rgba(60, 60, 67, 0.1);
  border-radius: 999rpx;
  padding: 3rpx;
}
.toggle-item {
  border-radius: 999rpx;
}
.toggle-item.active {
  background: #ffffff;
  box-shadow: none;
}
.toggle-label {
  color: rgba(60, 60, 67, 0.6);
}
.toggle-item.active .toggle-label {
  color: #007AFF;
}

/* 教练卡片 */
.coach-card {
  box-shadow: none;
}
.coach-card:active {
  transform: none;
  opacity: 0.9;
}
.card-avatar-wrap {
  background: #f2f2f7;
}
.avatar-overlay {
  background: linear-gradient(transparent, rgba(255, 255, 255, 0.7));
}
.rank-badge {
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  color: #fff;
  border-radius: 999rpx;
}
.card-name {
  color: #000;
  letter-spacing: 0;
}
.card-bio {
  color: rgba(60, 60, 67, 0.6);
}

/* CTA 状态化按钮 */
.card-cta-btn {
  background: #007AFF;
  border-radius: 24rpx;
  letter-spacing: 0;
  box-shadow: none;
}
.card-cta-btn:active {
  transform: none;
  box-shadow: none;
  opacity: 0.85;
}
.card-cta-btn.is-current {
  background: #f2f2f7;
  color: rgba(60, 60, 67, 0.6);
}
.card-cta-btn.is-current:active {
  opacity: 1;
}
.card-cta-btn.is-pending {
  background: rgba(255, 149, 0, 0.15);
  color: #C77700;
}
.card-cta-btn.is-pending:active {
  opacity: 0.85;
}

/* 加载 / 空状态 */
.loading-spinner {
  border: 4rpx solid rgba(0, 122, 255, 0.15);
  border-top-color: #007AFF;
}
.loading-text {
  color: rgba(60, 60, 67, 0.6);
}
.empty-icon-wrap {
  background: #f2f2f7;
}
.empty-title {
  color: #000;
}
.empty-desc {
  color: rgba(60, 60, 67, 0.34);
}

