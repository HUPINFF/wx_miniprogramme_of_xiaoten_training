/* pages/users/all-courses/index.wxss */
page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --primary-dark: #0056CF;
  --primary-light: rgba(0, 122, 255, 0.1);
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;

  background-color: var(--bg);
}

.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.course-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 20rpx;
  transition: opacity 0.2s ease;
}

.course-card:active {
  opacity: 0.85;
}

.course-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.course-cover-img {
  width: 100%;
  height: 100%;
}

.course-no-cover {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f7f7fa 0%, #ececf1 100%);
}

.course-no-cover text {
  font-size: 60rpx;
  opacity: 0.6;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #000;
}

.course-desc {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.course-hours {
  font-size: 24rpx;
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.card-arrow {
  font-size: 36rpx;
  color: rgba(60, 60, 67, 0.25);
  font-weight: 500;
  margin-left: 12rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}
