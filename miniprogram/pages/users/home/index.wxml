<view class="container">
  <view class="gradient-bg"></view>

  <view class="header-area">
    <text class="header-title"> 腾鑫体育</text>
    <text class="header-subtitle">记录每一次进步</text>
  </view>

  <!-- 顶部轮播图 -->
  <view class="banner-wrapper">
    <!-- 骨架屏轮播图 -->
    <view class="skeleton skeleton-banner" wx:if="{{loading}}"></view>

    <!-- 真实轮播图 -->
    <swiper class="banner" wx:if="{{!loading}}" indicator-dots autoplay interval="3000" circular>
      <swiper-item wx:for="{{banners}}" wx:key="index">
        <image src="{{item.image}}" mode="aspectFill" class="banner-image" />
        <view class="banner-text" wx:if="{{item.text}}">
          <text>{{item.text}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 孩子信息卡 -->
  <view wx:if="{{!loading && childInfo}}" class="child-card fade-in">
    <view class="child-name">
      <text class="name">{{childInfo.name}}</text>
      <text class="age">{{childInfo.age}}岁</text>
    </view>
    <view class="child-tag">训练中 · 坚持就是胜利 💪</view>
  </view>

  <view wx:if="{{loading}}" class="skeleton-child-card">
    <view class="skeleton skeleton-child-name"></view>
    <view class="skeleton skeleton-child-tag"></view>
  </view>

  <!-- 当前情况：正在上课 / 下节课。都没有则整卡隐藏 -->
  <!-- 整卡可点，进训练详情页；两种状态共用同一个页面 -->
  <view
    wx:if="{{!loading && currentMode !== 'none'}}"
    class="status-card {{currentMode === 'in_class' ? 'status-card-live' : ''}} fade-in"
    hover-class="status-card-active"
    bind:tap="goToTrainingDetail"
    data-id="{{currentTraining._id}}"
  >
    <!-- 正在上课：教练点了「开始上课」才会是这个状态。
         这是首页唯一「此刻正在发生」的事，所以整卡换成暖色渐变 + 大号正计时，
         和下面「下节课」那张白卡一眼分得开。 -->
    <block wx:if="{{currentMode === 'in_class'}}">
      <view class="live-glow"></view>

      <view class="live-head">
        <view class="live-badge">
          <view class="live-dot"></view>
          <text>正在上课</text>
        </view>
        <text class="live-more">查看详情 ›</text>
      </view>

      <view class="live-fact">
        <text class="live-label">正在进行</text>
        <text class="live-value">{{elapsedText}}</text>
        <text class="live-sub" wx:if="{{inClassSubText}}">{{inClassSubText}}</text>
      </view>

      <block wx:if="{{currentTraining.coachContent || currentTraining.focus}}">
        <view class="live-divider"></view>
        <view class="live-row" wx:if="{{currentTraining.coachContent}}">
          <text class="live-key">训练内容</text>
          <text class="live-val">{{currentTraining.coachContent}}</text>
        </view>
        <view class="live-row" wx:if="{{currentTraining.focus}}">
          <text class="live-key">重点</text>
          <text class="live-val">{{currentTraining.focus}}</text>
        </view>
      </block>
    </block>

    <!-- 下节课 -->
    <block wx:else>
      <view class="status-head">
        <text class="status-badge upcoming">下节课</text>
        <text class="status-more">查看详情 ›</text>
      </view>
      <view class="status-title">
        {{upcomingDateText}} {{currentTraining.startTime}}<text wx:if="{{currentTraining.endTime}}">-{{currentTraining.endTime}}</text>
      </view>
      <view class="status-row" wx:if="{{currentTraining.location}}">
        <text class="status-label">地点</text>
        <text class="status-value">{{currentTraining.location}}</text>
      </view>
      <view class="status-row">
        <text class="status-label">教练</text>
        <text class="status-value">{{currentTraining.coachName}}</text>
      </view>
      <view class="status-row" wx:if="{{currentTraining.focus}}">
        <text class="status-label">重点</text>
        <text class="status-value">{{currentTraining.focus}}</text>
      </view>

      <!-- 最近进步 + 最近训练反馈 -->
      <view class="status-divider" wx:if="{{progress || latestFeedback}}"></view>

      <view class="progress-line" wx:if="{{progress}}">
        <text class="progress-label">{{progressLabel}}</text>
        <text class="progress-text">{{progressText}}</text>
      </view>

      <view class="feedback-line" wx:if="{{latestFeedback}}">
        <view class="feedback-head">
          <text class="progress-label">训练反馈</text>
          <text class="feedback-meta">{{latestFeedback.weekRange}}</text>
        </view>
        <text class="feedback-content">{{latestFeedback.content}}</text>
      </view>
    </block>
  </view>

  <view wx:if="{{loading}}" class="skeleton-status-card">
    <view class="skeleton skeleton-status-badge"></view>
    <view class="skeleton skeleton-status-title"></view>
    <view class="skeleton skeleton-status-row"></view>
    <view class="skeleton skeleton-status-row"></view>
  </view>

  <!-- 空闲态：没在上课、也没有下节课 → 成长足迹。
       今天没课的日子里，让家长也能看见孩子在持续积累：
       练了多少次 + 最近进步 + 最新反馈；全新用户给一条去预约的引导。 -->
  <view wx:if="{{!loading && currentMode === 'none' && childInfo}}" class="growth-section fade-in">
    <view class="growth-card">
      <view class="growth-head">
        <text class="growth-title">{{childInfo.name}}的成长足迹</text>
        <text class="growth-more" bind:tap="goToGrowth">成长档案 ›</text>
      </view>

      <view class="growth-stats">
        <view class="growth-stat">
          <view class="stat-value-row">
            <text class="stat-value">{{totalTrainings}}</text>
            <text class="stat-unit">次</text>
          </view>
          <text class="stat-label">累计训练</text>
        </view>
        <view class="stat-divider"></view>
        <view class="growth-stat">
          <view class="stat-value-row">
            <text class="stat-value">{{monthTrainings}}</text>
            <text class="stat-unit">次</text>
          </view>
          <text class="stat-label">本月训练</text>
        </view>
      </view>

      <block wx:if="{{progress || latestFeedback}}">
        <view class="growth-divider"></view>

        <view class="progress-line" wx:if="{{progress}}">
          <text class="progress-label">{{progressLabel}}</text>
          <text class="progress-text">{{progressText}}</text>
        </view>

        <view class="growth-feedback" wx:if="{{latestFeedback}}" bind:tap="goToFeedback" hover-class="growth-feedback-active">
          <view class="growth-feedback-head">
            <text class="growth-feedback-label">最新反馈</text>
            <text class="growth-feedback-meta">{{latestFeedback.weekRange}}</text>
          </view>
          <text class="growth-feedback-content">{{latestFeedback.content}}</text>
        </view>
      </block>

      <block wx:if="{{isGrowthEmpty}}">
        <view class="growth-divider"></view>
        <view class="growth-empty-hint" bind:tap="goToBooking" hover-class="growth-hint-active">
          <text class="growth-hint-text">还没有训练记录，去预约第一节课吧</text>
          <text class="growth-hint-arrow">→</text>
        </view>
      </block>
    </view>
  </view>
</view>

<!-- 登录提醒弹窗 -->
<view wx:if="{{showLoginModal}}" class="login-modal-mask" bind:tap="onLoginCancel">
  <view class="login-modal" catch:tap="stopPropagation">
    <view class="login-modal-icon">👋</view>
    <view class="login-modal-title">欢迎来到腾鑫体育</view>
    <view class="login-modal-desc">登录后可查看训练数据、预约课程、记录成长，体验完整功能</view>
    <view class="login-modal-actions">
      <button class="login-modal-btn cancel" bind:tap="onLoginCancel">随便看看</button>
      <button class="login-modal-btn confirm" bind:tap="onLoginConfirm">去登录</button>
    </view>
  </view>
</view>
