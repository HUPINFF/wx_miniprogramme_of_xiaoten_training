}


/* ==================== 关于我们 ==================== */
.about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.about-logo {
  width: 340rpx;
  height: 260rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-3);
  border: 4rpx solid #fff;
}

.about-text {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.9;
  text-align: center;
  background: linear-gradient(135deg, #fafbfc, #f0fdf4);
  padding: 28rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--border);
}

/* 骨架屏关于我们 */
.skeleton-about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.skeleton-about-logo {
  width: 340rpx;
  height: 260rpx;
  border-radius: var(--radius-lg);
}

.skeleton-about-text {
  height: 28rpx;
  width: 100%;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.skeleton-about-text:last-of-type {
  width: 80%;
}

/* ==================== 课程体系（优化版） ==================== */
.course-scroll {
  width: 100%;
  overflow-x: auto;
  white-space: nowrap;
}

.course-scroll ::-webkit-scrollbar {
  display: none;
}

.course-list {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 0 20rpx;
}

.course-card {
  display: inline-flex;
  flex-direction: column;
  width: 300rpx;
  flex-shrink: 0;
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-2);
  border: 2rpx solid var(--border);
  transition: var(--transition);
}

.course-card:active {
  transform: translateY(-6rpx);
  box-shadow: var(--shadow-3);
  border-color: var(--primary);
}

.course-cover {
  position: relative;
  width: 300rpx;
  height: 220rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #e8f5e9 0%, #dbeafe 100%);
}

.course-cover-img {
  width: 100%;
  height: 100%;
}

.course-no-cover {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%);
}

.course-no-cover text {
  font-size: 72rpx;
}

.course-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--primary);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.course-info {
  padding: 20rpx;
  background: #fff;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.course-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.course-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}

.course-hours {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  background: var(--primary-light);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

/* 骨架屏课程体系 */
.skeleton-course-list {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 0 20rpx;
}

.skeleton-course-card {
  display: inline-flex;
  flex-direction: column;
  width: 300rpx;
  flex-shrink: 0;
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-1);
  border: 2rpx solid var(--border);
}

.skeleton-course-cover {
  width: 300rpx;
  height: 220rpx;
  border-radius: 0;
}

.skeleton-course-info {
  padding: 20rpx;
  background: #fff;
}

.skeleton-course-name {
  height: 32rpx;
  width: 200rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}

.skeleton-course-desc {
  height: 24rpx;
  width: 100%;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.skeleton-course-desc:last-of-type {
  width: 70%;
  margin-bottom: 16rpx;
}

.skeleton-course-hours {
  height: 36rpx;
  width: 140rpx;
  border-radius: 20rpx;
}

/* ==================== 加入我们 ==================== */
.join-section {
  margin: 0 30rpx 30rpx;
}

.join-bg {
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  box-shadow: var(--shadow-3);
  position: relative;
  overflow: hidden;
  transition: var(--transition);
}

.join-bg:active {
  transform: scale(0.98);
}

.join-bg::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.join-bg::before {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}

.join-content {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
  gap: 24rpx;
}

.join-icon {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.3);
  backdrop-filter: blur(8rpx);
}

.join-icon text {
  font-size: 44rpx;
}

.join-title {
  font-size: 34rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 8rpx;
  display: block;
  letter-spacing: 1rpx;
}

.join-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  display: block;
}

.join-arrow {
  font-size: 52rpx;
  color: rgba(255,255,255,0.7);
  margin-left: auto;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}

/* 骨架屏加入我们 */
.skeleton-join-section {
  margin: 0 30rpx 30rpx;
}

.skeleton-join-bg {
  background: linear-gradient(135deg, #e0e7ff 0%, #ede9fe 100%);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.skeleton-join-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.skeleton-join-text {
  flex: 1;
}

.skeleton-join-title {
  height: 36rpx;
  width: 180rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.skeleton-join-desc {
  height: 28rpx;
  width: 240rpx;
  border-radius: 6rpx;
}

.skeleton-join-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ==================== 联系我们 ==================== */
.contact-section {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
  border: 2rpx solid var(--border);
  position: relative;
  z-index: 1;
}

.contact-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 28rpx;
  text-align: center;
  position: relative;
}

.contact-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary), #34d399);
  border-radius: 2rpx;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #fafbfc, #f0fdf4);
  border: 2rpx solid var(--border);
  transition: var(--transition);
}

.contact-item:active {
  background: var(--primary-light);
  border-color: var(--primary);
  transform: scale(0.98);
}

.contact-icon {
  font-size: 36rpx;
  width: 56rpx;
  height: 56rpx;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-1);
}

/* 骨架屏联系我们 */
.skeleton-contact-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-contact-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #fafbfc, #f0fdf4);
  border: 2rpx solid var(--border);
}

.skeleton-contact-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.skeleton-contact-text {
  height: 28rpx;
  flex: 1;
  border-radius: 6rpx;
}

/* ==================== 空状态 ==================== */
.empty-growth {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* ==================== 登录提醒弹窗 ==================== */
.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.login-modal {
  width: 580rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  animation: fadeIn 0.3s ease;
}

.login-modal-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.login-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.login-modal-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.login-modal-actions {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 20rpx;
}

.login-modal-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  overflow: visible;
}

.login-modal-btn::after {
  border: none;
}

.login-modal-btn.confirm {
  background: linear-gradient(135deg, var(--primary), #059669);
  color: #fff;
}

.login-modal-btn.confirm:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.login-modal-btn.cancel {
  background: var(--bg);
  color: var(--text-sub);
}

.login-modal-btn.cancel:active {
  background: #e5e7eb;
  transform: scale(0.98);
}