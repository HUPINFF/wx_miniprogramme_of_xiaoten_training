  background: #fff;
}

.skeleton-moment-title {
  height: 28rpx;
  width: 180rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.skeleton-moment-meta {
  height: 22rpx;
  width: 120rpx;
