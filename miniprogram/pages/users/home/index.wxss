/* ==================== 全局变量 ==================== */
page {
  --primary: #07c160;
  --primary-light: #e8f5e9;
  --bg: #f5f7fa;
  --card: #ffffff;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;
  --border: #f3f4f6;
  --shadow-1: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-2: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-3: 0 8rpx 24rpx rgba(0,0,0,0.08);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --skeleton-base: #f0f0f0;
  --skeleton-shine: #e0e0e0;
}

/* ==================== 渐隐动画 ==================== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn 0.5s ease-in-out;
}

/* ==================== 骨架屏动画 ==================== */
@keyframes skeleton-loading {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* 骨架屏基础样式 */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--skeleton-base) 25%,
    var(--skeleton-shine) 50%,
    var(--skeleton-base) 75%
  );
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

.skeleton-text {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-title {
  height: 36rpx;
  width: 60%;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.skeleton-avatar {
  border-radius: 50%;
}

.skeleton-image {
  border-radius: var(--radius-md);
}

.skeleton-button {
  height: 72rpx;
  border-radius: var(--radius-md);
}

.skeleton-tag {
  height: 40rpx;
  width: 120rpx;
  border-radius: 20rpx;
}

/* ==================== 渐变背景 ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 30%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  padding: 100rpx 40rpx 60rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 400;
  letter-spacing: 1rpx;
  background: rgba(255,255,255,0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 80rpx;
}

/* ==================== 轮播图 ==================== */
.banner-wrapper {
  position: relative;
  z-index: 1;
  padding: 0 30rpx 24rpx;
}

.banner {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-3);
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-lg);
}

.banner-text {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(16rpx);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 骨架屏轮播图 */
.skeleton-banner {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-lg);
}

/* ==================== 孩子卡片 ==================== */
.child-card {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
  position: relative;
  overflow: hidden;
  z-index: 1;
}

.child-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 15%;
  width: 8rpx;
  height: 70%;
  background: linear-gradient(180deg, var(--primary), #34d399);
  border-radius: 0 6rpx 6rpx 0;
}

.child-card::after {
  content: '';
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(7, 193, 96, 0.05), rgba(7, 193, 96, 0.1));
  border-radius: 50%;
}

.child-name .name {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.child-name .age {
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.child-tag {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-weight: 500;
}

/* 骨架屏孩子卡片 */
.skeleton-child-card {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
}

.skeleton-child-name {
  height: 52rpx;
  width: 200rpx;
  border-radius: 8rpx;
}

.skeleton-child-tag {
  height: 36rpx;
  width: 300rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

/* ==================== 当前情况（正在上课 / 下节课） ====================
   本页的核心卡片。两种状态由 js 的 currentMode 决定：
   in_class（教练已点「开始上课」）/ upcoming（下一节待上）/ none（整卡不渲染，
   改由下方「成长足迹」补位）。
   样式沿用原「通用区块」卡片外观，但 .section 系列已随版块搬到「我的」页，
   故此处独立成 .status-* 前缀，不再依赖 .section。 */
.status-card {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
  position: relative;
  z-index: 1;
}

/* ==================== 「正在上课」的直播卡 ====================
   整卡从白底换成暖色渐变，是首页唯一一张「有色」的卡——上课中就是首页上
   唯一一件此刻正在发生的事，值得这个份量。

   渐变往右下走深，是有意的：正文（训练内容/重点）排在卡片下半部，
   正好落在对比度更高的暗端；大号数字留在浅端，那一段只有「白色 + 60rpx +
   800 字重」，够读。反过来的话长文本会压在浅黄上，白字就糊了。 */
.status-card-live {
  background: linear-gradient(135deg, #f0952f 0%, #de6b14 52%, #c7520c 100%);
  box-shadow: 0 12rpx 32rpx rgba(199, 82, 12, 0.26);
  /* 右上角那团暖光要裁掉，不然会溢出圆角 */
  overflow: hidden;
}

/* 和详情页头图同一个手法：点进去之前就先看到这团光，两页连成一件事 */
.live-glow {
  position: absolute;
  top: -140rpx;
  right: -120rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 232, 178, 0.55) 0%, rgba(255, 232, 178, 0) 70%);
  pointer-events: none;
}

.live-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.live-badge {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.5rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

/* 呼吸的圆点 = 「正在进行中」，和详情页头图的 hero-dot 是同一个信号 */
.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 10rpx;
  animation: livePulse 1.8s ease-in-out infinite;
}

@keyframes livePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.35; transform: scale(0.7); }
}

.live-more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.live-fact {
  position: relative;
}

.live-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 4rpx;
  margin-bottom: 4rpx;
}

.live-value {
  display: block;
  font-size: 60rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  letter-spacing: -1rpx;
  /* 分钟数每隔半分钟跳一次，不加等宽数字整行会左右抖 */
  font-variant-numeric: tabular-nums;
  text-shadow: 0 4rpx 16rpx rgba(120, 40, 0, 0.22);
}

.live-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.live-divider {
  position: relative;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.24);
  margin: 28rpx 0 24rpx;
}

.live-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.live-row:last-child {
  margin-bottom: 0;
}

.live-key {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.5;
}

.live-val {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.5;
  word-break: break-all;
}

.status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* 整卡可点，右侧给个「查看详情」提示，否则家长不知道能点 */
.status-more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-hint);
}

.status-card-active {
  opacity: 0.85;
}

.status-badge {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  letter-spacing: 0.5rpx;
}

.status-badge.upcoming {
  background: var(--primary-light);
  color: var(--primary);
}

.status-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 28rpx;
}

.status-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.status-row:last-child {
  margin-bottom: 0;
}

.status-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-hint);
  line-height: 1.5;
}

.status-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.5;
  word-break: break-all;
}

/* 「下节课」下方：最近进步 + 最近反馈 */
.status-divider {
  height: 2rpx;
  background: var(--border);
  margin: 30rpx 0;
}

.progress-line {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-label {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-light);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-right: 18rpx;
}

.progress-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.feedback-line {
  margin-top: 4rpx;
}

.feedback-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.feedback-meta {
  font-size: 24rpx;
  color: var(--text-hint);
}

.feedback-content {
  display: block;
  font-size: 27rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* 骨架屏当前情况 */
.skeleton-status-card {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
}

.skeleton-status-badge {
  height: 40rpx;
  width: 150rpx;
  border-radius: 999rpx;
  margin-bottom: 28rpx;
}

.skeleton-status-title {
  height: 40rpx;
  width: 70%;
  border-radius: 8rpx;
  margin-bottom: 32rpx;
}

.skeleton-status-row {
  height: 32rpx;
  width: 100%;
  border-radius: 8rpx;
  margin-bottom: 18rpx;
}

.skeleton-status-row:last-child {
  width: 55%;
  margin-bottom: 0;
}


/* ==================== 空闲态：成长足迹 ====================
   没课的今天，首页原本只剩轮播图和孩子卡。这张卡回答「孩子进步了吗」：
   练了多少次（两个大数字）→ 最近进步 → 最新反馈，从积累到变化层层往下。
   进步行复用上面 .progress-line 的胶囊样式，和「下节课」卡长得一样——
   家长在两张卡里看到的是同一套文案，不该有两副面孔。 */
.growth-section {
  position: relative;
  z-index: 1;
}

.growth-card {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
}

.growth-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.growth-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.growth-more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-hint);
}

.growth-stats {
  display: flex;
  align-items: stretch;
}

.growth-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.stat-divider {
  width: 1rpx;
  background: var(--border);
  margin: 4rpx 0;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.stat-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.growth-divider {
  height: 2rpx;
  background: var(--border);
  margin: 28rpx 0 24rpx;
}

/* 反馈行可点进「我的反馈」，给个按下的反馈 */
.growth-feedback {
  border-radius: var(--radius-sm);
  margin: -8rpx -12rpx;
  padding: 8rpx 12rpx;
}

.growth-feedback-active {
  background: var(--bg);
}

.growth-feedback-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.growth-feedback-label {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-light);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.growth-feedback-meta {
  font-size: 22rpx;
  color: var(--text-hint);
}

.growth-feedback-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 27rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* 全新用户：三块数据全空时的引导行 */
.growth-empty-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: var(--radius-sm);
  margin: -8rpx -12rpx;
  padding: 8rpx 12rpx;
}

.growth-hint-active {
  background: var(--bg);
}

.growth-hint-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary);
}

.growth-hint-arrow {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--primary);
}


/* ==================== 登录提醒弹窗 ==================== */
.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.login-modal {
  width: 580rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  animation: fadeIn 0.3s ease;
}

.login-modal-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.login-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.login-modal-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.login-modal-actions {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 20rpx;
}

.login-modal-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  overflow: visible;
}

.login-modal-btn::after {
  border: none;
}

.login-modal-btn.confirm {
  background: linear-gradient(135deg, var(--primary), #059669);
  color: #fff;
}

.login-modal-btn.confirm:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.login-modal-btn.cancel {
  background: var(--bg);
  color: var(--text-sub);
}

.login-modal-btn.cancel:active {
  background: #e5e7eb;
  transform: scale(0.98);
}
