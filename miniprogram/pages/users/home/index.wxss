/* ==================== 全局变量 ==================== */
page {
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --primary-glow: rgba(7, 193, 96, 0.12);
  --bg: #f5f7fa;
  --card: #ffffff;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;
  --border: #f3f4f6;
  --shadow-1: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-2: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-3: 0 8rpx 24rpx rgba(0,0,0,0.08);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --skeleton-base: #f0f0f0;
  --skeleton-shine: #e0e0e0;
}

/* ==================== 渐隐动画 ==================== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn 0.5s ease-in-out;
}

/* ==================== 骨架屏动画 ==================== */
@keyframes skeleton-loading {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

@keyframes skeleton-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.4;
  }
}

/* 骨架屏基础样式 */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--skeleton-base) 25%,
    var(--skeleton-shine) 50%,
    var(--skeleton-base) 75%
  );
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

.skeleton-text {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-title {
  height: 36rpx;
  width: 60%;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.skeleton-avatar {
  border-radius: 50%;
}

.skeleton-image {
  border-radius: var(--radius-md);
}

.skeleton-button {
  height: 72rpx;
  border-radius: var(--radius-md);
}

.skeleton-tag {
  height: 40rpx;
  width: 120rpx;
  border-radius: 20rpx;
}

/* ==================== 渐变背景 ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 30%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  padding: 100rpx 40rpx 60rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 400;
  letter-spacing: 1rpx;
  background: rgba(255,255,255,0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 80rpx;
}

/* ==================== 轮播图 ==================== */
.banner-wrapper {
  position: relative;
  z-index: 1;
  padding: 0 30rpx 24rpx;
}

.banner {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-3);
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-lg);
}

.banner-text {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(16rpx);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 骨架屏轮播图 */
.skeleton-banner {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-lg);
}

/* ==================== 孩子卡片 ==================== */
.child-card {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
  position: relative;
  overflow: hidden;
  z-index: 1;
}

.child-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 15%;
  width: 8rpx;
  height: 70%;
  background: linear-gradient(180deg, var(--primary), #34d399);
  border-radius: 0 6rpx 6rpx 0;
}

.child-card::after {
  content: '';
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(7, 193, 96, 0.05), rgba(7, 193, 96, 0.1));
  border-radius: 50%;
}

.child-name .name {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.child-name .age {
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.child-tag {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-weight: 500;
}

/* 骨架屏孩子卡片 */
.skeleton-child-card {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
}

.skeleton-child-name {
  height: 52rpx;
  width: 200rpx;
  border-radius: 8rpx;
}

.skeleton-child-tag {
  height: 36rpx;
  width: 300rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

/* ==================== 快捷入口 ==================== */
.quick-entry {
  margin: 0 30rpx 30rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  background: var(--card);
  padding: 36rpx 24rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-2);
  position: relative;
  z-index: 1;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-radius: var(--radius-md);
  transition: var(--transition);
}

.entry-item:active {
  background: var(--primary-glow);
  transform: scale(0.92);
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-light), #f0fdf4);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: var(--transition);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.08);
}

.entry-item:active .entry-icon {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  transform: rotate(10deg) scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.entry-text {
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 骨架屏快捷入口 */
.skeleton-quick-entry {
  margin: 0 30rpx 30rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  background: var(--card);
  padding: 36rpx 24rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-2);
}

.skeleton-entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  margin: 0 auto;
}

.skeleton-entry-text {
  height: 24rpx;
  width: 80rpx;
  border-radius: 6rpx;
  margin: 12rpx auto 0;
}

/* ==================== 通用区块 ==================== */
.section {
  margin: 0 30rpx 30rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 36rpx;
  box-shadow: var(--shadow-2);
  position: relative;
  z-index: 1;
  transition: var(--transition);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  transition: var(--transition);
}

.section-more:active {
  background: var(--primary);
  color: #fff;
  transform: scale(0.95);
}

/* 骨架屏区块标题 */
.skeleton-section-title {
  height: 40rpx;
  width: 240rpx;
  border-radius: 8rpx;
}

/* ==================== 最新动态 ==================== */
.news-list {
  display: flex;
  flex-direction: column;
}

.news-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
  transition: var(--transition);
  border-radius: var(--radius-sm);
}

.news-item:last-child {
  border-bottom: none;
}

.news-item:active {
  background: var(--primary-light);
  transform: scale(0.98);
  padding: 24rpx 16rpx;
}

.news-dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, var(--primary), #34d399);
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 8rpx rgba(7, 193, 96, 0.4);
}

.news-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.news-time {
  font-size: 22rpx;
  color: var(--text-hint);
  flex-shrink: 0;
  background: var(--bg);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

/* 骨架屏动态列表 */
.skeleton-news-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.skeleton-news-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.skeleton-news-title {
  flex: 1;
  height: 28rpx;
  border-radius: 6rpx;
}

.skeleton-news-time {
  width: 100rpx;
  height: 32rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* ==================== 家长点评 ==================== */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  background: #fafbfc;
  border-radius: var(--radius-md);
  padding: 28rpx;
  border: 2rpx solid var(--border);
  transition: var(--transition);
}

.comment-item:active {
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.1);
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid #fff;
  box-shadow: var(--shadow-1);
}

.comment-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
}

.comment-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 6rpx;
}

.comment-rating .star {
  font-size: 24rpx;
}

.comment-rating .rating-text {
  font-size: 24rpx;
  color: #f59e0b;
  margin-left: 8rpx;
  font-weight: 700;
}

.comment-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.comment-tags .tag {
  font-size: 22rpx;
  color: var(--primary);
  background: linear-gradient(135deg, var(--primary-light), #f0fdf4);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.comment-content {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.8;
  display: block;
  margin-bottom: 16rpx;
}

.comment-time {
  font-size: 22rpx;
  color: var(--text-hint);
}

.empty-comments {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 骨架屏点评 */
.skeleton-comment-item {
  background: #fafbfc;
  border-radius: var(--radius-md);
  padding: 28rpx;
  border: 2rpx solid var(--border);
}

.skeleton-comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.skeleton-comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.skeleton-comment-name {
  height: 28rpx;
  width: 200rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.skeleton-comment-rating {
  height: 24rpx;
  width: 160rpx;
  border-radius: 6rpx;
}

.skeleton-comment-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.skeleton-comment-content {
  height: 28rpx;
  width: 100%;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.skeleton-comment-content:last-of-type {
  width: 60%;
  margin-bottom: 20rpx;
}

.skeleton-comment-time {
  height: 22rpx;
  width: 140rpx;
  border-radius: 6rpx;
}

/* ==================== 成长案例 ==================== */
.growth-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.growth-item {
  display: flex;
  background: #fafbfc;
  border-radius: var(--radius-md);
  overflow: hidden;
  padding: 0;
  border: 2rpx solid var(--border);
  transition: var(--transition);
}

.growth-item:active {
  border-color: var(--primary);
  box-shadow: var(--shadow-2);
  transform: translateY(-2rpx);
}

.growth-cover {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md) 0 0 var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--primary-light), #f0fdf4);
}

.growth-cover-img {
  width: 100%;
  height: 100%;
}

.growth-no-cover {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
}

.growth-no-cover text {
  font-size: 64rpx;
}

.growth-badge-small {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  color: #fff;
  font-weight: 600;
  backdrop-filter: blur(8rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.growth-badge-small.fitness {
  background: linear-gradient(135deg, #07c160, #059669);
}

.growth-badge-small.height {
  background: linear-gradient(135deg, #f59e0b, #d97706);
}

.growth-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 0;
  padding: 24rpx;
  justify-content: center;
}

.growth-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.6;
}

.growth-meta {
  display: flex;
  gap: 20rpx;
}

.growth-count, .growth-time {
  font-size: 22rpx;
  color: var(--text-hint);
  background: var(--bg);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 骨架屏成长案例 */
.skeleton-growth-item {
  display: flex;
  background: #fafbfc;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.skeleton-growth-cover {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md) 0 0 var(--radius-md);
}

.skeleton-growth-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.skeleton-growth-title {
  height: 32rpx;
  width: 200rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}

.skeleton-growth-desc {
  height: 28rpx;
  width: 100%;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.skeleton-growth-desc:last-of-type {
  width: 70%;
  margin-bottom: 20rpx;
}

.skeleton-growth-meta {
  display: flex;
  gap: 20rpx;
}

.skeleton-growth-meta-text {
  height: 30rpx;
  width: 100rpx;
  border-radius: 8rpx;
}

/* ==================== 精彩瞬间（优化版） ==================== */
.moment-scroll {
  width: 100%;
  overflow-x: auto;
  white-space: nowrap;
}

.moment-scroll ::-webkit-scrollbar {
  display: none;
}

.moment-list {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 20rpx;
}

.moment-item {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  flex-shrink: 0;
  transition: var(--transition);
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-1);
  border: 2rpx solid var(--border);
}

.moment-item:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-3);
  border-color: var(--primary);
}

.moment-image-wrapper {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  overflow: hidden;
}

.moment-image, .moment-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.moment-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--primary);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.moment-info {
  padding: 16rpx;
  background: #fff;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.moment-title {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.moment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-hint);
}

.moment-views {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.moment-date {
  color: var(--text-hint);
}

/* 骨架屏精彩瞬间 */
.skeleton-moment-list {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 20rpx;
}

.skeleton-moment-item {
  display: inline-flex;
