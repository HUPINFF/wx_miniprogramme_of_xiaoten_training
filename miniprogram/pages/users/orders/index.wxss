/* pages/users/my-appointments/index.wxss */

/* ==================== 全局变量 ==================== */
page {
  --bg: #f5f7fa;
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --card: #ffffff;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;
  --border: #f3f4f6;
  --shadow-1: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-2: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-3: 0 8rpx 24rpx rgba(0,0,0,0.08);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 40rpx;
}

/* ==================== 渐变背景 ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 25%, #34d399 50%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
  pointer-events: none;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  padding: 90rpx 40rpx 40rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 400;
  letter-spacing: 1rpx;
  background: rgba(255,255,255,0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

/* ==================== Tab 切换（胶囊式设计） ==================== */
.tabs {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  margin: 0 auto 20rpx;
  display: flex;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-radius: 48rpx;
  padding: 6rpx;
  box-shadow: var(--shadow-2);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 18rpx 8rpx;
  position: relative;
  border-radius: 44rpx;
  transition: var(--transition);
  background: transparent;
  font-weight: 500;
  z-index: 1;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-item.active {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary), #00d68f);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.35);
}

.tab-item .badge {
  background: #ff4757;
  color: #fff;
  font-size: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.3);
  position: relative;
  top: -2rpx;
  text-align: center;
}

.tab-item.active .badge {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  box-shadow: none;
}

/* ==================== 预约列表 ==================== */
.appointment-list {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  margin: 0 auto;
  padding: 8rpx 0 24rpx;
}

/* ==================== 预约卡片 ==================== */
.appointment-card {
  background-color: var(--card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-2);
  border: 2rpx solid var(--border);
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.appointment-card:active {
  transform: scale(0.98);
}

/* 卡片顶部状态条 */
.appointment-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5rpx;
}

.appointment-card.pending::before {
  background: linear-gradient(90deg, #f5a623, #f7c948);
}

.appointment-card.approved::before {
  background: linear-gradient(90deg, var(--primary), #34d399);
}

.appointment-card.rejected::before {
  background: linear-gradient(90deg, #ff6b6b, #ff8a80);
}

.appointment-card.completed::before {
  background: linear-gradient(90deg, #1976d2, #64b5f6);
}

/* ==================== 卡片头部 ==================== */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid var(--border);
}

.status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 状态圆点 */
.status::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  display: inline-block;
}

.status.pending {
  background: linear-gradient(135deg, #fff8e1, #fff3e0);
  color: #e67e00;
  border: 1rpx solid rgba(245, 166, 35, 0.3);
}
.status.pending::before {
  background: #f5a623;
  box-shadow: 0 0 6rpx rgba(245, 166, 35, 0.5);
}

.status.approved {
  background: linear-gradient(135deg, #e8f5e8, #dcedc8);
  color: #05944b;
  border: 1rpx solid rgba(7, 193, 96, 0.3);
}
.status.approved::before {
  background: #07c160;
  box-shadow: 0 0 6rpx rgba(7, 193, 96, 0.5);
}

.status.rejected {
  background: linear-gradient(135deg, #ffebee, #ffcdd2);
  color: #e53935;
  border: 1rpx solid rgba(255, 107, 107, 0.3);
}
.status.rejected::before {
  background: #ff6b6b;
  box-shadow: 0 0 6rpx rgba(255, 107, 107, 0.5);
}

.status.completed {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  color: #0d47a1;
  border: 1rpx solid rgba(25, 118, 210, 0.3);
}
.status.completed::before {
  background: #1976d2;
  box-shadow: 0 0 6rpx rgba(25, 118, 210, 0.5);
}

.date {
  font-size: 24rpx;
  color: var(--text-hint);
  font-weight: 500;
  background: var(--bg);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

/* ==================== 卡片内容 ==================== */
.card-content {
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #fafbfc, #f8f9fa);
  border: 1rpx solid var(--border);
  transition: var(--transition);
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  width: 100rpx;
  font-size: 26rpx;
  color: var(--text-hint);
  font-weight: 500;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.label::before {
  font-size: 24rpx;
}

.info-row .label:has(+ .value)::before {
  /* 可以根据 label 内容设置不同图标，这里用通用图标 */
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
}

.value.remark {
  color: #e53935;
  font-weight: 500;
  font-style: italic;
}

/* ==================== 卡片底部 ==================== */
.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border);
}

.cancel-btn {
  background-color: var(--card);
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 36rpx;
  transition: var(--transition);
  line-height: 1;
}

.cancel-btn::after {
  border: none;
}

.cancel-btn:active {
  background: linear-gradient(135deg, #ff6b6b, #ff5252);
  color: #fff;
  border-color: transparent;
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

/* ==================== 空状态 ==================== */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--text-hint);
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty::before {
  content: '📋';
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 8rpx;
}

/* ==================== 按钮组 ==================== */
.btn-group {
  position: relative;
  z-index: 1;
  width: calc(100% - 60rpx);
  margin: 20rpx auto 0;
  display: flex;
  gap: 20rpx;
}

/* 添加预约按钮 */
.add-appointment-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #07c160 0%, #05a350 100%);
  padding: 28rpx 24rpx;
  border-radius: 48rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: var(--transition);
}

.add-appointment-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.add-icon {
  font-size: 36rpx;
  font-weight: 300;
  width: 44rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.add-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 预约教练按钮 */
.book-coach-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #3b7bc8 100%);
  padding: 28rpx 24rpx;
  border-radius: 48rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.3);
  transition: var(--transition);
}

.book-coach-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.2);
}

.book-coach-btn .btn-icon {
  font-size: 32rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-coach-btn .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}