/* ==================== 全局变量 ==================== */
page {
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --accent: #00d2ff;
  --bg-page: #f0f2f5;
  --bg-card: #ffffff;
  --text-primary: #1a1a2e;
  --text-secondary: #4a4a68;
  --text-tertiary: #8a8aa3;
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  --radius-sm: 16rpx;
  --radius-lg: 32rpx;

  background-color: var(--bg-page);
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 渐变背景层（从上到下：绿色 → 白色透明），与首页/蜕变页同一家族 */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(180deg, #07c160 0%, #e8f5e9 60%, rgba(255, 255, 255, 0) 100%);
  z-index: 0;
}

/* 底部波浪过渡（让渐变自然融入白色背景） */
.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg-page) 100%);
}

/* ==================== 顶部标题区 ====================
   状态栏高度由 js 的 statusBarHeight 动态给出(px)，
   下面这排大标题与蜕变页的「XX的成长」同一套白字样式。 */
.page-top {
  position: relative;
  z-index: 1;
  padding: 0 30rpx 16rpx;
}

.status-bar {
  width: 100%;
}

.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.back-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  transition: background 0.2s ease;
}

.back-btn-hover {
  background: rgba(255, 255, 255, 0.4);
}

.back-icon {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* ==================== 页面内容层 ====================
   卡片压在渐变背景之上：渐变是定位元素，普通文档流内容
   必须包在 z-index:1 的定位容器里才不会被盖住（同蜕变页做法） */
.page-content {
  position: relative;
  z-index: 1;
}

/* ==================== 训练记录时间轴 ==================== */
.timeline-section {
  position: relative;
  z-index: 1;
  margin: 20rpx 30rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.timeline-title-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.timeline-icon {
  font-size: 36rpx;
}

.timeline-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.timeline-badge {
  padding: 8rpx 20rpx;
  background: var(--primary-light);
  border-radius: var(--radius-sm);
}

.badge-text {
  font-size: 22rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

/* ==================== 时间轴主体 ==================== */
.timeline-body {
  padding: 20rpx 0;
}

.timeline-item {
  display: flex;
  padding: 20rpx 30rpx;
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 74rpx;
  top: 80rpx;
  bottom: -20rpx;
  width: 2rpx;
  background: linear-gradient(180deg, var(--primary) 0%, #e8f5e9 100%);
}

.timeline-item:last-child::before {
  display: none;
}

/* 月份标记 */
.timeline-month {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  flex-shrink: 0;
  padding-top: 10rpx;
  position: relative;
  z-index: 2;
}

.month-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--primary);
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  margin-bottom: 16rpx;
  margin-right: 25rpx;
}

.month-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
  white-space: nowrap;
}

/* 内容区域 */
.timeline-content {
  flex: 1;
  margin-top: 25rpx;
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: 2rpx dashed #e0e0e0;
}

.media-group {
  margin-bottom: 24rpx;
}

.media-group:last-child {
  margin-bottom: 0;
}

.media-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.media-icon {
  font-size: 28rpx;
}

.media-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
  transition: transform 0.2s ease;
}

.photo-item:active {
  transform: scale(0.95);
}

.photo-img {
  width: 100%;
  height: 100%;
}

/* 视频网格 */
.video-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.video-item {
  width: 100%;
  aspect-ratio: 16/9;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
  position: relative;
}

.video-media {
  width: 100%;
  height: 100%;
}

.video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  pointer-events: none;
}

.play-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  position: relative;
}

.play-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 55%;
  transform: translate(-50%, -50%);
  border-left: 24rpx solid var(--primary);
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
}

/* 空状态 */
.timeline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.timeline-empty .empty-illustration {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.timeline-empty .empty-emoji {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 100rpx;
}

.timeline-empty .empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.timeline-empty .empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
}

/* 加载状态 */
.timeline-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.timeline-loading .loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: var(--primary);
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

/* 原页面漏了 @keyframes spin，转圈其实一直没动；这里补上 */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.timeline-loading text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.safe-area {
  height: 40rpx;
}
