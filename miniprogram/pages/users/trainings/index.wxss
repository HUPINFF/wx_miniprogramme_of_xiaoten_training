/* pages/users/trainings/index.wxss 我的课表：首页同款渐变头部 + 白卡日程。
   变量与首页同源（page 级 wxss 每页独立，变量要在这份里再声明一遍） */
page {
  --primary: #07c160;
  --primary-light: #e8f5e9;
  --bg: #f5f7fa;
  --card: #ffffff;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;
  --shadow-2: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn 0.4s ease-out both;
}

/* ==================== 渐变背景（首页同一配方，短一截） ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 460rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 30%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
  position: relative;
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  position: relative;
  z-index: 1;
  padding: 96rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

/* 返回键：白透圆钮浮在标题行左侧（首页是 tab 页没有它，这页要自己带） */
.back-btn {
  position: absolute;
  left: 30rpx;
  top: 104rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 40rpx;
  line-height: 60rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.back-btn-active {
  background: rgba(255, 255, 255, 0.32);
}

/* ==================== 日程列表 ==================== */
.schedule-list {
  position: relative;
  z-index: 1;
  padding: 0 30rpx;
}

.day-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx 30rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-2);
}

.day-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}

/* 星期徽章：浅绿底绿字；今天的课整块实心绿，一眼锁定 */
.day-badge {
  min-width: 92rpx;
  padding: 10rpx 0;
  text-align: center;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 16rpx;
}

.day-badge.today {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.day-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.day-date {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.day-count {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* ==================== 课程项 ==================== */
.course-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 4rpx;
}

.course-item + .course-item {
  border-top: 1rpx dashed rgba(60, 60, 67, 0.12);
}

.course-time {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 150rpx;
  flex-shrink: 0;
}

/* 时间是行内第一落点：品牌绿大号，数字走 DIN Alternate（运动数字感） */
.course-time-text {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--primary);
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
  letter-spacing: 1rpx;
}

.course-duration {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-hint);
}

.course-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.course-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.course-coach {
  font-size: 24rpx;
  color: var(--text-sub);
}

.course-arrow {
  flex-shrink: 0;
  color: rgba(60, 60, 67, 0.25);
  font-size: 32rpx;
  font-weight: 600;
}

.course-item-active {
  background: rgba(0, 0, 0, 0.03);
}

/* ==================== 空状态 ==================== */
.empty {
  padding: 100rpx 0 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 10rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-sub);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* ==================== 加载浮层 ==================== */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(255, 255, 255, 0.96);
  padding: 40rpx 48rpx;
  border-radius: 24rpx;
  color: rgba(60, 60, 67, 0.6);
  font-size: 26rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(60, 60, 67, 0.1);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
