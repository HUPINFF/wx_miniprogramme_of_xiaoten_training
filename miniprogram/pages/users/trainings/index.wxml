<!-- pages/users/trainings/index.wxml 我的课表：未来课程按日分组。
     头部弃用 nav-bar 组件，改首页同款品牌绿渐变 + 白字大标题，返回键自己做 -->
<view class="container">
  <view class="gradient-bg"></view>

  <view class="header-area">
    <view class="back-btn" hover-class="back-btn-active" bind:tap="goBack">‹</view>
    <text class="header-title">我的课表</text>
    <text class="header-subtitle">{{currentYearMonth}} · 未来课程</text>
  </view>

  <view class="schedule-list">
    <view wx:for="{{schedule}}" wx:key="date" class="day-card fade-in">
      <view class="day-header">
        <view class="day-badge {{item.isToday ? 'today' : ''}}">周{{item.weekday}}</view>
        <view class="day-info">
          <text class="day-date">{{item.dateText}}</text>
          <text class="day-count">{{item.count}} 节课</text>
        </view>
      </view>

      <view class="courses">
        <view wx:for="{{item.courses}}" wx:for-item="course" wx:key="id"
              class="course-item" hover-class="course-item-active"
              bind:tap="goToDetail" data-id="{{course.id}}">
          <view class="course-time">
            <text class="course-time-text">{{course.startTime || course.time}}</text>
            <text class="course-duration" wx:if="{{course.subTime}}">{{course.subTime}}</text>
          </view>
          <view class="course-main">
            <text class="course-name">{{course.name || '综合训练'}}</text>
            <text class="course-coach" wx:if="{{course.coach}}">{{course.coach}}教练</text>
          </view>
          <text class="course-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{schedule.length === 0 && !loading}}" class="empty fade-in">
      <view class="empty-icon">📅</view>
      <text class="empty-title">暂无未来课程安排</text>
      <text class="empty-sub">有新课排上来就会出现在这里</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
