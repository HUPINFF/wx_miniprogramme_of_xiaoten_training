/* pages/users/write-comment/index.wxss */
page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --primary-dark: #0056CF;
  --primary-light: rgba(0, 122, 255, 0.1);
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;

  background-color: var(--bg);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 60rpx;
}

.form-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  margin: 24rpx;
  padding: 32rpx;
  box-shadow: none;
}

/* 课程信息 → 浅蓝 tint 摘要条 */
.course-info {
  background: rgba(0, 122, 255, 0.08);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.course-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #000;
  display: block;
  margin-bottom: 8rpx;
}

.coach-name {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}

/* 表单项 */
.form-item {
  width: 100%;
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: #FF3B30;
  font-size: 28rpx;
}

/* 评分星星 */
.rating {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.star {
  font-size: 56rpx;
  color: rgba(60, 60, 67, 0.2);
  transition: all 0.2s;
}

.star.active {
  color: #FF9500;
}

.rating-tip {
  font-size: 26rpx;
  color: #007AFF;
}

/* 文本框 */
textarea {
  background-color: #f7f7fa;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #000;
  width: 100%;
  min-height: 240rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

.counter {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-top: 12rpx;
}

/* 标签 */
.tags {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag {
  padding: 12rpx 28rpx;
  background-color: #f7f7fa;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  transition: all 0.2s;
  border: none;
}

.tag.active {
  background-color: #007AFF;
  color: #fff;
  box-shadow: none;
}

/* 去掉激活标签上内联红色小勾的突兀感 */
.tag.active text {
  color: #ffffff !important;
}

/* 匿名选项 */
.anonymous {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.anonymous checkbox {
  transform: scale(0.9);
}

.anonymous text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}

.anonymous-hint {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 提交按钮 → 系统蓝实心 */
.submit-btn {
  background: #007AFF;
  color: #fff;
  border-radius: 24rpx;
  height: 92rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.85;
}

.submit-btn[disabled] {
  background: #d1d1d6;
  box-shadow: none;
  opacity: 1;
}
