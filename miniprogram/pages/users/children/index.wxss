  /* pages/users/home/index.wxss */

  .container1 {
    background-color: #F5F7FA;
    /* padding: 32rpx 32rpx 40rpx 32rpx; */
    padding: 32rpx 32rpx 0rpx 32rpx;
  }

  .container {
    min-height: 100vh;
    background-color: #F5F7FA;
    padding: 32rpx 32rpx 40rpx 32rpx;
  }

  .welcom_seesion {
    display: flex;
    justify-content:space-between;
    align-items:start;
    /* margin-bottom: 24rpx; */
    width: 100%;
    /* margin-bottom: 100rpx; */
  }

  .welcom_text {
    font-size: 50rpx;
    font-weight: 800
  }

  .avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 40rpx;
    border: 2rpx solid #07C160;
  }


  /* 孩子信息卡片 */
  .child-card {
    width: 90%;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.95) 0%, rgba(16, 185, 129, 0.95) 100%);
    border-radius: 24rpx;
    padding: 32rpx;
    /* margin-bottom: 32rpx; */
    box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
  }

  .child-name {
    margin-bottom: 8rpx;
  }

  .child-name .name {
    font-size: 44rpx;
    font-weight: 600;
    color: #FFFFFF;
    margin-right: 16rpx;
  }

  .child-name .age {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.8);
  }

  .child-tag {
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.7);
  }

  .section {
    background-color: #FFFFFF;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
    width: 620rpx;
  }

  .section-header {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28rpx;
  }

  .header-left {
    display: flex;
    /* justify-content: space-between; */
    align-items: baseline;
    gap: 16rpx;
  }

  .section-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #1A1A1A;
  }

  .section-date {
    font-size: 24rpx;
    color: #999999;
  }

  .section-more {
    font-size: 26rpx;
    color: #07C160;
  }

  /* 统计网格 */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24rpx;
  }

  .stat-item {
    background-color: #F8F9FC;
    border-radius: 20rpx;
    padding: 24rpx;
  }

  .stat-label {
    font-size: 26rpx;
    color: #666666;
    margin-bottom: 12rpx;
  }

  .stat-value {
    font-size: 44rpx;
    font-weight: 600;
    color: #1A1A1A;
    margin-bottom: 12rpx;
  }

  .stat-trend {
    display: flex;
    align-items: center;
    gap: 4rpx;
    font-size: 24rpx;
    flex-wrap: wrap;
  }

  .stat-trend.up {
    color: #F5A623;
  }

  .stat-trend.down {
    color: #07C160;
  }

  .trend-arrow {
    font-weight: 500;
  }

  .trend-desc {
    color: #999999;
    margin-left: 4rpx;
  }

  /* 训练列表 */
  .training-item {
    margin-bottom: 32rpx;
    padding-bottom: 32rpx;
    border-bottom: 2rpx solid #F0F0F0;
  }

  .training-item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .training-item .comment {
    margin-bottom: 25rpx;
    margin-left: 510rpx;
    font-size: 26rpx;
    color: #07C160;
  }

  .training-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
  }

  .training-day {
    display: flex;
    align-items: baseline;
    gap: 8rpx;
  }

  .training-day .day {
    font-size: 32rpx;
    font-weight: 600;
    color: #1A1A1A;
  }

  .training-day .date {
    font-size: 24rpx;
    color: #999999;
  }

  .training-tag {
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
    background-color: #F0F0F0;
    color: #666666;
  }

  .training-tag.speed {
    background-color: #E3F2FD;
    color: #1976D2;
  }

  .training-tag.endurance {
    background-color: #E8F5E8;
    color: #2E7D32;
  }

  .training-tag.coordination {
    background-color: #FFF3E0;
    color: #F57C00;
  }

  .training-content {
    background-color: #F8F9FC;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    /* width: 550rpx; */
  }

  .training-row {
    display: flex;
    margin-bottom: 12rpx;
    font-size: 28rpx;
    line-height: 1.5;
  }

  .content-row:last-child {
    margin-bottom: 0;
  }

  .training-row .label {
    width: 140rpx;
    color: #666666;
  }

  .training-row .text {
    flex: 1;
    /* font-size: ; */
    color: #1A1A1A;
  }

  .training-row .text.highlight {
    color: #07C160;
    font-weight: 500;
  }

  .training-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .coach-info {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }

  .coach-avatar {
    width: 48rpx;
    height: 48rpx;
    border-radius: 24rpx;
  }

  .coach-name {
    font-size: 26rpx;
    color: #666666;
  }

  .photo-info {
    display: flex;
    align-items: center;
    gap: 8rpx;
    background-color: #F0F9F0;
    padding: 8rpx 16rpx;
    border-radius: 24rpx;
  }

  .photo-icon {
    font-size: 26rpx;
  }

  .photo-count {
    font-size: 24rpx;
    color: #07C160;
  }

  .photo-info .arrow {
    font-size: 24rpx;
    color: #07C160;
  }

  /* 反馈列表 */
  .feedback-item {
    margin-bottom: 24rpx;
    padding-bottom: 24rpx;
    border-bottom: 2rpx solid #F0F0F0;
  }

  .feedback-item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .feedback-header {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
  }

  .feedback-header .coach-avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 32rpx;
    margin-right: 16rpx;
  }

  .feedback-info {
    flex: 1;
  }

  .feedback-info .coach-name {
    font-size: 28rpx;
    font-weight: 500;
    color: #1A1A1A;
    display: block;
    margin-bottom: 4rpx;
  }

  .feedback-info .feedback-time {
    font-size: 22rpx;
    color: #999999;
  }

  .feedback-content {
    font-size: 28rpx;
    color: #666666;
    line-height: 1.6;
    background-color: #F8F9FC;
    padding: 24rpx;
    border-radius: 16rpx;
  }

  /* 月度总结 */
  .summary-card {
    background-color: #F8F9FC;
    border-radius: 20rpx;
    padding: 28rpx;
  }

  .summary-stats {
    display: flex;
    justify-content: space-around;
    margin-bottom: 32rpx;
  }

  .stat-block {
    text-align: center;
  }

  .stat-number {
    font-size: 44rpx;
    font-weight: 600;
    color: #1A1A1A;
    display: block;
    margin-bottom: 8rpx;
  }

  .stat-block .stat-label {
    font-size: 24rpx;
    color: #999999;
  }

  .summary-progress {
    margin-bottom: 28rpx;
  }

  .progress-item {
    display: flex;
    margin-bottom: 16rpx;
    font-size: 28rpx;
    line-height: 1.5;
  }

  .progress-item:last-child {
    margin-bottom: 0;
  }

  .progress-label {
    width: 160rpx;
    color: #666666;
  }

  .progress-text {
    flex: 1;
    color: #1A1A1A;
  }

  .progress-item.improve .progress-text {
    color: #07C160;
  }

  .progress-item.need-improve .progress-text {
    color: #F5A623;
  }

  .summary-comment {
    background-color: #FFFFFF;
    border-radius: 16rpx;
    padding: 24rpx;
  }

  .comment-header {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
  }

  .head-coach-avatar {
    width: 60rpx;
    height: 60rpx;
    border-radius: 30rpx;
    margin-right: 16rpx;
  }

  .comment-title {
    display: flex;
    flex-direction: column;
  }

  .comment-title .coach-name {
    font-size: 28rpx;
    font-weight: 500;
    color: #1A1A1A;
    margin-bottom: 4rpx;
  }

  .comment-title .coach-title {
    font-size: 22rpx;
    color: #999999;
  }

  .comment-text {
    font-size: 28rpx;
    color: #666666;
    line-height: 1.6;
    font-style: italic;
  }

  /* 空状态 */
  .empty-tip {
    text-align: center;
    padding: 60rpx 0;
    color: #999999;
    font-size: 28rpx;
  }

  /* 加载状态 */
  .loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60rpx 0;
    color: #999999;
    font-size: 28rpx;
  }

  /* 体质测评样式 */
  .rating-badge {
    display: inline-block;
    padding: 12rpx 40rpx;
    border-radius: 48rpx;
    font-size: 32rpx;
    font-weight: 600;
    margin-bottom: 24rpx;
    text-align: center;
  }

  .rating-badge.excellent {
    background-color: #e8f5e8;
    color: #07c160;
  }

  .rating-badge.good {
    background-color: #e3f2fd;
    color: #1976d2;
  }

  .rating-badge.normal {
    background-color: #fff3e0;
    color: #f5a623;
  }

  .rating-badge.poor {
    background-color: #ffe0e0;
    color: #ff6b6b;
  }

  .assessment-row {
    margin-bottom: 24rpx;
    padding-bottom: 16rpx;
    border-bottom: 2rpx solid #f0f0f0;
  }

  .assessment-row:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .assessment-label {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 12rpx;
  }

  .assessment-values {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
  }

  .assessment-values.grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12rpx;
  }

  .assessment-tag {
    background-color: #f8f9fc;
    padding: 8rpx 20rpx;
    border-radius: 30rpx;
    font-size: 26rpx;
    color: #666;
  }

  .assessment-comment {
    background-color: #f8f9fc;
    padding: 20rpx;
    border-radius: 16rpx;
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
  }

  .assessment-footer {
    margin-top: 20rpx;
    padding-top: 16rpx;
    border-top: 2rpx solid #f0f0f0;
    text-align: right;
    font-size: 24rpx;
    color: #999;
  }

  .empty-assessment {
    text-align: center;
    padding: 60rpx 0;
    color: #999;
    font-size: 28rpx;
  }

  .emp-grip {
    width: 100%;
  }

  .emp-text {
    width: 250rpx;
    display: block;
    margin: 0 auto ;
    font-size: 27rpx;
    color: #999;
  }





  .loading-spinner {
    width: 60rpx;
    height: 60rpx;
    border: 4rpx solid #F0F0F0;
    border-top-color: #07C160;
    border-radius: 50%;
    margin-bottom: 20rpx;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

/* ==================== iOS 精修（追加覆盖，后面规则优先） ==================== */
.container1,
.container {
  background-color: #F2F2F7;
}

/* 孩子卡：蓝绿渐变头改白底 iOS 卡片 */
.child-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: none;
  width: 100%;
}
.child-name .name {
  color: #000000;
}
.child-name .age {
  color: rgba(60, 60, 67, 0.6);
}
.child-tag {
  color: rgba(60, 60, 67, 0.6);
}

/* 白色区块统一去投影，改分组白卡 */
.section {
  width: auto;
  box-shadow: none;
  border-radius: 28rpx;
}
.section-title {
  color: #000000;
}
.section-date {
  color: rgba(60, 60, 67, 0.34);
}
.section-more {
  color: #007aff;
}
/* 统计格 */
.stat-item {
  background-color: #f7f7fa;
}
.stat-label {
  color: rgba(60, 60, 67, 0.6);
}
.stat-value {
  color: #000;
}
.stat-trend.up {
  color: #FF9500;
}
.stat-trend.down {
  color: #34C759;
}
.trend-desc {
  color: rgba(60, 60, 67, 0.34);
}

/* 训练列表 hairline 分隔 */
.training-item {
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}
.training-day .day {
  color: #000;
}
.training-day .date {
  color: rgba(60, 60, 67, 0.34);
}
.training-tag {
  background: #f2f2f7;
  color: rgba(60, 60, 67, 0.6);
}
.training-tag.speed {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
}
.training-tag.endurance {
  background: rgba(52, 199, 89, 0.14);
  color: #34C759;
}
.training-tag.coordination {
  background: rgba(255, 149, 0, 0.15);
  color: #FF9500;
}
.training-content {
  background-color: #f7f7fa;
}
.training-row .label {
  color: rgba(60, 60, 67, 0.6);
}
.training-row .text {
  color: #000;
}
.training-row .text.highlight {
  color: #007aff;
}
.coach-name {
  color: rgba(60, 60, 67, 0.6);
}
.photo-info {
  background: rgba(0, 122, 255, 0.1);
}
.photo-count,
.photo-info .arrow {
  color: #007aff;
}

/* 每周反馈 */
.feedback-item {
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}
.feedback-info .coach-name {
  color: #000;
}
.feedback-info .feedback-time {
  color: rgba(60, 60, 67, 0.34);
}
.feedback-content {
  background-color: #f7f7fa;
  color: rgba(60, 60, 67, 0.6);
}

/* 体质测评徽章：语义淡底 + 同色文字 */
.rating-badge.excellent {
  background-color: rgba(52, 199, 89, 0.14);
  color: #34C759;
}
.rating-badge.good {
  background-color: rgba(0, 122, 255, 0.1);
  color: #007aff;
}
.rating-badge.normal {
  background-color: rgba(255, 149, 0, 0.15);
  color: #FF9500;
}
.rating-badge.poor {
  background-color: rgba(255, 59, 48, 0.12);
  color: #FF3B30;
}
.assessment-row {
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}
.assessment-label {
  color: #000;
}
.assessment-tag,
.assessment-comment {
  background-color: #f7f7fa;
  color: rgba(60, 60, 67, 0.6);
}
.assessment-footer {
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
  color: rgba(60, 60, 67, 0.34);
}

/* 空态 / 加载 */
.empty-tip,
.empty-assessment,
.emp-text {
  color: rgba(60, 60, 67, 0.34);
}
.loading text {
  color: rgba(60, 60, 67, 0.34);
}
.loading-spinner {
  border: 4rpx solid rgba(60, 60, 67, 0.1);
  border-top-color: #007aff;
}

