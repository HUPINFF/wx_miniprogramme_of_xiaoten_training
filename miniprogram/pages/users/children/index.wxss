/* pages/users/home/index.wxss */

.container1 {
  background-color: #F5F7FA;
  /* padding: 32rpx 32rpx 40rpx 32rpx; */
  padding: 32rpx 32rpx 0rpx 32rpx;
}

.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 32rpx 32rpx 40rpx 32rpx;
}

.welcom_seesion {
  display: flex;
  justify-content:space-between;
  align-items:start;
  /* margin-bottom: 24rpx; */
  width: 100%;
  /* margin-bottom: 100rpx; */
}

.welcom_text {
  font-size: 50rpx;
  font-weight: 800
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #07C160;
}


/* 孩子信息卡片 */
.child-card {
  width: 90%;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.95) 0%, rgba(16, 185, 129, 0.95) 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  /* margin-bottom: 32rpx; */
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.child-name {
  margin-bottom: 8rpx;
}

.child-name .name {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-right: 16rpx;
}

.child-name .age {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.child-tag {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  width: 620rpx;
}

.section-header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.header-left {
  display: flex;
  /* justify-content: space-between; */
  align-items: baseline;
  gap: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-date {
  font-size: 24rpx;
  color: #999999;
}

.section-header .picker_one {
  margin-left: 40rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding:7rpx 9rpx;
  background-color: #f8f8f8;
  text-align: center;
}

.section-header .picker_two {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding:7rpx 9rpx;
  background-color: #f8f8f8;
  text-align: center;
}

.section-more {
  font-size: 26rpx;
  color: #07C160;
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  background-color: #F8F9FC;
  border-radius: 20rpx;
  padding: 24rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.stat-trend {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  flex-wrap: wrap;
}

.stat-trend.up {
  color: #F5A623;
}

.stat-trend.down {
  color: #07C160;
}

.trend-arrow {
  font-weight: 500;
}

.trend-desc {
  color: #999999;
  margin-left: 4rpx;
}

/* 训练列表 */
.training-item {
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.training-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.training-item .comment {
  margin-bottom: 25rpx;
  margin-left: 510rpx;
  font-size: 26rpx;
  color: #07C160;
}

.training-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.training-day {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.training-day .day {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.training-day .date {
  font-size: 24rpx;
  color: #999999;
}

.training-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background-color: #F0F0F0;
  color: #666666;
}

.training-tag.speed {
  background-color: #E3F2FD;
  color: #1976D2;
}

.training-tag.endurance {
  background-color: #E8F5E8;
  color: #2E7D32;
}

.training-tag.coordination {
  background-color: #FFF3E0;
  color: #F57C00;
}

.training-content {
  background-color: #F8F9FC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  /* width: 550rpx; */
}

.training-row {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.content-row:last-child {
  margin-bottom: 0;
}

.training-row .label {
  width: 140rpx;
  color: #666666;
}

.training-row .text {
  flex: 1;
  /* font-size: ; */
  color: #1A1A1A;
}

.training-row .text.highlight {
  color: #07C160;
  font-weight: 500;
}

.training-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coach-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.coach-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
}

.coach-name {
  font-size: 26rpx;
  color: #666666;
}

.photo-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #F0F9F0;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
}

.photo-icon {
  font-size: 26rpx;
}

.photo-count {
  font-size: 24rpx;
  color: #07C160;
}

.photo-info .arrow {
  font-size: 24rpx;
  color: #07C160;
}

.section-header .change {
  position: absolute;
  right: 0;
  font-size: 25rpx;
  color: #07C160;
}

/* 图表容器 */
.chart-container {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: 24rpx;
  padding-bottom: 16rpx;
  margin: 0 -8rpx;
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.chart-item {
  /* gap: 80rpx; */
  width: 48%;
  margin-bottom: 40rpx;
  text-align: center;flex-shrink: 0;
  width: 220rpx;
  text-align: center;
  background-color: #F8F9FC;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
}


.chart-container::-webkit-scrollbar {
  height: 4rpx;
}


.chart-container::-webkit-scrollbar-thumb {
  background-color: #ddd;
  border-radius: 4rpx;
}

.chart-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
  margin-bottom: 24rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #E8E8E8;
}

.chart-bars {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 24rpx;
  height: 200rpx;
  margin-bottom: 16rpx;
  margin-top: 16rpx;
}

.bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 70rpx;
}

.bar {
  width: 60rpx;
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
  min-height: 20rpx;
  transition: height 0.3s;
}

.bar-value {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #666666;
  white-space: nowrap;
}

.bar-month {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.chart-compare {
  font-size: 24rpx;
  display: block;
}

.chart-compare.up {
  color: #F5A623;
}

.chart-compare.down {
  color: #07C160;
}

/* 反馈列表 */
.feedback-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.feedback-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.feedback-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.feedback-header .coach-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  margin-right: 16rpx;
}

.feedback-info {
  flex: 1;
}

.feedback-info .coach-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
  margin-bottom: 4rpx;
}

.feedback-info .feedback-time {
  font-size: 22rpx;
  color: #999999;
}

.feedback-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  background-color: #F8F9FC;
  padding: 24rpx;
  border-radius: 16rpx;
}

/* 月度总结 */
.summary-card {
  background-color: #F8F9FC;
  border-radius: 20rpx;
  padding: 28rpx;
}

.summary-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.stat-block {
  text-align: center;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.stat-block .stat-label {
  font-size: 24rpx;
  color: #999999;
}

.summary-progress {
  margin-bottom: 28rpx;
}

.progress-item {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.progress-item:last-child {
  margin-bottom: 0;
}

.progress-label {
  width: 160rpx;
  color: #666666;
}

.progress-text {
  flex: 1;
  color: #1A1A1A;
}

.progress-item.improve .progress-text {
  color: #07C160;
}

.progress-item.need-improve .progress-text {
  color: #F5A623;
}

.summary-comment {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.head-coach-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  margin-right: 16rpx;
}

.comment-title {
  display: flex;
  flex-direction: column;
}

.comment-title .coach-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.comment-title .coach-title {
  font-size: 22rpx;
  color: #999999;
}

.comment-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  font-style: italic;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 体质测评样式 */
.rating-badge {
  display: inline-block;
  padding: 12rpx 40rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}

.rating-badge.excellent {
  background-color: #e8f5e8;
  color: #07c160;
}

.rating-badge.good {
  background-color: #e3f2fd;
  color: #1976d2;
}

.rating-badge.normal {
  background-color: #fff3e0;
  color: #f5a623;
}

.rating-badge.poor {
  background-color: #ffe0e0;
  color: #ff6b6b;
}

.assessment-row {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.assessment-row:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.assessment-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.assessment-values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.assessment-values.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.assessment-tag {
  background-color: #f8f9fc;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.assessment-comment {
  background-color: #f8f9fc;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.assessment-footer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.empty-assessment {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}





.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #F0F0F0;
  border-top-color: #07C160;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

