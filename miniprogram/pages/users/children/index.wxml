<view class="container1">
  <nav-bar title="训练主页" showBack="{{true}}"></nav-bar>
  <view class="welcom_seesion">
    <!-- 孩子信息卡片 -->
  <view class="child-card" wx:if="{{childInfo}}">
    <view class="child-name">
      <text class="name">{{childInfo.name}}</text>
      <text class="age">{{childInfo.age}}岁</text>
    </view>

    <view class="child-tag" wx:if="{{childInfo.gender}}">
      {{childInfo.gender === 'male'? '男孩':'女孩'}}
    </view>
  </view>
    <!-- <image class="avatar" src="{{parentInfo.avatarUrl}}" mode="aspectFill"/> -->
  </view>
</view>


<view class="container">
  <!-- 本周核心表现 -->
  <view class="section">
    <view class="section-header">
      <view class="header-left">
        <text class="section-title">本周核心表现</text>
        <text class="section-date">{{currentWeek}}</text>
      </view>
      <text class="section-more" bind:tap="viewHistoryStats">每周记录</text>
    </view>

    <view class="stats-grid">
      <!-- 50米跑 -->
      <view class="stat-item" wx:if="{{performance.fiftyMeter !== NAN}}">
        <view class="stat-label">50米跑</view>
        <view class="stat-value">{{performance.fiftyMeter}}秒</view>
        <view class="stat-trend {{performance.fiftyMeter.trendClass}}">
          <text class="trend-arrow">{{performance.fiftyMeter.trend}}</text>
          <text class="trend-value">{{performance.fiftyMeter.trendValue}}</text>
          <text class="trend-desc">{{performance.fiftyMeter.desc}}</text>
        </view>
      </view>

      <!-- 1000米跑 -->
      <view class="stat-item" wx:if="{{performance.thousandMeter !==NAN}}">
        <view class="stat-label">1000米跑</view>
        <view class="stat-value">{{performance.thousandMeter || '暂无'}}</view>
        <view class="stat-trend {{performance.thousandMeter.trendClass}}">
          <text class="trend-arrow">{{performance.thousandMeter.trend}}</text>
          <text class="trend-value">{{performance.thousandMeter.trendValue}}</text>
          <text class="trend-desc">{{performance.thousandMeter.desc}}</text>
        </view>
      </view>

      <!-- 【新增】800米跑 -->
      <view class="stat-item" wx:if="{{performance.eightHundredMeter !== NAN}}">
        <view class="stat-label">800米跑</view>
        <view class="stat-value">{{performance.eightHundredMeter || '暂无'}}</view>
        <view class="stat-trend" wx:if="{{performance.eightHundredMeter && performance.eightHundredMeter.trend}}">
          <text class="trend-arrow">{{performance.eightHundredMeter.trend}}</text>
          <text class="trend-value">{{performance.eightHundredMeter.trendValue}}</text>
          <text class="trend-desc">{{performance.eightHundredMeter.desc}}</text>
        </view>
      </view>

      <!-- 【新增】仰卧起坐 -->
      <view class="stat-item" wx:if="{{performance.sitUp !==nan}}">
        <view class="stat-label">仰卧起坐</view>
        <view class="stat-value">{{performance.sitUp || '暂无'}}{{performance.sitUp ? '个/分' : ''}}</view>
        <view class="stat-trend" wx:if="{{performance.sitUp && performance.sitUp.trend}}">
          <text class="trend-arrow">{{performance.sitUp.trend}}</text>
          <text class="trend-value">{{performance.sitUp.trendValue}}</text>
          <text class="trend-desc">{{performance.sitUp.desc}}</text>
        </view>
      </view>

       <!-- 【新增】跳绳 -->
       <view class="stat-item" wx:if="{{performance.ropeSkipping !== NAN}}">
        <view class="stat-label">跳绳</view>
        <view class="stat-value">{{performance.ropeSkipping || '暂无'}}{{performance.ropeSkipping ? '个/分' : ''}}</view>
        <view class="stat-trend" wx:if="{{performance.ropeSkipping && performance.ropeSkipping.trend}}">
          <text class="trend-arrow">{{performance.ropeSkipping.trend}}</text>
          <text class="trend-value">{{performance.ropeSkipping.trendValue}}</text>
          <text class="trend-desc">{{performance.ropeSkipping.desc}}</text>
        </view>
      </view>

      <!-- 【新增】坐位体前屈 -->
      <view class="stat-item" wx:if="{{performance.sitAndReach !== NAN}}">
        <view class="stat-label">坐位体前屈</view>
        <view class="stat-value">{{performance.sitAndReach || '暂无'}}{{performance.sitAndReach ? '厘米' : ''}}</view>
        <view class="stat-trend" wx:if="{{performance.sitAndReach && performance.sitAndReach.trend}}">
          <text class="trend-arrow">{{performance.sitAndReach.trend}}</text>
          <text class="trend-value">{{performance.sitAndReach.trendValue}}</text>
          <text class="trend-desc">{{performance.sitAndReach.desc}}</text>
        </view>
      </view>

      <!-- 【新增】立定跳远 -->
      <view class="stat-item" wx:if="{{performance.standingLongJump !== NAN}}">
        <view class="stat-label">立定跳远</view>
        <view class="stat-value">{{performance.standingLongJump || '暂无'}}{{performance.standingLongJump ? '厘米' : ''}}</view>
        <view class="stat-trend" wx:if="{{performance.standingLongJump && performance.standingLongJump.trend}}">
          <text class="trend-arrow">{{performance.standingLongJump.trend}}</text>
          <text class="trend-value">{{performance.standingLongJump.trendValue}}</text>
          <text class="trend-desc">{{performance.standingLongJump.desc}}</text>
        </view>
      </view>

      <!-- 【新增】肺活量测试 -->
      <view class="stat-item" wx:if="{{performance.vitalCapacity!==NAN}}">
        <view class="stat-label">肺活量</view>
        <view class="stat-value">{{performance.vitalCapacity || '暂无'}}{{performance.vitalCapacity ? '毫升' : ''}}</view>
        <view class="stat-trend" wx:if="{{performance.vitalCapacity && performance.vitalCapacity.trend}}">
          <text class="trend-arrow">{{performance.vitalCapacity.trend}}</text>
          <text class="trend-value">{{performance.vitalCapacity.trendValue}}</text>
          <text class="trend-desc">{{performance.vitalCapacity.desc}}</text>
        </view>
      </view>

      <!-- 协调性 -->
      <view class="stat-item" wx:if="{{performance.coordination !== NAN}}">
        <view class="stat-label">协调性</view>
        <view class="stat-value">{{performance.coordination}}分</view>
        <view class="stat-trend {{performance.coordination.trendClass}}">
          <text class="trend-arrow">{{performance.coordination.trend}}</text>
          <text class="trend-value">{{performance.coordination.trendValue}}</text>
          <text class="trend-desc">{{performance.coordination.desc}}</text>
        </view>
      </view>

      <!-- 敏捷性 -->
      <view class="stat-item" wx:if="{{performance.agility !== NAN}}">
        <view class="stat-label">敏捷性</view>
        <view class="stat-value">{{performance.agility}}分</view>
        <view class="stat-trend {{performance.agility.trendClass}}">
          <text class="trend-arrow">{{performance.agility.trend}}</text>
          <text class="trend-value">{{performance.agility.trendValue}}</text>
          <text class="trend-desc">{{performance.agility.desc}}</text>
        </view>
      </view>

    </view>
    <view class="emp-grip" wx:if="{{performance.fiftyMeter ===NAN && performance.thousandMeter ===NAN && performance.eightHundredMeter ===NAN && performance.sitUp === NAN && performance.ropeSkipping ===NAN && performance.sitAndReach ===NAN && performance.standingLongJump ===NAN && performance.vitalCapacity ===NAN && performance.coordination ===NAN && performance.agility ===NAN}}">
      <text class="emp-text">本周暂无表现数据</text>
    </view>
  </view>

  <!-- 本周训练列表 -->
  <view class="section">
    <view class="section-header">
      <view class="header-left">
        <text class="section-title">本周训练</text>
        <text class="section-date">{{weekTrainings.length}}节课</text>
      </view>
      <text class="section-more" bind:tap="viewAllTrainings">查看全部</text>
    </view>

    <view class="training-list">
      <block wx:for="{{weekTrainings}}" wx:key="id">
        <view class="training-item" catch:tap="viewTrainingDetail" data-id="{{item._id}}">
          <!-- 训练头部 -->
          <view class="training-header">
            <view class="training-day">
              <text class="day">{{item.day}}</text>
              <text class="date">{{item.date}}</text>
              <text class="date">{{item.startTime}} - {{item.endTime}}</text>
            </view>
            <view class="training-tag {{item.typeClass}}">{{item.type}}</view>
          </view>

          <!-- 训练内容 -->
          <view class="training-content">
            <view class="training-row">
              <text class="label">训练内容:</text>
              <text class="text">{{item.name}}</text>
            </view>

            <view class="training-row">
              <text class="label">训练重点:</text>
              <text class="text highlight">{{item.focus}}</text>
            </view>

            <view class="training-row">
              <text class="label">训练难点:</text>
              <text class="text">{{item.difficulty}}</text>
            </view>
          </view>


           <!-- 训练照片和教练 -->
           <view class="training-footer">
            <view class="coach-info">
              <image class="coach-avatar" src="{{item.coachAvatar}}" mode="aspectFill"/>
              <text class="coach-name">{{item.coachName}}教练</text>
            </view>

            <view class="photo-info" catch:tap="viewTrainingPhotos" data-id="{{item._id}}">
              <text class="photo-icon">📸</text>
              <text class="photo-count">{{item.photoCount}}张照片</text>
              <text class="arrow">></text>
            </view>
           </view>
        </view>
      </block>

      <!-- 空状态 -->
      <view class="empty-tip" wx:if="{{weekTrainings.length === 0}}">
        <text>本周暂无训练安排</text>
      </view>
    </view>
  </view>

    <!-- 每周反馈 -->
  <view class="section">
    <view class="section-header">
      <view class="header-left">
        <text class="section-title">每周反馈</text>
        <text class="section-date">{{weeklyFeedback.weekRange}}</text>
      </view>
      <text class="section-more" bind:tap="viewAllFeedbacks">查看全部</text>
    </view>

    <view class="feedback-list">
      <block wx:for="{{weeklyFeedback.list}}" wx:key="id">
        <view class="feedback-item">
          <view class="feedback-header">
            <image class="coach-avatar" src="{{ item.coachAvatar}}" mode="aspectFill"/>
            <view class="feedback-info">
              <text class="coach-name">{{item.coachName}} 教练</text>
              <text class="feedback-time">{{item.time}}</text>
            </view>
          </view>

          <view class="feedback-content">
            <text>{{item.content}}</text>
          </view>
        </view>
      </block>

      <view class="empty-tip" wx:if="{{weeklyFeedback.list.length === 0}}">
        <text>本周暂无反馈</text>
      </view>
    </view>
  </view>


  <!-- 新增 本月体质测评 -->
  <view class="section" wx:if="{{currentAssessment}}">
    <view class="section-header">
      <view class="header-left">
        <text class="section-title">本月体质测评</text>
        <text class="section-date">{{currentAssessment.year}}年{{currentAssessment.month}}月</text>
      </view>
      <text class="section-more" bind:tap="viewAssessmentHistory">历史记录</text>
    </view> 

      <!-- 综合等级 -->
    <view class="rating-badge {{currentAssessment.overallRating === '优秀' ? 'excellent' : (currentAssessment.overallRating === '良好' ? 'good' : (currentAssessment.overallRating === '一般' ? 'normal' : 'poor'))}}">
      {{currentAssessment.overallRating}}
    </view>

    <!-- 基础信息 -->
    <view class="assessment-row">
      <view class="assessment-label">📊 基础信息</view>
      <view class="assessment-values">
        <text class="assessment-tag">身高：{{currentAssessment.basicInfo.height}}cm</text>
        <text class="assessment-tag">体重：{{currentAssessment.basicInfo.weight}}kg</text>
        <text class="assessment-tag">BMI:{{currentAssessment.basicInfo.bmi}}</text>
      </view>
    </view>

    <!-- 核心力量 -->
    <view class="assessment-row">
      <view class="assessment-label">💪 核心力量</view>
      <view class="assessment-values">
        <text class="assessment-tag">{{currentAssessment.gender === '男' ? '俯卧撑' : '仰卧起坐'}}: {{currentAssessment.coreStrength.value}}次/分钟</text>
      </view>
    </view>

    <!-- 基础身体素质 -->
    <view class="assessment-row">
      <view class="assessment-label">🏃 基础身体素质</view>
      <view class="assessment-values grid-2">
        <text class="assessment-tag">坐位体前屈: {{currentAssessment.physicalFitness.sitAndReach}}cm</text>
        <text class="assessment-tag">立定跳远: {{currentAssessment.physicalFitness.standingLongJump}}cm</text>
        <text class="assessment-tag">平板支撑: {{currentAssessment.physicalFitness.plank}}秒</text>
        <text class="assessment-tag">靠墙静蹲: {{currentAssessment.physicalFitness.wallSit}}秒</text>
        <text class="assessment-tag">5米折返跑: {{currentAssessment.physicalFitness.fiveMeterShuttle}}秒</text>
        <text class="assessment-tag">1分钟跳绳: {{currentAssessment.physicalFitness.ropeSkipping}}次</text>
      </view>
    </view>

    <!-- 【新增】专项动作模式 -->
    <view class="assessment-row">
      <view class="assessment-label">🎯 专项动作模式</view>
      <view class="assessment-values grid-2">
        <text class="assessment-tag">跑步动作: {{currentAssessment.actionPatterns.running || '未评'}}</text>
        <text class="assessment-tag">立定跳远动作: {{currentAssessment.actionPatterns.longJump || '未评'}}</text>
        <text class="assessment-tag">跳绳动作: {{currentAssessment.actionPatterns.ropeJumping || '未评'}}</text>
        <text class="assessment-tag">深蹲测试: {{currentAssessment.actionPatterns.squat || '未评'}}</text>
        <text class="assessment-tag">跨栏步测试: {{currentAssessment.actionPatterns.hurdleStep || '未评'}}</text>
        <text class="assessment-tag">直线弓步测试: {{currentAssessment.actionPatterns.lunge || '未评'}}</text>
        <text class="assessment-tag">肩部灵活性: {{currentAssessment.actionPatterns.shoulderFlexibility || '未评'}}</text>
        <text class="assessment-tag">主动直腿上抬: {{currentAssessment.actionPatterns.legRaise || '未评'}}</text>
        <text class="assessment-tag">躯干稳定俯卧撑: {{currentAssessment.actionPatterns.trunkPushup || '未评'}}</text>
        <text class="assessment-tag">旋转稳定性: {{currentAssessment.actionPatterns.rotationStability || '未评'}}</text>
      </view>
    </view>

    <!-- 综合评价 -->
    <view class="assessment-row" wx:if="{{currentAssessment.overallComment}}">
      <view class="assessment-label">📝 综合评价</view>
      <view class="assessment-comment">{{currentAssessment.overallComment}}</view>
    </view>

    <!-- 测评时间 -->
    <view class="assessment-footer">
      测评时间: {{currentAssessment.assessmentDate}}
    </view>
  </view>

  <!-- 无测评数据时的占位 -->
  <view class="section" wx:if="{{!currentAssessment && !loading}}">
    <view class="section-header">
      <view class="header-left">
        <text class="section-title">本月体质测评</text>
      </view>
      <text class="section-more" bindtap="viewAssessmentHistory">历史记录 ></text>
    </view>
    <view class="empty-assessment">
      <text>本月暂无体质测评数据</text>
    </view>
  </view>

  <!-- 月度总结 -->
