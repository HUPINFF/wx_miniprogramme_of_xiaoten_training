/* pages/users/moment-detail/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

.detail-card {
  width: 95%;
  background-color: #fff;
  margin: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.detail-image {
  width: 100%;
  height: 500rpx;
  background-color: #f0f0f0;
}

.detail-video {
  width: 100%;
  height: 500rpx;
  background-color: #f0f0f0;
}

.detail-title-wrapper {
  padding: 30rpx 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.video-tag {
  font-size: 24rpx;
  color: #07c160;
  background: #e8f5e9;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.detail-desc {
  font-size: 28rpx;
  color: #666;
  padding: 0 30rpx 20rpx;
  line-height: 1.6;
}

.detail-time {
  font-size: 24rpx;
  color: #999;
  padding: 0 30rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
  margin-top: 10rpx;
  padding-top: 20rpx;
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  padding: 40rpx;
  border-radius: 20rpx;
  color: #fff;
  z-index: 1000;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ==================== iOS 精修（追加覆盖，后面规则优先） ==================== */
.container {
  background-color: #F2F2F7;
}

.detail-card {
  width: auto;
  margin: 24rpx;
  border-radius: 28rpx;
  box-shadow: none;
}

.detail-image,
.detail-video {
  background-color: rgba(60, 60, 67, 0.1);
}

.video-tag {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
  border-radius: 999rpx;
}
.detail-title {
  color: #000000;
}
.detail-desc {
  color: rgba(60, 60, 67, 0.6);
}
.detail-time {
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
  color: rgba(60, 60, 67, 0.34);
}

/* 空态 / 加载 */
.empty {
  color: rgba(60, 60, 67, 0.34);
}
.loading {
  background-color: rgba(255, 255, 255, 0.96);
  color: rgba(60, 60, 67, 0.6);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}
.loading-spinner {
  border: 4rpx solid rgba(60, 60, 67, 0.1);
  border-top-color: #007aff;
}