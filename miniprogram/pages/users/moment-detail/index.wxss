/* pages/users/moment-detail/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

.detail-card {
  width: 95%;
  background-color: #fff;
  margin: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.detail-image {
  width: 100%;
  height: 500rpx;
  background-color: #f0f0f0;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  padding: 30rpx 30rpx 20rpx;
  line-height: 1.4;
}

.detail-desc {
  font-size: 28rpx;
  color: #666;
  padding: 0 30rpx 20rpx;
  line-height: 1.6;
}

.detail-time {
  font-size: 24rpx;
  color: #999;
  padding: 0 30rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
  margin-top: 10rpx;
  padding-top: 20rpx;
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  padding: 40rpx;
  border-radius: 20rpx;
  color: #fff;
  z-index: 1000;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}