page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --primary-dark: #0056CF;
  --primary-light: rgba(0, 122, 255, 0.1);
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;

  background-color: var(--bg);
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.coach-profile {
  padding: 24rpx;
}

.profile-header {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  margin-right: 24rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.role {
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  width: fit-content;
}

.section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.contact-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.contact-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
}

.contact-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.bio-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  font-size: 24rpx;
  color: #4a90d9;
  background: #e3f2fd;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.experience-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 教练列表 */
.coach-list {
  padding: 24rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.list-count {
  font-size: 24rpx;
  color: #999;
}

.coach-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.card-bio {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ==================== iOS 精修（追加覆盖，后面规则优先） ==================== */

/* 头部身份卡：绿渐变 → 白卡 */
.profile-header {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: none;
  border: none;
}
.avatar {
  border: 3rpx solid #ffffff;
}
.name {
  color: #000;
}
.role {
  color: rgba(60, 60, 67, 0.6);
  background: #f2f2f7;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* 分组卡片：白卡无边框投影 */
.section {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: none;
  border: none;
}
.section-title {
  color: #000;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}
.contact-item {
  background: #f7f7fa;
  border-radius: 16rpx;
}
.contact-label {
  color: rgba(60, 60, 67, 0.6);
}
.contact-value {
  color: #000;
}
.contact-arrow {
  color: rgba(60, 60, 67, 0.25);
}

.bio-content,
.experience-content {
  color: #000;
}

/* 擅长领域 tag → 蓝浅底 + 蓝字胶囊 */
.tag {
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 999rpx;
}

.loading {
  color: rgba(60, 60, 67, 0.6);
}
.empty-text {
  color: rgba(60, 60, 67, 0.6);
}