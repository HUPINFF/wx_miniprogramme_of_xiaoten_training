/* pages/users/reports/detail/index.wxss — 家长端成长报告详情
   头部与列表页/growth-records 同一家族；海报卡沿用教练端详情页的版式语言。 */

page {
  --bg-page: #f0f2f5;
  --text-primary: #1a1a2e;
  --text-tertiary: #8a8aa3;
  background-color: var(--bg-page);
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 渐变背景层（从上到下：绿色 → 白色透明），与首页/蜕变页同一家族 */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(180deg, #07c160 0%, #e8f5e9 60%, rgba(255, 255, 255, 0) 100%);
  z-index: 0;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg-page) 100%);
}

/* ==================== 顶部标题区 ==================== */
.page-top {
  position: relative;
  z-index: 1;
  padding: 0 30rpx 16rpx;
}

.status-bar {
  width: 100%;
}

.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.back-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  transition: background 0.2s ease;
}

.back-btn-hover {
  background: rgba(255, 255, 255, 0.4);
}

.back-icon {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* ==================== 页面内容层 ==================== */
.page-content {
  position: relative;
  z-index: 1;
  padding: 20rpx 30rpx 40rpx;
}

.loading-tip,
.fail-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 海报卡：与教练端详情同一套头部/底部语言 */
.poster {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 36rpx 32rpx;
}

.poster-head {
  margin-bottom: 24rpx;
}

.poster-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.poster-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.poster-period {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.poster-type {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
}

.poster-foot {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(26, 26, 46, 0.08);
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.safe-area {
  height: env(safe-area-inset-bottom);
}
