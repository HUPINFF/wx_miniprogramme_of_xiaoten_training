<!-- pages/users/reports/detail/index.wxml — 家长端成长报告详情（只读海报） -->
<view class="container">
  <!-- 渐变背景层：与首页/蜕变页同一家族的绿色渐变 -->
  <view class="gradient-bg"></view>

  <!-- 顶部标题区：白字标题 + 返回按钮，压在渐变上 -->
  <view class="page-top">
    <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
    <view class="header-row">
      <view class="back-btn" hover-class="back-btn-hover" bind:tap="goBack">
        <text class="back-icon">←</text>
      </view>
      <text class="header-title">成长报告</text>
    </view>
  </view>

  <!-- 页面内容层（z-index:1，保证海报压在渐变背景之上） -->
  <view class="page-content">
    <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
    <view class="fail-tip" wx:elif="{{loadFail}}">报告无法查看，请返回重试</view>

    <view class="poster" wx:elif="{{report}}">
      <view class="poster-head">
        <view class="poster-name">{{report.childName}}</view>
        <view class="poster-meta">
          <text class="poster-period">{{report.periodLabel}}</text>
          <text class="poster-type">{{typeLabel}}</text>
        </view>
      </view>
      <report-blocks sections="{{report.sections}}"></report-blocks>
      <view class="poster-foot">腾鑫体育 · 让每一次训练都被看见</view>
    </view>
  </view>

  <view class="safe-area"></view>
</view>
