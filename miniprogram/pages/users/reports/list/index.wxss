/* pages/users/reports/list/index.wxss — 家长端成长报告列表
   头部与 growth-records 同一家族（绿色渐变 + 白字标题 + 圆形返回钮），
   列表行沿用教练端报告行的信息结构（标题 + 时间 + 箭头）。 */

page {
  --bg-page: #f0f2f5;
  --text-primary: #1a1a2e;
  --text-tertiary: #8a8aa3;
  background-color: var(--bg-page);
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 渐变背景层（从上到下：绿色 → 白色透明），与首页/蜕变页同一家族 */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(180deg, #07c160 0%, #e8f5e9 60%, rgba(255, 255, 255, 0) 100%);
  z-index: 0;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg-page) 100%);
}

/* ==================== 顶部标题区 ==================== */
.page-top {
  position: relative;
  z-index: 1;
  padding: 0 30rpx 16rpx;
}

.status-bar {
  width: 100%;
}

.header-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.back-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  transition: background 0.2s ease;
}

.back-btn-hover {
  background: rgba(255, 255, 255, 0.4);
}

.back-icon {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* ==================== 页面内容层 ==================== */
.page-content {
  position: relative;
  z-index: 1;
  padding: 20rpx 30rpx 40rpx;
}

.list-card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 10rpx 30rpx 20rpx;
}

.list-tip {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 24rpx 0 8rpx;
}

.loading-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 报告行：标题 + 发布时间 + 箭头（全是已发布，不需要状态角标） */
.report-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 26rpx 4rpx;
}

.report-item + .report-item {
  border-top: 1rpx dashed rgba(26, 26, 46, 0.08);
}

.report-item-hover {
  background: rgba(7, 193, 96, 0.05);
}

.report-item-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.report-item-date {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.report-arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(26, 26, 46, 0.25);
}

/* 失败态：与空态分开呈现，附带重试入口 */
.fail-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 80rpx 0 60rpx;
}

.fail-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.retry-btn {
  padding: 14rpx 48rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 999rpx;
}

.retry-btn-hover {
  background: rgba(7, 193, 96, 0.2);
}

/* 空态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 80rpx 0 60rpx;
}

.empty-icon {
  font-size: 72rpx;
  line-height: 1;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.safe-area {
  height: env(safe-area-inset-bottom);
}
