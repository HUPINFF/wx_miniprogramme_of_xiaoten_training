/* pages/users/training-photos/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 训练信息卡片 */
.training-info {
  width: 85%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  color: #fff;
}

.training-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.training-date {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 8rpx;
}

.training-coach {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
}

/* 照片网格 - 三列 */
.photos-list {
  padding: 0 20rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  background-color: #f0f0f0;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  padding: 40rpx;
  border-radius: 20rpx;
  color: #fff;
  z-index: 1000;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ==================== iOS 精修（追加覆盖，后面规则优先） ==================== */
.container {
  background-color: #F2F2F7;
}

/* 训练信息：紫色渐变卡改白底卡片 */
.training-info {
  width: auto;
  margin: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  color: #000000;
  box-shadow: none;
}
.training-name {
  color: #000000;
}
.training-date,
.training-coach {
  color: rgba(60, 60, 67, 0.6);
  opacity: 1;
}

/* 照片占位 */
.photo-item {
  background-color: rgba(60, 60, 67, 0.1);
}

/* 空态 / 加载 */
.empty {
  color: rgba(60, 60, 67, 0.34);
}

.loading {
  background-color: rgba(255, 255, 255, 0.96);
  color: rgba(60, 60, 67, 0.6);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}
.loading-spinner {
  border: 4rpx solid rgba(60, 60, 67, 0.1);
  border-top-color: #007aff;
}