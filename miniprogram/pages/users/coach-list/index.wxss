/* pages/contact/index.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 顶部横幅 - 移除margin-top，从顶部开始 */
.contact-header {
  margin-top: 20rpx;
  width: 85%;
  margin: 10rpx auto;
  background: linear-gradient(135deg, #3b82f6 0%, #10b981 100%);
  padding: 60rpx 30rpx 80rpx;
  margin-bottom: -40rpx;
  border-radius: 24rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 联系方式卡片区域 */
.contact-cards {
  width: 80%;
  /* margin: 60rpx; */
  margin: 40rpx auto;
  margin-top: 70rpx;
  background-color: #fff;
  border-radius: 24rpx;
  /* margin: 0 20rpx 20rpx; */
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.contact-card {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.contact-card.no-border {
  border-bottom: none;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.phone-icon {
  background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
}

.wechat-icon {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
}

.address-icon {
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
}

.time-icon {
  background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%);
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.card-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card-arrow {
  font-size: 28rpx;
  color: #ccc;
  margin-left: 20rpx;
}

.map-section {
  width: 80%;
  margin: 20rpx auto ;
}

/* 表单区域 */
.form-section {
  /* margin: 0 20rpx 20rpx; */
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.form-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.textarea-item {
  position: relative;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  height: 60rpx;
  padding: 0 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.form-picker {
  width: 100%;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #333;
  padding: 16rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 30rpx;
  color: #333;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.textarea-counter {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #999;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 30rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #10b981 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);
}

.submit-btn::after {
  border: none;
}

.submit-btn.submitting {
  opacity: 0.7;
}

/* 地图区域 */
.map-section {
  width: 90%;
  margin: 0 20rpx;
}

.map-card {
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.location-map {
  width: 100%;
  height: 300rpx;
}

.map-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #fff;
}

.map-address {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.map-nav {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 500;
  margin-left: 20rpx;
}

.bottom-space {
  height: 40rpx;
}