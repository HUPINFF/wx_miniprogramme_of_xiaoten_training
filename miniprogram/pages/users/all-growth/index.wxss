/* pages/users/all-growth/index.wxss */
page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --primary-dark: #0056CF;
  --primary-light: rgba(0, 122, 255, 0.1);
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --shadow-1: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;

  background-color: var(--bg);
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 60rpx;
}

.page-content {
  padding: 8rpx 24rpx 0;
}

/* 分类筛选 → iOS 分段控件 */
.category-filter {
  display: flex;
  gap: 8rpx;
  margin: 16rpx 0 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  padding: 6rpx;
  border-radius: 999rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: transparent;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  font-weight: 500;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.filter-item.active {
  background: var(--primary);
  color: #ffffff;
  font-weight: 600;
}

/* 成长案例容器 */
.growth-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

/* 成长案例卡片 */
.growth-item {
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
  transition: opacity 0.2s ease;
}

.growth-item:active {
  opacity: 0.85;
}

/* 封面 */
.growth-cover {
  position: relative;
  width: 100%;
  height: 340rpx;
  background: #f7f7fa;
}

.growth-cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.growth-no-cover {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f7f7fa 0%, #ececf1 100%);
}

.growth-no-cover text {
  font-size: 120rpx;
  opacity: 0.6;
}

/* 徽章（叠图 frosted 标签，去渐变发光） */
.growth-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.growth-badge.fitness,
.growth-badge.height {
  background: rgba(0, 0, 0, 0.45);
}

/* 媒体数量指示器 */
.growth-media-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

/* 详情区域 */
.growth-details {
  padding: 28rpx;
}

.growth-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.growth-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
  flex: 1;
  line-height: 1.3;
}

.growth-time {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-left: 20rpx;
  white-space: nowrap;
}

/* 描述 */
.growth-desc {
  background: #f7f7fa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.growth-desc text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.6;
}

/* 空状态 */
.empty-growth {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background: var(--card);
  border-radius: 28rpx;
  margin-top: 20rpx;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 30rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.34);
  text-align: center;
  line-height: 1.5;
}
