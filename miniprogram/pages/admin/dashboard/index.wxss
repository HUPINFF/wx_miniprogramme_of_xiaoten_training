/* pages/admin/dashboard/index.wxss — iOS 风格，与 coach 端其它页面一致 */

page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-xl: 32rpx;
  --green: #34C759;
  --orange: #FF9500;
  --red: #FF3B30;
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 24rpx 0 calc(140rpx + env(safe-area-inset-bottom));
}

/* ==================== 分组 ==================== */
.section {
  margin: 0 30rpx 28rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-sub);
  margin: 0 0 12rpx 8rpx;
}

.section-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
  margin: 12rpx 0 0 8rpx;
}

/* ==================== 指标行 ==================== */
.stat-row {
  display: flex;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 32rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--text-main);
}

.stat-num.ok { color: var(--green); }
.stat-num.running { color: var(--primary); }
.stat-num.warn { color: var(--orange); }

.stat-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* ==================== 本月课时 ==================== */
.month-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 36rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.month-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.month-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.1;
}

.month-num.income { color: var(--green); }

.month-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.month-divider {
  width: 1rpx;
  height: 72rpx;
  background: var(--border);
}

/* ==================== 待办 ==================== */
.todo-card {
  background: var(--card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
  transition: background-color 0.15s ease;
}

.todo-item:last-child { border-bottom: none; }
.todo-item:active { background-color: rgba(60, 60, 67, 0.04); }

.todo-icon { font-size: 36rpx; margin-right: 20rpx; }

.todo-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.todo-count {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-hint);
  margin-right: 12rpx;
}

.todo-count.has { color: var(--red); }

.todo-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
}

/* ==================== 趋势图 ==================== */
.trend-card {
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
}

.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  gap: 8rpx;
}

.trend-value {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1;
}

/* 柱子容器：吃掉剩余高度，柱子按 percent 从底部长上来 */
.trend-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.trend-bar {
  width: 36rpx;
  min-height: 4rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #4DA3FF 0%, var(--primary) 100%);
}

.trend-label {
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1;
}

.trend-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 40rpx 0;
}
