/* pages/admin/schedule/index.wxss — 排课调度中心，iOS 风格与 dashboard 一致 */

page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-xl: 32rpx;
  --green: #34C759;
  --orange: #FF9500;
  --red: #FF3B30;
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 24rpx 0 calc(40rpx + env(safe-area-inset-bottom));
}

.section {
  margin: 0 30rpx;
}

/* ==================== 头部：日期切换 + 新建 ==================== */
.sched-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sched-date-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sched-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: 50%;
  font-size: 32rpx;
  color: var(--text-sub);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.sched-arrow:active { background-color: rgba(60, 60, 67, 0.08); }

.sched-date {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  padding: 0 8rpx;
}

.sched-date.today { color: var(--primary); }

.sched-add {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--green);
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
}

.sched-add:active { opacity: 0.85; }

.sched-summary {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  margin: 0 8rpx 12rpx;
}

.sched-summary-conflict { color: var(--red); font-weight: 500; }

/* ==================== 时间轴列表 ==================== */
.sched-card {
  background: var(--card);
  border-radius: var(--radius-xl);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.sched-empty {
  padding: 56rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-hint);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sched-empty-hint { font-size: 22rpx; }

.sched-item {
  display: flex;
  align-items: stretch;
  padding: 24rpx 20rpx 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
  transition: background-color 0.15s ease;
}

.sched-item:last-child { border-bottom: none; }
.sched-item:active { background-color: rgba(60, 60, 67, 0.04); }

.sched-time {
  width: 150rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  border-right: 1rpx solid var(--border);
  margin-right: 24rpx;
}

.sched-time-main {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.2;
}

.sched-reminded {
  font-size: 20rpx;
  color: var(--text-hint);
}

.sched-reminded.on { color: var(--green); }

.sched-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sched-row1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sched-child {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: #00C26E;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.sched-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sched-status {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(60, 60, 67, 0.08);
  color: var(--text-sub);
}

.sched-status.st-in_class { background: rgba(0, 122, 255, 0.12); color: var(--primary); }
.sched-status.st-finished { background: rgba(52, 199, 89, 0.14); color: var(--green); }
.sched-status.st-scheduled { background: rgba(255, 149, 0, 0.14); color: var(--orange); }

.sched-row2 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.sched-loc {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sched-flags {
  display: flex;
  gap: 10rpx;
}

.sched-flag {
  font-size: 20rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
}

.sched-flag.conflict {
  background: rgba(255, 59, 48, 0.12);
  color: var(--red);
  font-weight: 600;
}

.sched-flag.changed {
  background: rgba(255, 149, 0, 0.12);
  color: var(--orange);
}

.sched-edit {
  flex-shrink: 0;
  align-self: center;
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--primary);
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(0, 122, 255, 0.35);
  border-radius: 24rpx;
}

.sched-edit:active { background-color: rgba(0, 122, 255, 0.08); }
