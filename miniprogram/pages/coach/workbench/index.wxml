<!--pages/coach/workbench/index.wxml-->
<!-- <text>pages/coach/workbench/index.wxml</text> -->
<view class="container">
  <!-- <nav-bar title="工作台" showBack="{{false}}"></nav-bar> -->
  <view class="gradient-bg"></view>

  <view class="header-area">
    <text class="header-title">工作台</text>
    <text class="header-subtitle">记录每一次进步</text>
  </view>

  <view wx:if="{{loading}}" class="skeleton-page">
    <view class="skeleton-banner skeleton-shimmer"></view>

    <view class="skeleton-card">
      <view class="skeleton-avatar skeleton-shimmer"></view>
      <view class="skeleton-card-content">
        <view class="skeleton-line skeleton-line-lg skeleton-shimmer"></view>
        <view class="skeleton-line skeleton-line-sm skeleton-shimmer"></view>
      </view>
    </view>

    <view class="skeleton-card">
      <view class="skeleton-line skeleton-line-lg skeleton-shimmer"></view>
      <view class="skeleton-line skeleton-line-md skeleton-shimmer"></view>
    </view>

    <view class="skeleton-grid">
      <view class="skeleton-grid-item skeleton-shimmer" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
    </view>

    <view class="section">
      <view class="section-header">
        <view class="skeleton-line skeleton-line-title skeleton-shimmer"></view>
      </view>
      <view class="skeleton-list">
        <view class="skeleton-list-item" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="skeleton-line skeleton-line-sm skeleton-shimmer"></view>
          <view class="skeleton-line skeleton-line-md skeleton-shimmer"></view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <view class="skeleton-line skeleton-line-title skeleton-shimmer"></view>
      </view>
      <view class="skeleton-list">
        <view class="skeleton-list-item" wx:for="{{[1,2]}}" wx:key="*this">
          <view class="skeleton-line skeleton-line-md skeleton-shimmer"></view>
          <view class="skeleton-pill skeleton-shimmer"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else>
    <!-- 顶部轮播图 -->
    <view class="banner-wrapper">
      <swiper class="banner" indicator-dots autoplay interval="3000" circular>
        <swiper-item wx:for="{{banners}}" wx:key="index">
          <image src="{{item.image}}" mode="aspectFill" class="banner-image"/>
          <view class="banner-text" wx:if="{{item.text}}">
            <text>{{item.text}}</text>
          </view>
        </swiper-item>
      </swiper>
    </view>

 <!-- 使用教练卡片组件 -->
<coach-card
  coachInfo="{{coachInfo}}"
  editable="{{true}}"
  bind:update="onCoachUpdate"
/>

  <!-- 欢迎不分 -->
  <!-- 欢迎语 -->
<view class="welcome">
  <view class="welcome-left">
    <text class="greeting">👋 你好，{{coachInfo.name}}教练</text>
    <text class="date">{{todayDate}}</text>
  </view>
  <view class="welcome-right">
    <text>💪</text>
  </view>
</view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="action" bind:tap="gotoChildrenList">
      <text class="iconfont icon-wodexueyuan"></text>
      <text>学员管理</text>
    </view>

    <view class="action" bind:tap="gotoWeeklyPerformance">
      <text class="iconfont icon-luruchengji"></text>
      <text>录入成绩</text>
    </view>

    <view class="action" bind:tap="gotoFeedback">
      <text class="iconfont icon-tianxiefankui"></text>
      <text>写反馈</text>
    </view>

    <view class="action" bind:tap="gotoAppointments">
      <text class="iconfont icon-yuyueshenpi"></text>
      <text>预约审批</text>
    </view>

     <!-- 新增：内容管理入口 -->
     <view class="action" bindtap="gotoContentManage">
      <text class="iconfont icon-neirongguanli"></text>
      <text>内容管理</text>
    </view>

  </view>

  <!-- 今日课程 -->

  <view class="section">
    <view class="section-header">
      <text class="title iconfont icon-jinrikecheng"> 今日课程</text>
      <text class="count">{{todayTrainings.length}}节</text>
    </view>

    <view class="training-list">
      <view class="training-item" wx:for="{{todayTrainings}}" wx:key="_id">
        <view class="time">{{item.startTime}}</view>
        <view class="info" bind:tap="goToTrainingDetail" data-id="{{item._id}}">
          <text class="name">{{item.name}}</text>
          <text class="child">{{item.childName}}</text>
        </view>
        <view
          class="start-btn status-{{item.status || 'pending'}}"
          bind:tap="goToClass"
          data-id="{{item._id}}"
          style="{{(!item.status || item.status === 'pending') && !item.canStart ? 'background: #c7c7cc;' : ''}}{{item.status === 'in_class' ? 'background: #007AFF;' : ''}}{{item.status === 'finished' ? 'background: #aeaeb2;' : ''}}"
        >
          <text>{{(!item.status || item.status === 'pending') && item.canStart ? '上课' : ''}}{{(!item.status || item.status === 'pending') && !item.canStart ? '未到时间' : ''}}{{item.status === 'in_class' ? '上课中' : ''}}{{item.status === 'finished' ? '已下课' : ''}}</text>
        </view>
      </view>

      <view wx:if="{{todayTrainings.length === 0}}" class="empty">暂无今日课程</view>
    </view>
  </view>

  <!-- 代办事项 -->

  <view class="section">
    <view class="section-header">
      <text class="title iconfont icon-jinrikecheng"> 今日待办</text>
    </view>

    <view class="todo-list">
      <view class="todo-item" bind:tap="gotoWeeklyPerformance">
        <text>📊 待录入周表现</text>
        <text class="badge">{{todo.weeklyPerformance}}</text>
      </view>

      <view class="todo-item" bind:tap="gotoFeedback">
        <text>💬 待写反馈</text>
        <text class="badge">{{todo.feedback}}</text>
      </view>

    </view>
  </view>

  <!-- 最新动态/公告 -->

  <view class="section">
    <view class="section-header">
      <text class="section-title iconfont icon-zuixindongtai"> 最新动态</text>
      <text class="section-more" bind:tap="viewAllNews">查看更多</text>
    </view>

    <view class="news-list">
      <view class="news-item" wx:for="{{newsList}}" wx:key="index" bind:tap="viewNews" data-id="{{item.id}}">
        <view class="news-dot"></view>
        <text class="news-title">{{item.title}}</text>
        <text class="news-time">{{item.time}}</text>
      </view>
    </view>
  </view>

  <!-- 近期精彩瞬间 -->

  <view class="section">
    <view class="section-header">
      <text class="section-title iconfont icon-jingcaishunjian"> 精彩瞬间</text>
      <text class="section-more" bind:tap="viewMoreMoments">更多</text>
    </view>

    <scroll-view class="moment-scroll" scroll-x="true">
      <view class="moment-list">
        <view class="moment-item" wx:for="{{moments}}" wx:key="index" bind:tap="viewMoment" data-id="{{item._id}}">
          <image class="moment-image" src="{{item.image}}" mode="aspectFill"></image>
          <text class="moment-title">{{item.title}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 家长点评 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">💬 家长点评</text>
      <text class="section-more" bind:tap="viewAllComments">查看全部</text>
    </view>

    <view class="comment-list" wx:if="{{comments.length > 0}}">
      <view class="comment-item" wx:for="{{comments}}" wx:key="_id" bind:tap="viewCommentDetail" data-id="{{item._id}}">
        <view class="comment-header">
          <image class="comment-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="comment-info">
            <text class="comment-name">{{item.nickName}}</text>
            <view class="comment-rating">
              <text class="star" wx:for="{{5}}" wx:key="*this" wx:for-item="starItem">★</text>
              <text class="rating-text">{{item.rating}}分</text>
            </view>
          </view>
        </view>
        <view class="comment-tags" wx:if="{{item.tags && item.tags.length > 0}}">
          <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{tagItem}}</text>
        </view>
        <text class="comment-content">{{item.content}}</text>
        <view class="comment-footer">
          <text class="comment-time">{{item.createTime}}</text>
          <view class="comment-delete" catch:tap="deleteComment" data-id="{{item._id}}" data-training-id="{{item.trainingId}}">
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-comments" wx:else>
      <text>暂无点评</text>
    </view>
  </view>

  <!-- 成长案例 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🚀 学员成长记录</text>
      <text class="section-more" bind:tap="viewAllGrowth">查看全部</text>
    </view>

    <view class="growth-showcase" wx:if="{{growthList && growthList.length > 0}}">
      <scroll-view class="growth-scroll" scroll-x="true" enhanced show-scrollbar="{{false}}">
        <view class="growth-cards">
          <view class="growth-card {{index === 0 ? 'featured' : ''}}" wx:for="{{growthList}}" wx:key="_id" bind:tap="viewGrowthDetail" data-id="{{item._id}}">
            <view class="growth-cover">
              <image wx:if="{{item.coverImage}}" class="growth-cover-img" src="{{item.coverImage}}" mode="aspectFill"></image>
              <view wx:if="{{!item.coverImage}}" class="growth-no-cover">
                <text>🌟</text>
              </view>
              <view class="growth-badge">
                <text>成长记录</text>
              </view>
              <view class="growth-overlay">
                <view class="growth-icon">📸</view>
                <text class="growth-count">{{item.mediaCount || 0}}</text>
              </view>
            </view>
            <view class="growth-info">
              <text class="growth-title">{{item.title}}</text>
              <view class="growth-tags" wx:if="{{item.tags && item.tags.length > 0}}">
                <text class="growth-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
              </view>
              <view class="growth-progress" wx:if="{{item.description}}">
                <text class="progress-text">{{item.description}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="empty-growth" wx:else>
      <view class="empty-growth-icon">🚀</view>
      <text class="empty-growth-text">暂无成长记录</text>
      <text class="empty-growth-hint">记录学员成长每一步</text>
    </view>
  </view>

  <!-- 课程管理 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📚 课程管理</text>
      <view class="manage-btn" bind:tap="gotoCourseManage">
        <text>管理课程</text>
      </view>
    </view>

    <view class="course-showcase" wx:if="{{courseList && courseList.length > 0}}">
      <scroll-view class="course-scroll" scroll-x="true" enhanced show-scrollbar="{{false}}">
        <view class="course-cards">
          <view class="course-card {{index === 0 ? 'featured' : ''}}" wx:for="{{courseList}}" wx:key="_id" bind:tap="viewCourseDetail" data-id="{{item._id}}">
            <view class="course-cover">
              <image wx:if="{{item.coverImage}}" class="course-cover-img" src="{{item.coverImage}}" mode="aspectFill"></image>
              <view wx:if="{{!item.coverImage}}" class="course-no-cover">
                <text>📚</text>
              </view>
              <view class="course-badge">
                <text>课程</text>
              </view>
            </view>
            <view class="course-info">
              <text class="course-title">{{item.courseName}}</text>
              <view class="course-meta">
                <text class="course-hours">📅 {{item.trainingHours}}课时</text>
              </view>
              <view class="course-progress" wx:if="{{item.content}}">
                <text class="progress-text">{{item.content}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="empty-course" wx:else>
      <view class="empty-course-icon">📚</view>
      <text class="empty-course-text">暂无课程</text>
      <text class="empty-course-hint">点击管理课程创建新课程</text>
    </view>
  </view>

  </view>
</view>