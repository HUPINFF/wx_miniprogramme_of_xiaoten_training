/* pages/coach/workbench/index.wxss */
@import "../common.wxss";

/* 欢迎语 */
.welcome {
  width: 90%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.coach-card {
  width: 95%;
  margin-right: 65rpx;
}

.greeting {
  /* width: 95%; */
  font-size: 40rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.date {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 今日课程列表 */
.training-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.training-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fc;
  border-radius: 16rpx;
  /* height: 140rpx; */
}

.time {
  width: 180rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #07c160;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  /* margin-left:25rpx ; */
}

.info .name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.info .child {
  font-size: 26rpx;
  color: #999;
}

/* 待办事项 */
.todo-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.todo-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #f8f9fc;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
}

.badge {
  background-color: #07c160;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

/* 快捷入口 */
.quick-actions {
  width: 95%;
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
}

.action text:first-child {
  font-size: 48rpx;
}

.action text:last-child {
  font-size: 26rpx;
  color: #666;
}

/* 轮播图外层容器 */
.banner-wrapper {
  width: 100%;
  margin-top: 0;
  padding: 20rpx 0;
}

/* 轮播图 */
.banner {
  width: 92%;
  height: 320rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-text {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  background-color: rgba(0, 0, 0, 0.5);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  color: #fff;
  font-size: 24rpx;
}

/* 最新动态 */
.news-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.news-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.news-item:last-child {
  border-bottom: none;
}

.news-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #07c160;
  border-radius: 50%;
}

.news-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-time {
  font-size: 24rpx;
  color: #999;
}

/* 关于我们 */
.about-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background-color: #f0f0f0;
}

.about-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  text-align: center;
}

/* 精彩瞬间 */
.moment-scroll {
  width: 100%;
  overflow-x: auto;
  white-space: nowrap;
}

.moment-list {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 0 20rpx 0;
}

.moment-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  flex-shrink: 0;
}

.moment-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background-color: #e0e0e0;
}

.moment-title {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  margin-top: 12rpx;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 联系我们 */
.contact-section {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  border-radius: 24rpx;
  margin: 0 20rpx 30rpx 20rpx;
  padding: 30rpx;
  color: #fff;
}

.contact-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
}

.contact-icon {
  font-size: 32rpx;
}