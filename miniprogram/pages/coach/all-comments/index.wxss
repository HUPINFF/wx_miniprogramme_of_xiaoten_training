/* pages/coach/all-comments/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  transition: transform 0.2s;
}

.comment-item:active {
  transform: scale(0.98);
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: #f2f2f7;
  flex-shrink: 0;
}

.comment-info {
  flex: 1;
}

.comment-name {
  font-size: 28rpx;
  color: #000;
  font-weight: 600;
}

.comment-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 4rpx;
}

.star {
  font-size: 24rpx;
  color: #ff9500;
}

.rating-text {
  font-size: 24rpx;
  color: #ff9500;
  margin-left: 8rpx;
  font-weight: 600;
}

.comment-time {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

.comment-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 22rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.comment-content {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.6;
  display: block;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.34);
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}
