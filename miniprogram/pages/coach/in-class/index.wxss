/* pages/coach/in-class/index.wxss */
@import "../common.wxss";

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.content {
  padding: 24rpx;
}

/* 课程卡片 */
.course-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.course-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.course-time {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

.course-status {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.course-status.pending {
  color: #999;
  background: #f0f0f0;
}

.course-status.in_class {
  color: #4a90d9;
  background: #e8f0f8;
}

.course-status.finished {
  color: #07c160;
  background: #e8f8f0;
}

.course-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: #999;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-item .value.highlight {
  color: #07c160;
}

/* 训练内容区域 */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
}

.finish-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.finish-btn text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-header text {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.modal-body {
  padding: 32rpx;
  text-align: center;
}

.deduct-info {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.deduct-label {
  font-size: 30rpx;
  color: #666;
}

.deduct-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #e53935;
}

.remaining-info {
  font-size: 28rpx;
  color: #999;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-cancel {
  color: #666;
  border-right: 2rpx solid #f0f0f0;
}

.btn-confirm {
  color: #fff;
  background-color: #e53935;
}

/* 训练项目打卡清单 */
.items-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.items-head .section-title {
  margin-bottom: 0;
}

.items-progress {
  font-size: 26rpx;
  color: #999;
}

.check-list {
  margin-top: 8rpx;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.check-row:last-child {
  border-bottom: none;
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid #d1d1d6;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.check-circle.done {
  background: #34c759;
  border-color: #34c759;
}

.check-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: #333;
}

/* 组数/个数（如「3组×12次」）右对齐灰字，选填没填就不显示 */
.check-amount {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.check-name.done {
  color: #999;
}

/* 勾完成展开的表现块：本次表现输入框 */
.check-item {
  border-bottom: 2rpx solid #f0f0f0;
}

.check-item:last-child {
  border-bottom: none;
}

/* 勾选行原来的分隔线交给外层 check-item 管，避免双线 */
.check-item .check-row {
  border-bottom: none;
}

.perf-box {
  padding: 0 0 20rpx 60rpx;
}

.perf-input {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #333;
  background: #f7f8fa;
  border-radius: 12rpx;
}

/* 精彩照片/视频现场录入 */
.media-hint {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.video-thumb {
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-play {
  color: #fff;
  font-size: 40rpx;
}

.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed rgba(74, 144, 217, 0.5);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #4a90d9;
}

.photo-add:active {
  background: rgba(74, 144, 217, 0.08);
}

.add-icon {
  font-size: 48rpx;
  line-height: 1;
}

.add-label {
  font-size: 24rpx;
  margin-top: 8rpx;
}