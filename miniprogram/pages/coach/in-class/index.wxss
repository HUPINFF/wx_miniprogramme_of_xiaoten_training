/* pages/coach/in-class/index.wxss — iOS 风格 */
@import "../common.wxss";

page {
  background-color: #F2F2F7;
}

.container {
  min-height: 100vh;
  background-color: #F2F2F7;
  padding-bottom: 200rpx;
}

.content {
  padding: 24rpx;
}

/* 课程卡片 */
.course-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.course-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #000;
}

.course-status {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.course-status.pending {
  color: rgba(60, 60, 67, 0.6);
  background: #f2f2f7;
}

.course-status.in_class {
  color: #007aff;
  background: rgba(0, 122, 255, 0.12);
}

.course-status.finished {
  color: #34c759;
  background: rgba(52, 199, 89, 0.14);
}

.course-info {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}

.info-item .value {
  font-size: 28rpx;
  color: #000;
  font-weight: 600;
}

.info-item .value.highlight {
  color: #007aff;
}

/* 训练内容区域 */
.section {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.7;
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(249, 249, 251, 0.92);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(60, 60, 67, 0.12);
}

.finish-btn {
  width: 100%;
  height: 96rpx;
  background: #007aff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.finish-btn:active {
  opacity: 0.85;
}

.finish-btn text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
}

.modal-header {
  padding: 36rpx 32rpx 16rpx;
  text-align: center;
}

.modal-header text {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
}

.modal-body {
  padding: 8rpx 32rpx 32rpx;
  text-align: center;
}

.deduct-label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-cancel {
  color: #007aff;
  border-right: 1rpx solid rgba(60, 60, 67, 0.1);
}

.btn-confirm {
  color: #ff3b30;
}
