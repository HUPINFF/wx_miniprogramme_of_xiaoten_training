<!--pages/coach/in-class/index.wxml-->
<view class="container">
  <nav-bar title="{{training.status === 'in_class' ? '上课中' : '课程详情'}}" showBack="{{true}}"></nav-bar>
  
  <view class="content">
    <!-- 课程信息卡片 -->
    <view class="course-card">
      <view class="course-header">
        <text class="course-name">{{training.name}}</text>
        <text class="course-status {{training.status}}">{{training.status === 'pending' ? '待上课中' : ''}}{{training.status === 'in_class' ? '上课中' : ''}}{{training.status === 'finished' ? '已下课' : ''}}</text>
      </view>
      <view class="course-info">
        <view class="info-item">
          <text class="label">学员</text>
          <text class="value">{{training.childName}}</text>
        </view>
        <view class="info-item">
          <text class="label">训练类型</text>
          <text class="value">{{training.type}}</text>
        </view>
        <view class="info-item">
          <text class="label">剩余课时</text>
          <text class="value highlight">{{childInfo.remainingHours || 0}} 课时</text>
        </view>
      </view>
    </view>

    <!-- 训练项目打卡：勾选即写库，退出重进状态保留 -->
    <view class="section" wx:if="{{items.length}}">
      <view class="items-head">
        <view class="section-title">训练项目</view>
        <text class="items-progress">已完成 {{doneCount}}/{{items.length}}</text>
      </view>
      <view class="check-list">
        <view class="check-item" wx:for="{{items}}" wx:key="index">
          <view class="check-row" bind:tap="onToggleItem" data-index="{{index}}">
            <view class="check-circle {{item.done ? 'done' : ''}}">{{item.done ? '✓' : ''}}</view>
            <text class="check-name {{item.done ? 'done' : ''}}">{{item.name}}</text>
            <text class="check-amount" wx:if="{{item.amount}}">{{item.amount}}</text>
          </view>
          <!-- 勾完展开：本次表现（选填文字），展示到家长端/教练端成长页的训练项目层 -->
          <view class="perf-box" wx:if="{{item.done}}">
            <input class="perf-input" placeholder="本次表现(选填)，如：1分钟跳了160下" maxlength="60"
                   value="{{item.performance}}" data-index="{{index}}"
                   bindinput="onPerfInput" bindblur="onPerfBlur"/>
          </view>
        </view>
      </view>
    </view>

    <!-- 精彩瞬间：上课中拍照/录视频，选完自动上传，课后写反馈时直接引用 -->
    <view class="section">
      <view class="section-title">精彩照片 <text class="media-hint">最多{{photoCap}}张，选完自动上传</text></view>
      <view class="photo-grid">
        <view class="photo-cell" wx:for="{{photos}}" wx:key="*this">
          <image class="photo-img" src="{{item}}" mode="aspectFill" data-index="{{index}}" bind:tap="previewPhoto"></image>
          <view class="photo-del" data-index="{{index}}" catch:tap="removePhoto">×</view>
        </view>
        <view class="photo-add" wx:if="{{photos.length < photoCap}}" bind:tap="addPhoto">
          <text class="add-icon">＋</text>
          <text class="add-label">照片</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">精彩视频 <text class="media-hint">最多{{videoCap}}个，选完自动上传</text></view>
      <view class="photo-grid">
        <view class="photo-cell" wx:for="{{videos}}" wx:key="*this">
          <view class="video-thumb" data-index="{{index}}" bind:tap="previewVideo">
            <text class="video-play">▶</text>
          </view>
          <view class="photo-del" data-index="{{index}}" catch:tap="removeVideo">×</view>
        </view>
        <view class="photo-add" wx:if="{{videos.length < videoCap}}" bind:tap="addVideo">
          <text class="add-icon">＋</text>
          <text class="add-label">视频</text>
        </view>
      </view>
    </view>

    <!-- 本次训练内容：教练在 trainings/edit 页填写，上课时给教练自己看（有项目清单时不重复展示） -->
    <view class="section" wx:if="{{!items.length && training.coachContent}}">
      <view class="section-title">本次训练内容</view>
      <view class="section-content">{{training.coachContent}}</view>
    </view>

    <view class="section">
      <view class="section-title">训练重点</view>
      <view class="section-content">{{training.focus}}</view>
    </view>

    <view class="section">
      <view class="section-title">训练难点</view>
      <view class="section-content">{{training.difficulty}}</view>
    </view>

    <!-- 下课按钮 -->
    <view class="bottom-area">
      <view class="finish-btn" bind:tap="onFinishClass">
        <text>下课</text>
      </view>
    </view>
  </view>

  <!-- 确认扣除课时弹窗 -->
  <view class="modal-overlay" wx:if="{{showConfirmModal}}" bind:tap="closeModal">
    <view class="modal-content" catch:tap>
      <view class="modal-header">
        <text>确认下课</text>
      </view>
      <view class="modal-body">
        <view class="deduct-info">
          <text class="deduct-label">确认下课？</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bind:tap="closeModal">取消</view>
        <view class="btn-confirm" bind:tap="confirmDeductHours">下课</view>
      </view>
    </view>
  </view>
</view>