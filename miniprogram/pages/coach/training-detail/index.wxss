/* pages/coach/training-detail/index.wxss */

/* ==================== 全局变量（iOS 化） ==================== */
page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;
}

.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* ==================== 顶部信息卡 ==================== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.course-name {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: #000000;
  padding-right: 24rpx;
}

.course-status {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: rgba(60, 60, 67, 0.6);
}

/* 状态语义色 */
.course-status.status-pending {
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
}

.course-status.status-in_class {
  background: rgba(255, 149, 0, 0.16);
  color: #ff9500;
}

.course-status.status-finished {
  background: rgba(52, 199, 89, 0.16);
  color: #34c759;
}

/* 预约审批建的课是 scheduled——此前只有「已排课」文案没有配色，一直显示灰底 */
.course-status.status-scheduled {
  background: rgba(175, 82, 222, 0.12);
  color: #af52de;
}

/* ==================== 白色分组卡 ==================== */
.card {
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}

.value {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
}

/* ==================== 照片 / 视频 ==================== */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f2f7;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.empty-photos {
  text-align: center;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
  padding: 40rpx 0;
}

.video-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.video-item {
  width: 100%;
  aspect-ratio: 4/3;
  border-radius: 12rpx;
  overflow: hidden;
  background: #000;
}

.video-item video {
  width: 100%;
  height: 100%;
}

.empty-videos {
  text-align: center;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
  padding: 40rpx 0;
}

/* ==================== 改课记录 ==================== */
.log-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}

.log-item:last-child { padding-bottom: 0; border-bottom: none; }

.log-line1 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.log-action {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF9500;
}

.log-by {
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.6);
}

.log-time {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
}

.log-detail {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(60, 60, 67, 0.6);
}
