/* pages/coach/trainings/edit/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 32rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  width: 100%;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.picker, input {
  background-color: #f8f9fc;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

input {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0rpx 24rpx;
}

/* 孩子信息 */
.child-info {
  display: flex;
  align-items: center;
  background-color: #f8f9fc;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.child-info .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #e0e0e0;
}

.child-info .name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.child-info .hint {
  font-size: 24rpx;
  color: #999;
}

/* 照片上传区域 */
.photo-upload-area {
  background-color: #f8f9fc;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.upload-icon {
  font-size: 60rpx;
  color: #999;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.photo-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f0f0f0;
}

.photo-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.hint {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 12rpx;
}

/* 提交按钮 */
.submit-btn {
  background-color: #07c160;
  color: #fff;
  border-radius: 44rpx;
  height: 88rpx;
  font-size: 32rpx;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background-color: #ccc;
}