/* pages/coach/trainings/edit/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.form-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.picker,
input {
  background-color: #f2f2f7;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000;
  box-sizing: border-box;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}

input {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}

/* 孩子信息 */
.child-info {
  display: flex;
  align-items: center;
  background-color: #f2f2f7;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.child-info .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #ececf0;
}

.child-info .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  display: block;
  margin-bottom: 6rpx;
}

.child-info .hint {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 照片上传区域 */
.photo-upload-area {
  background-color: #f2f2f7;
  border: 1rpx dashed rgba(60, 60, 67, 0.2);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.upload-icon {
  font-size: 60rpx;
  color: #007aff;
  line-height: 1;
}

.upload-text {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  margin-top: 12rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.photo-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #f2f2f7;
}

.photo-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.hint {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  display: block;
  margin-top: 12rpx;
}

/* 提交按钮 → iOS 系统蓝 */
.submit-btn {
  background-color: #007aff;
  color: #fff;
  border-radius: 24rpx;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  background-color: #0056cf;
  opacity: 0.85;
}

.submit-btn[disabled] {
  background-color: #e5e5ea;
  color: rgba(60, 60, 67, 0.3);
}

/* 训练项目构建器 */
.label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.label-row .label {
  margin-bottom: 0;
}

.label-hint {
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
}

.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.item-row .item-input {
  flex: 1;
  min-width: 0;
}

.item-del {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.4);
  flex-shrink: 0;
}

.item-add {
  margin-top: 8rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(0, 122, 255, 0.4);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #007aff;
}

.item-add:active {
  background: rgba(0, 122, 255, 0.06);
}

/* 项目行：名称输入容器（纵向 flex，历史结构保留） */
.item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 名称行不再需要 flex:1（改在 item-main 内纵向排布） */
.item-main .item-input {
  flex: none;
  width: 100%;
}

/* 常用项目点选条：该学员近期用过的项目，点一下填入，避免重复手打名字 */
.item-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chips-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.4);
}

.chip {
  font-size: 22rpx;
  line-height: 1;
  color: #1a1a2e;
  background: rgba(60, 60, 67, 0.06);
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
}

.chip-hover {
  background: rgba(60, 60, 67, 0.12);
}

/* 管理员调度：课时余额不足提示 */
.balance-warn {
  color: #FA5151;
  font-weight: 500;
}

