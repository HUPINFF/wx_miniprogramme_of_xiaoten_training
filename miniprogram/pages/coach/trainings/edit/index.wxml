<view class="container">

  <nav-bar title="添加训练"></nav-bar>
  <view class="form-card">
    <!-- 选择学员 -->
    <view class="form-item" wx:if="{{!childId}}">
      <text class="label">选择学员</text>
      <picker mode="selector" range="{{children}}" range-key="name" bindchange="onChildChange">
        <view class="picker">{{selectedChild.name || '请选择学员'}}</view>
      </picker>
    </view>

    <!-- 任课教练（仅管理员显示）：排课调度中心把课派给哪位教练 -->
    <view class="form-item" wx:if="{{isAdmin}}">
      <text class="label">任课教练</text>
      <picker mode="selector" range="{{coachNames}}" bindchange="onCoachChange">
        <view class="picker">{{coachIndex >= 0 ? coachNames[coachIndex] : (coachInfo.name || '请选择教练')}}</view>
      </picker>
    </view>

    <!-- 显示学员信息 -->
    <view class="child-info" wx:if="{{childName}}">
      <image class="avatar" src="cloud://hupin255-5gfbw856b1c861ef.6875-hupin255-5gfbw856b1c861ef-1410552194/default_avatar/6756593ba0eb6a537f7060da8ede3ca8.jpeg" mode="aspectFill"></image>
      <view class="info">
        <text class="name">{{childName}}</text>
        <text class="hint {{balanceLow ? 'balance-warn' : ''}}" wx:if="{{balanceText}}">{{balanceText}}</text>
        <text class="hint">正在为TA添加训练记录</text>
      </view>
    </view>

    <!-- 训练日期 -->
    <view class="form-item">
      <text class="label">训练日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange"> 
        <view class="picker">{{date || '请选择日期'}}</view>
      </picker>
    </view>

    <!-- 【新增】训练时间 -->
    <view class="form-item">
      <text class="label">训练时间</text>
      <picker mode="time" value="{{startTime}}" bindchange="onTimeChange">
        <view class="picker">{{startTime || '请选择时间'}}</view>
      </picker>
    </view>

     <!-- 训练时长 -->
     <view class="form-item">
      <text class="label">训练时长</text>
      <picker mode="selector" range="{{durationList}}" bindchange="onDurationChange">
        <view class="picker">{{duration || '请选择时长'}}</view>
      </picker>
       <!-- 【新增】课时提示 -->
       <!-- <text class="hint" wx:if="{{duration}}">约 {{duration}}，扣减 {{trainingHoursDisplay}} 课时</text> -->
    </view>

    <!-- 训练项目：一行一个，上课时在 in-class 页逐项打卡 -->
    <view class="form-item">
      <view class="label-row">
        <text class="label">训练项目</text>
        <text class="label-hint">上课时逐项打卡</text>
      </view>
      <!-- 常用项目点选：该学员近期用过的项目名，点一下填入空行——从源头少打字，
           写法保持一致，保存前的 AI 归一调用也跟着变少 -->
      <view class="item-chips" wx:if="{{recentItems.length}}">
        <text class="chips-label">常用</text>
        <view class="chip" wx:for="{{recentItems}}" wx:key="*this"
              hover-class="chip-hover" bind:tap="onRecentItemTap" data-name="{{item}}">{{item}}</view>
      </view>
      <view class="item-row" wx:for="{{itemDrafts}}" wx:key="index">
        <view class="item-main">
          <input class="item-input" placeholder="项目名称，如：绳梯步法" maxlength="20"
                 value="{{item.name}}" data-index="{{index}}" bindinput="onItemInput"/>
        </view>
        <view class="item-del" catch:tap="onRemoveItem" data-index="{{index}}">✕</view>
      </view>
      <view class="item-add" bind:tap="onAddItem">＋ 添加项目</view>
    </view>

    <!-- 训练重点 -->
    <view class="form-item">
      <text class="label">训练重点</text> 
      <input 
        placeholder="例如：起跑反应速度" 
        value="{{focus}}" 
        bindinput="onFocusInput"
      />
    </view> 

    <!-- 训练难点 -->
    <view class="form-item">
      <text class="label">训练难点</text>
      <input 
        placeholder="例如：保持低重心" 
        value="{{difficulty}}" 
        bindinput="onDifficultyInput"
      />
    </view>

    <!-- 上课地点 -->
    <view class="form-item">
      <text class="label">上课地点</text>
      <input
        placeholder="例如：天津师范大学体育馆"
        value="{{location}}"
        bindinput="onLocationInput"
      />
    </view>

    <!-- 上传照片 -->
    <view class="form-item">
      <text class="label">上课照片</text>
      <view class="photo-upload-area" bind:tap="uploadPhotos">
        <view class="upload-icon">+</view>
        <text class="upload-text">上传照片</text>
      </view>

      <view class="photo-list" wx:if="{{photoUrls.length > 0}}">
        <view class="photo-item" wx:for="{{photoUrls}}" wx:key="index">
            <image src="{{item}}" mode="aspectFill"></image>
            <view class="photo-delete" catch:tap="deletePhoto" data-index="{{index}}">✕</view>
        </view>
      </view>

      <text class="hint">支持jpg/png格式，最多9张</text>
    </view>

    <button class="submit-btn" type="primary" bind:tap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">保存训练记录</button>
  </view>
</view>