/* pages/coach/trainings/list/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
  padding: 8rpx 0 40rpx;
}

/* 筛选栏：iOS 分段控件 */
.filter-bar {
  width: calc(100% - 48rpx);
  margin: 16rpx auto 8rpx;
  display: flex;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 999rpx;
  padding: 6rpx;
  position: sticky;
  top: 8rpx;
  z-index: 10;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  border-radius: 999rpx;
  transition: all 0.2s;
  font-weight: 500;
}

.filter-item.active {
  color: #ffffff;
  font-weight: 600;
  background: #007aff;
}

.filter-item.active::after {
  display: none;
}

/* 训练卡片 */
.training-list {
  width: calc(100% - 48rpx);
  margin: 0 auto;
  padding: 12rpx 0;
}

.training-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: transform 0.2s;
}

.training-card:active {
  transform: scale(0.98);
}

/* 卡片头部 */
.training-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.training-header .date {
  font-size: 30rpx;
  font-weight: 700;
  color: #000;
}

.training-header .day {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

.type-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  background-color: #f2f2f7;
  color: rgba(60, 60, 67, 0.6);
  margin-bottom: 20rpx;
}

.type-tag.speed {
  background-color: rgba(0, 122, 255, 0.1);
  color: #007aff;
}

.type-tag.endurance {
  background-color: rgba(52, 199, 89, 0.14);
  color: #34c759;
}

.type-tag.coordination {
  background-color: rgba(255, 149, 0, 0.14);
  color: #ff9500;
}

/* 训练内容 */
.training-body {
  margin-bottom: 20rpx;
}

.training-body .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  display: block;
  margin-bottom: 16rpx;
}

.focus-info,
.difficulty-info {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.focus-info .label,
.difficulty-info .label {
  width: 140rpx;
  color: rgba(60, 60, 67, 0.34);
  flex-shrink: 0;
}

.focus-info .content,
.difficulty-info .content {
  flex: 1;
  color: rgba(60, 60, 67, 0.6);
}

/* 卡片底部 */
.training-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.coach-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.coach-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: #f2f2f7;
}

.coach-name {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

.photo-info {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.photo-icon {
  font-size: 26rpx;
}

.photo-count {
  font-size: 24rpx;
  color: #007aff;
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

/* 加载 HUD */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(28, 28, 30, 0.88);
  padding: 40rpx;
  border-radius: 24rpx;
  color: #fff;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.25);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
