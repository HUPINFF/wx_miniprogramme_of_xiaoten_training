<view class="container">
  <nav-bar title='训练列表'></nav-bar>
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{filterType === 'all' ? 'active':''}}" bind:tap="onFilterChange" data-type="all">
      全部
    </view>

    <view class="filter-item {{filterType ==='speed' ? 'active':''}}" bind:tap="onFilterChange" data-type="speed">
      速度训练
    </view>

    <view class="filter-item {{filterType === 'endurance' ? 'active':''}}" bind:tap="onFilterChange" data-type="endurance">
      耐力训练
    </view>

    <view class="filter-item {{filterType === 'coordination' ? 'active':''}}" bind:tap="onFilterChange" data-type="coordination">
      协调训练
    </view>
  </view>

  <!-- 训练列表 -->
  <view class="training-list">
    <block wx:for="{{trainingList}}" wx:key="_id"> 
      <view class="training-card" bind:tap="viewTrainingDetail" data-id="{{item._id}}">
        <!-- 日期和类型 -->
          <view class="training-header">
            <text class="date">{{item.date}}</text>
            <text class="day">{{item.day}}</text>
          </view>

          <view class="type-tag {{item.typeClass}}">{{item.type}}</view>
      

       <!-- 训练内容 -->
        <view class="training-body">
          <text class="name">{{item.name}}</text>
          <view class="focus-info">
            <text class="label">训练重点:</text>
            <text class="content">{{item.focus}}</text>
          </view>

          <view class="difficulty-info">
            <text class="label">训练难点</text>
            <text class="content">{{item.difficulty}}</text>
          </view>
        </view>

        <!-- 底部信息 -->
        <view class="training-footer">
          <view class="coach-info">
            <!-- <image class="coach-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image> -->
            <text class="coach-name">{{item.coachName}}教练</text>
          </view>

          <view class="photo-info" wx:if="{{item.photoCount > 0}}">
            <text class="photo-icon">📸</text>
            <text class="photo-count">{{item.photoCount}}张照片</text>
          </view>
        </view>
      </view> 
    </block>

    <!-- 空状态 -->
    <view wx:if="{{trainingList.length === 0 && !loading}}" class="empty">
      <text class="暂无训练记录"></text>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{hasMore && trainingList.length > 0}}" class="load-more" bind:tap="loadMore">
      <text wx:if="{{!loadingMore}}">加载更多</text>
      <text wx:else>加载中...</text>
    </view>

    <view wx:if="{{!hasMore && trainingList.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>