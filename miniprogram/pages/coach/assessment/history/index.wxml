<!--pages/coach/assessment/history/index.wxml 体质测评历史：首页同款渐变头部 + 白卡记录流-->
<view class="container">
  <view class="gradient-bg"></view>

  <!-- 顶部标题区：白字标题 + 副标题胶囊（孩子名）+ 返回按钮，压在渐变上 -->
  <view class="header-area">
    <view class="back-btn" hover-class="back-btn-active" bind:tap="goBack">‹</view>
    <text class="header-title">体质测评</text>
    <text class="header-sub" wx:if="{{childName}}">{{childName}} · 历次体测报告</text>
  </view>

  <!-- 内容层（z-index:1，卡片压在渐变上） -->
  <view class="page-content">
    <view class="assessment-list">
      <block wx:for="{{assessmentList}}" wx:key="_id">
        <view class="assessment-card fade-in">
          <view class="card-header">
            <view class="month-wrap">
              <view class="month-accent"></view>
              <text class="month">{{item.year}}年{{item.month}}月</text>
            </view>
            <text class="rating {{item.overallRating === '优秀' ? 'excellent' : (item.overallRating === '良好' ? 'good' : (item.overallRating === '一般' ? 'normal' : 'poor'))}}">
              {{item.overallRating}}
            </text>
          </view>

          <!-- 基础信息 -->
          <view class="section">
            <view class="section-title"><view class="title-dot"></view><text>基础信息</text></view>
            <view class="info-grid">
              <text class="info-item">身高：{{item.basicInfo.height ? item.basicInfo.height + 'cm' : '未测'}}</text>
              <text class="info-item">体重：{{item.basicInfo.weight ? item.basicInfo.weight + 'kg' : '未测'}}</text>
              <text class="info-item">BMI：{{item.basicInfo.bmi || '未测'}}</text>
            </view>
          </view>

          <!-- 核心力量 -->
          <view class="section">
            <view class="section-title"><view class="title-dot"></view><text>核心力量</text></view>
            <view class="core-value">{{item.gender === '男' ? '俯卧撑' : '仰卧起坐'}}：{{item.coreStrength.value ? item.coreStrength.value + ' 次/分钟' : '未测'}}</view>
          </view>

          <!-- 基础身体素质 -->
          <view class="section">
            <view class="section-title"><view class="title-dot"></view><text>基础身体素质</text></view>
            <view class="fitness-grid">
              <view class="fitness-item">
                <text class="fi-label">坐位体前屈</text>
                <text class="fi-value {{item.physicalFitness.sitAndReach ? '' : 'empty'}}">{{item.physicalFitness.sitAndReach ? item.physicalFitness.sitAndReach + 'cm' : '未测'}}</text>
              </view>
              <view class="fitness-item">
                <text class="fi-label">立定跳远</text>
                <text class="fi-value {{item.physicalFitness.standingLongJump ? '' : 'empty'}}">{{item.physicalFitness.standingLongJump ? item.physicalFitness.standingLongJump + 'cm' : '未测'}}</text>
              </view>
              <view class="fitness-item">
                <text class="fi-label">平板支撑</text>
                <text class="fi-value {{item.physicalFitness.plank ? '' : 'empty'}}">{{item.physicalFitness.plank ? item.physicalFitness.plank + '秒' : '未测'}}</text>
              </view>
              <view class="fitness-item">
                <text class="fi-label">靠墙静蹲</text>
                <text class="fi-value {{item.physicalFitness.wallSit ? '' : 'empty'}}">{{item.physicalFitness.wallSit ? item.physicalFitness.wallSit + '秒' : '未测'}}</text>
              </view>
              <view class="fitness-item">
                <text class="fi-label">5米折返跑</text>
                <text class="fi-value {{item.physicalFitness.fiveMeterShuttle ? '' : 'empty'}}">{{item.physicalFitness.fiveMeterShuttle ? item.physicalFitness.fiveMeterShuttle + '秒' : '未测'}}</text>
              </view>
              <view class="fitness-item">
                <text class="fi-label">1分钟跳绳</text>
                <text class="fi-value {{item.physicalFitness.ropeSkipping ? '' : 'empty'}}">{{item.physicalFitness.ropeSkipping ? item.physicalFitness.ropeSkipping + '次' : '未测'}}</text>
              </view>
            </view>
          </view>

          <!-- 专项动作模式 -->
          <view class="section">
            <view class="section-title"><view class="title-dot"></view><text>专项动作模式</text></view>
            <view class="action-grid">
              <view class="action-item">
                <text class="fi-label">跑步动作</text>
                <text class="fi-value {{item.actionPatterns.running ? '' : 'empty'}}">{{item.actionPatterns.running || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">立定跳远动作</text>
                <text class="fi-value {{item.actionPatterns.longJump ? '' : 'empty'}}">{{item.actionPatterns.longJump || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">跳绳动作</text>
                <text class="fi-value {{item.actionPatterns.ropeJumping ? '' : 'empty'}}">{{item.actionPatterns.ropeJumping || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">深蹲测试</text>
                <text class="fi-value {{item.actionPatterns.squat ? '' : 'empty'}}">{{item.actionPatterns.squat || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">跨栏步测试</text>
                <text class="fi-value {{item.actionPatterns.hurdleStep ? '' : 'empty'}}">{{item.actionPatterns.hurdleStep || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">直线弓步测试</text>
                <text class="fi-value {{item.actionPatterns.lunge ? '' : 'empty'}}">{{item.actionPatterns.lunge || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">肩部灵活性</text>
                <text class="fi-value {{item.actionPatterns.shoulderFlexibility ? '' : 'empty'}}">{{item.actionPatterns.shoulderFlexibility || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">主动直腿上抬</text>
                <text class="fi-value {{item.actionPatterns.legRaise ? '' : 'empty'}}">{{item.actionPatterns.legRaise || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">躯干稳定俯卧撑</text>
                <text class="fi-value {{item.actionPatterns.trunkPushup ? '' : 'empty'}}">{{item.actionPatterns.trunkPushup || '未评'}}</text>
              </view>
              <view class="action-item">
                <text class="fi-label">旋转稳定性</text>
                <text class="fi-value {{item.actionPatterns.rotationStability ? '' : 'empty'}}">{{item.actionPatterns.rotationStability || '未评'}}</text>
              </view>
            </view>
          </view>

          <!-- 综合评价 -->
          <view class="section" wx:if="{{item.overallComment}}">
            <view class="section-title"><view class="title-dot"></view><text>综合评价</text></view>
            <text class="comment-text">{{item.overallComment}}</text>
          </view>

          <!-- 测评时间 -->
          <view class="footer-time">
            <text>测评时间：{{item.assessmentDate}}</text>
          </view>
        </view>
      </block>

      <!-- 空状态 -->
      <view wx:if="{{assessmentList.length === 0 && !loading}}" class="empty">
        <text class="empty-icon">📋</text>
        <text class="empty-title">暂无测评记录</text>
        <text class="empty-hint">教练录入体质测评后，这里会按月展示</text>
      </view>
    </view>
  </view>

  <!-- 加载状态-->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
