/* pages/coach/assessment/history/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 孩子信息头部 */
.child-header {
  background: #ffffff;
  margin-bottom: 24rpx;
  padding: 40rpx 30rpx;
  border-radius: 28rpx;
  text-align: center;
}

.child-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #000;
  display: block;
  margin-bottom: 8rpx;
}

.child-tip {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

/* 测评列表 */
.assessment-list {
  padding-bottom: 8rpx;
}

.assessment-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.month {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
}

.rating {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.rating.excellent {
  background-color: rgba(52, 199, 89, 0.14);
  color: #34c759;
}

.rating.good {
  background-color: rgba(0, 122, 255, 0.1);
  color: #007aff;
}

.rating.normal {
  background-color: rgba(255, 149, 0, 0.14);
  color: #ff9500;
}

.rating.poor {
  background-color: rgba(255, 59, 48, 0.12);
  color: #ff3b30;
}

/* 通用区块 */
.section {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.section:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 16rpx;
}

/* 信息网格 */
.info-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.info-item {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  background-color: #f2f2f7;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

/* 核心力量 */
.core-value {
  font-size: 28rpx;
  color: #34c759;
  background-color: rgba(52, 199, 89, 0.14);
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  display: inline-block;
  font-weight: 600;
}

/* 身体素质网格 */
.fitness-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.fitness-item {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  background-color: #f2f2f7;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
}

/* 动作模式网格 */
.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.action-item {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  background-color: #f2f2f7;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
}

/* 综合评价 */
.comment-text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.6;
  display: block;
  background-color: #f2f2f7;
  padding: 20rpx;
  border-radius: 16rpx;
}

/* 底部时间 */
.footer-time {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
  text-align: right;
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.25);
  margin-top: 12rpx;
}

/* 加载 HUD */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(28, 28, 30, 0.88);
  padding: 40rpx;
  border-radius: 24rpx;
  color: #fff;
  z-index: 1000;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.25);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
