/* pages/coach/assessment/edit/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 孩子信息卡片 */
.child-info-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.child-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #f2f2f7;
  flex-shrink: 0;
}

.child-detail {
  flex: 1;
  overflow: hidden;
}

.child-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
  display: block;
  margin-bottom: 8rpx;
}

.child-age {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

.history-btn {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background-color: #f2f2f7;
  border-radius: 20rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.history-btn:active {
  opacity: 0.8;
}

.history-icon {
  font-size: 36rpx;
  line-height: 1;
}

.history-text {
  font-size: 22rpx;
  color: #007aff;
  font-weight: 500;
}

/* 通用区块 */
.section {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #f2f2f7;
  padding: 0 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000;
  box-sizing: border-box;
}

.bmi-tip {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-top: 8rpx;
  display: block;
}

/* 动作选项：分段控件 */
.action-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.action-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.action-label {
  font-size: 28rpx;
  color: #000;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.action-options {
  display: flex;
  background: #f2f2f7;
  border-radius: 999rpx;
  padding: 6rpx;
}

.option {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  font-weight: 500;
  transition: all 0.2s;
}

.option.active {
  background: #007aff;
  color: #fff;
  font-weight: 600;
}

/* 综合评定选项 */
.rating-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rating-option {
  flex: 1;
  min-width: 130rpx;
  text-align: center;
  padding: 20rpx 8rpx;
  background-color: #f2f2f7;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  font-weight: 500;
  transition: all 0.2s;
}

.rating-option.active {
  background: #007aff;
  color: #fff;
  font-weight: 600;
}

/* 文本框 */
.textarea {
  width: 100%;
  background-color: #f2f2f7;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000;
  box-sizing: border-box;
  min-height: 160rpx;
  line-height: 1.5;
}

/* 提交按钮 → iOS 系统蓝 */
.submit-btn {
  background: #007aff;
  color: #fff;
  border-radius: 24rpx;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin: 24rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  width: 100%;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  background-color: #0056cf;
  opacity: 0.85;
}

.submit-btn[disabled] {
  background-color: #e5e5ea;
  color: rgba(60, 60, 67, 0.3);
}
