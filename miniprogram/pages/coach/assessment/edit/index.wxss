/* pages/coach/assessment/edit/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 孩子信息卡片 */
.child-info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #fff;
  position: relative;
}

.history-btn {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  transition: all 0.2s;
}

.history-btn:active {
  background-color: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.history-icon {
  font-size: 36rpx;
}

.history-text {
  font-size: 22rpx;
  opacity: 0.9;
}


.child-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #fff;
}

.child-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.child-age {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 通用区块 */
.section {
  background-color: #fff;
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  background-color: #f8f9fc;
  /* padding: 24rpx; */
  padding: 0 24rpx;
  height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.bmi-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 动作选项 */
.action-item {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.action-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.action-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.action-options {
  display: flex;
  gap: 16rpx;
}

.option {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background-color: #f8f9fc;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}

.option.active {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  color: #fff;
}

/* 综合评定选项 */
.rating-options {
  display: flex;
  gap: 20rpx;
}

.rating-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background-color: #f8f9fc;
  border-radius: 48rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s;
}

.rating-option.active {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  color: #fff;
}

/* 文本框 */
.textarea {
  width: 100%;
  background-color: #f8f9fc;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  min-height: 160rpx;
  line-height: 1.5;
}

/* 提交按钮 */
.submit-btn {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  color: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  font-size: 32rpx;
  margin: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.submit-btn::after {
  border: none;
}