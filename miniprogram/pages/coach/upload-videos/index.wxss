/* pages/coach/upload-videos/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
}

.content {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* 提示信息 */
.tips {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tips-text {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.6;
}

.video-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.video-item {
  width: calc(50% - 10rpx);
  aspect-ratio: 4 / 3;
  position: relative;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.video-item video {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn::before,
.delete-btn::after {
  content: '';
  position: absolute;
  width: 22rpx;
  height: 3rpx;
  background-color: #fff;
  border-radius: 2rpx;
}

.delete-btn::before {
  transform: rotate(45deg);
}

.delete-btn::after {
  transform: rotate(-45deg);
}

.video-duration {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background-color: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 添加按钮 */
.add-btn {
  width: calc(50% - 10rpx);
  aspect-ratio: 4 / 3;
  background-color: #ffffff;
  border: 1rpx dashed rgba(60, 60, 67, 0.25);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.add-btn::before {
  content: '';
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #007aff;
}

.add-btn::after {
  content: '';
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 64rpx;
  border-radius: 3rpx;
  background-color: #007aff;
}

.add-text {
  position: absolute;
  bottom: 32rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(249, 249, 251, 0.92);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(60, 60, 67, 0.12);
}

.save-btn {
  background: #007aff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
}

.save-btn:active {
  background-color: #0056cf;
}

.save-btn.disabled {
  background: #e5e5ea;
  color: rgba(60, 60, 67, 0.3);
}
