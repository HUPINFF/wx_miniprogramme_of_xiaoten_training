.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.content {
  padding: 20rpx;
}

.tips {
  background-color: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #ad8b00;
}

.video-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 200rpx;
}

.video-item {
  width: calc(50% - 8rpx);
  aspect-ratio: 4/3;
  position: relative;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.video-item video {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn::before,
.delete-btn::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 2rpx;
  background-color: #fff;
}

.delete-btn::before {
  transform: rotate(45deg);
}

.delete-btn::after {
  transform: rotate(-45deg);
}

.video-duration {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
}

.add-btn {
  width: calc(50% - 8rpx);
  aspect-ratio: 4/3;
  background-color: #fff;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative
}

.add-btn::before {
  content: '';
  width: 60rpx;
  height: 7rpx;
  /* border: 3rpx solid #07c160; */
  border-radius: 20%;
  transform: rotate(-90deg);
  background-color: #07c160;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -80%) rotate(180deg);  /* 向上偏移一点 */
}

.add-btn::after {
  content: '';
  position: absolute;
  border-radius: 20%;
  width: 60rpx;
  height: 7rpx;
  /* transform:translateY(-22rpx) rotate(180deg); */
  background-color: #07c160;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -80%) rotate(-90deg);  /* 和外圈对齐 */
}

