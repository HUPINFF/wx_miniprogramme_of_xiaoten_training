.add-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 100rpx;
}

.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 1rpx solid #eee;
}

.save-btn {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
}

.save-btn.disabled {
  background: #ccc;
}
