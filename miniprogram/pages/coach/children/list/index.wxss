/* pages/coach/children/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 添加按钮 */
.add-btn {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  margin: 20rpx auto;
  padding: 24rpx;
  border-radius: 48rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.add-icon {
  font-size: 40rpx;
  font-weight: bold;
}

.add-text {
  font-size: 32rpx;
  font-weight: 500;
}

/* 搜索栏 */
.header {
  width: 85%;
  background-color: #fff;
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header input {
  font-size: 28rpx;
  color: #333;
}

/* 学员列表 */
.child-list {
  width: 95%;
  padding: 0 20rpx;
}

.child-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.child-item:active {
  transform: scale(0.98);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #f0f0f0;
}

.info {
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.age {
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #ccc;
  margin-top: 12rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10px);  
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 85%;
  background-color: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  margin-left: 25rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.modal-close {
  font-size: 44rpx;
  color: #fff;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #ffffff;
  display: block;
  margin-bottom: 12rpx;
  margin-left: 25rpx;
  font-weight: 500;
}

.required {
  color: #ff6b6b;
  margin-left: 4rpx;
}

.input {
  width: 90%;
  background-color: #f8f9fc;
  height: 80rpx;
  /* padding: 24rpx; */
  padding-left:24rpx ;
  margin: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.hint {
  font-size: 24rpx;
  color: #ffffff;
  margin-top: 12rpx;
  margin-left: 25rpx;
  display: block;
}

/* 学员预览 */
.child-preview {
  background-color: #e8f5e8;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.preview-title {
  font-size: 26rpx;
  color: #07c160;
  display: block;
  margin-bottom: 12rpx;
}

.preview-info {
  display: flex;
  gap: 20rpx;
  align-items: baseline;
}

.preview-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.preview-age, .preview-gender {
  font-size: 26rpx;
  color: #666;
}

/* 错误提示 */
.error-tip {
  background-color: #ffe0e0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  text-align: center;
  color: #ff6b6b;
  font-size: 26rpx;
}

.modal-tip text {
  color: red;
  margin-left: 25rpx;
  font-weight: bold;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.cancel-btn {
  background-color: #f8f9fc;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  color: #fff;
}

.confirm-btn[disabled] {
  background: #ccc;
  opacity: 0.6;
}