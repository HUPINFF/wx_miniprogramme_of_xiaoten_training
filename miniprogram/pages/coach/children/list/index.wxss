/* pages/coach/children/list/index.wxss —— 学员管理列表（iOS 质感 + 品牌绿） */
.container {
  /* 页面级设计令牌：全站同一套品牌绿 + 中性灰阶 */
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;

  min-height: 100vh;
  background: #f6f8f7;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 渐变背景层：与工作台/学员详情同款（绿→淡绿→透明） ===== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 460rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 30%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
  pointer-events: none;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, #f6f8f7 100%);
}

/* ===== 顶部标题区：白字标题 + 副标题胶囊 + 返回按钮（与学员详情同款） ===== */
.header-area {
  position: relative;
  z-index: 1;
  padding: 92rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.header-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(10rpx);
}

/* 返回键：白透圆钮浮在标题行左侧 */
.back-btn {
  position: absolute;
  left: 30rpx;
  top: 96rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 40rpx;
  line-height: 60rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.back-btn-active {
  background: rgba(255, 255, 255, 0.32);
}

/* ===== 内容层：压在渐变之上 ===== */
.page-content {
  position: relative;
  z-index: 1;
}

/* ===== 搜索栏 ===== */
.search-wrap {
  padding: 20rpx 30rpx 8rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #fff;
  border-radius: 44rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 42, 26, 0.05);
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.search-placeholder {
  color: var(--text-hint);
}

/* ===== 学员列表 ===== */
.child-list {
  padding: 12rpx 30rpx 0;
}

.child-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 42, 26, 0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.child-card-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(26, 42, 26, 0.05);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #f0f2f1;
  border: 4rpx solid var(--primary-light);
  box-sizing: border-box;
}

.child-info {
  flex: 1;
  min-width: 0;
}

.child-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 10rpx;
}

.child-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-age {
  font-size: 24rpx;
  color: var(--text-sub);
}

.meta-dot {
  font-size: 24rpx;
  color: #d1d5db;
}

/* 性别小签：男孩蓝 / 女孩粉，一眼可辨 */
.meta-gender {
  font-size: 22rpx;
  line-height: 1;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.meta-gender.boy {
  color: #3b82f6;
  background: #e8f1fd;
}

.meta-gender.girl {
  color: #ec4899;
  background: #fdeef2;
}

.child-arrow {
  font-size: 44rpx;
  line-height: 1;
  color: #c8cdd4;
  margin-left: 16rpx;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  text-align: center;
  font-size: 60rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: var(--primary-light);
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
}

/* ===== 底部操作区：快捷入口卡（与成长页 quick-nav 同一家族） ===== */
.action-cards {
  padding: 24rpx 30rpx 0;
}

.action-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 42, 26, 0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.action-card-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(26, 42, 26, 0.05);
}

/* 图标气泡：squircle 圆角方，绿/蓝两色区分动作 */
.action-bubble {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.bubble-green {
  background: var(--primary-light);
}

.bubble-blue {
  background: #e8f1fd;
}

.bubble-icon {
  font-size: 38rpx;
  line-height: 1;
}

.bubble-green .bubble-icon {
  color: var(--primary-dark);
}

.bubble-blue .bubble-icon {
  color: #3b82f6;
}

.action-main {
  flex: 1;
  min-width: 0;
}

.action-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.action-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.action-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #c8cdd4;
  margin-left: 16rpx;
}

/* ===== 关联学员弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 20, 0.45);
  backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 86%;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f4f6;
}

.modal-close text {
  font-size: 26rpx;
  color: var(--text-hint);
  line-height: 1;
}

.modal-body {
  padding: 8rpx 32rpx 16rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: var(--text-sub);
  display: block;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.required {
  color: #e5484d;
  margin-left: 4rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f7f6;
  border-radius: 18rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--text-hint);
}

.hint {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
  display: block;
}

/* 学员预览：查到孩子后的绿色确认卡 */
.child-preview {
  background: var(--primary-light);
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  margin-top: 8rpx;
}

.preview-title {
  font-size: 22rpx;
  color: var(--primary-dark);
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.preview-info {
  display: flex;
  gap: 16rpx;
  align-items: baseline;
}

.preview-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.preview-meta {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 错误提示 */
.modal-tip {
  background: #fdecec;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  text-align: center;
}

.modal-tip text {
  color: #e5484d;
  font-size: 26rpx;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  padding: 0;
}

.cancel-btn::after,
.confirm-btn::after {
  border: none;
}

.cancel-btn {
  background: #f3f4f6;
  color: var(--text-sub);
}

.confirm-btn {
  background: linear-gradient(135deg, #07c160 0%, #05a350 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.25);
}

.confirm-btn[disabled] {
  background: #d8dcd9;
  color: #fff;
  opacity: 0.7;
}

/* ===== 骨架屏 ===== */
.skeleton-list {
  padding: 12rpx 30rpx 0;
}

.skeleton-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}

.skeleton-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f3f5;
  margin-right: 24rpx;
}

.skeleton-info {
  flex: 1;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  margin-bottom: 14rpx;
}

.skeleton-line-name {
  width: 220rpx;
  height: 30rpx;
}

.skeleton-line-meta {
  width: 300rpx;
  margin-bottom: 0;
}

.skeleton-shimmer {
  position: relative;
  overflow: hidden;
}

.skeleton-shimmer::after {
  content: '';
  position: absolute;
  top: 0;
  left: -150%;
  width: 80%;
  height: 100%;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0),
    rgba(255, 255, 255, 0.6),
    rgba(255, 255, 255, 0)
  );
  animation: skeleton-shimmer 1.3s infinite;
}

@keyframes skeleton-shimmer {
  0% { left: -150%; }
  100% { left: 150%; }
}
