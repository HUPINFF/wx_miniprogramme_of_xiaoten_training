/* pages/coach/children/detail/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 24rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #07c160;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 学员信息卡片 */
.child-header {
  width: 90%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  color: #fff;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background-color: #fff;
}

.child-basic .name {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.child-basic .info {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
  margin-top: 6rpx;
}

/* 快捷操作按钮 */
.quick-actions {
  width: 95%;
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
}

.action-btn .icon {
  font-size: 48rpx;
}

.action-btn text:last-child {
  font-size: 26rpx;
  color: #666;
}

.action-btn:active {
  background-color: #f5f7fa;
  border-radius: 16rpx;
}

/* 通用区块 */
.section {
  width: 90%;
  background-color: #fff;
  border-radius: 24rpx;
  margin: 0 auto;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-date {
  font-size: 24rpx;
  color: #999;
}

.section-more {
  font-size: 26rpx;
  color: #07c160;
}

/* 表现网格 */
.performance-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.performance-item {
  background-color: #f8f9fc;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.performance-item .label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.performance-item .value {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

/* 表现历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background-color: #f8f9fc;
  border-radius: 16rpx;
}

.history-item .date {
  font-size: 28rpx;
  font-weight: 500;
  color: #07c160;
  width: 180rpx;
}

.history-item .scores {
  flex: 1;
  display: flex;
  gap: 24rpx;
}

.history-item .score {
  font-size: 26rpx;
  color: #666;
}

.history-item .arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 训练列表 */
.training-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.training-item {
  background-color: #f8f9fc;
  border-radius: 16rpx;
  padding: 20rpx;
}

.training-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.training-header .date {
  font-size: 28rpx;
  font-weight: 500;
  color: #07c160;
}

.training-header .type {
  font-size: 24rpx;
  color: #fff;
  background-color: #07c160;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.training-item .name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.training-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.training-footer .focus {
  font-size: 26rpx;
  color: #999;
}

.training-footer .photo-count {
  font-size: 24rpx;
  color: #07c160;
}

/* 反馈列表 */
.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feedback-item {
  background-color: #f8f9fc;
  border-radius: 16rpx;
  padding: 20rpx;
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.feedback-header .date {
  font-size: 26rpx;
  font-weight: 500;
  color: #07c160;
}

.feedback-header .week {
  font-size: 24rpx;
  color: #999;
}

.feedback-item .content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}


/* 学时信息 */
.class-hours {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hours-label {
  font-size: 26rpx;
  opacity: 0.9;
  color: rgba(255, 255, 255, 0.9);
}

.hours-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffd700;
}

.hours-value.warning {
  color: #ff6b6b;
}


/* 编辑学时按钮 - 完整美化版 */
.edit-hours-btn {
  margin-top: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  border-radius: 48rpx;
  padding: 14rpx 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.35);
  transition: all 0.25s ease;
  width: fit-content;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.edit-hours-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.3);
}

.edit-icon {
  font-size: 30rpx;
  color: #fff;
}

.edit-hours-btn text:last-child {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  letter-spacing: 1rpx;
}