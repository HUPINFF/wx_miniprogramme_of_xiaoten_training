/* pages/coach/profile/index.wxss — 我的：品牌绿渐变头部 + 白卡菜单
   与工作台/经营驾驶舱/今日课同一设计语言（渐变 hero、绿系变量、软阴影白卡） */

page {
  --bg: #f5f7fa;
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --card: #ffffff;
  --text-main: #1a2a1a;
  --text-sub: #5f6f65;
  --text-hint: #9aa8a0;
  --border: rgba(26, 42, 26, 0.08);
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;
  --card-shadow: 0 4rpx 20rpx rgba(26, 42, 26, 0.06);
}

/* ==================== 页面容器 ==================== */
/* 底部 tab = 112rpx + 安全区，再留 28rpx 呼吸位 */
.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding: 0 0 calc(140rpx + env(safe-area-inset-bottom));
  position: relative;
}

/* ==================== 渐变背景层 ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 30%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
  pointer-events: none;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  padding: 100rpx 40rpx 60rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 400;
  letter-spacing: 1rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* ==================== 主体 ==================== */
.page-body {
  position: relative;
  z-index: 1;
}

/* ==================== 菜单分组 ==================== */
.menu-group {
  margin: 0 30rpx 28rpx;
}

.group-title {
  display: flex;
  align-items: center;
  margin: 0 0 14rpx 4rpx;
}

.title-accent {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--primary) 0%, #00d68f 100%);
  margin-right: 12rpx;
}

.group-title text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.menu-card {
  background: var(--card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--card-shadow);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
  transition: background-color 0.15s ease;
}

.menu-item:last-child { border-bottom: none; }

.menu-item:active { background-color: rgba(26, 42, 26, 0.04); }

.menu-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.menu-arrow {
  font-size: 32rpx;
  font-weight: 300;
  color: #c0c8c4;
}

/* ==================== 退出登录 ==================== */
.logout-btn {
  width: calc(100% - 60rpx);
  height: 88rpx;
  margin: 8rpx auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--card);
  color: #fa5151;
  border: 2rpx solid rgba(250, 81, 81, 0.3);
  border-radius: var(--radius-xl);
  box-shadow: var(--card-shadow);
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.logout-btn::after { border: none; }

.logout-btn:active {
  background-color: rgba(250, 81, 81, 0.06);
  transform: scale(0.98);
}
