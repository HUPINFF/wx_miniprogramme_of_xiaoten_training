<!--pages/coach/profile/index.wxml-->
<nav-bar title="我的" showBack="{{false}}"></nav-bar>

<view class="container">
  <!-- 教练资料卡：复用 coach-card，自带姓名/电话/微信/简介/头像的编辑能力 -->
  <coach-card
    coachInfo="{{coachInfo}}"
    editable="{{true}}"
    bind:update="onCoachUpdate"
  />

  <!-- 菜单分组 -->
  <view class="menu-group" wx:for="{{menuGroups}}" wx:key="title" wx:for-item="group">
    <text class="group-title">{{group.title}}</text>
    <view class="menu-card">
      <view
        class="menu-item"
        wx:for="{{group.items}}"
        wx:key="title"
        data-url="{{item.url}}"
        bind:tap="onMenuTap"
      >
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <button class="logout-btn" bind:tap="logout">退出登录</button>

  <coach-tab-bar current="profile" />
</view>
