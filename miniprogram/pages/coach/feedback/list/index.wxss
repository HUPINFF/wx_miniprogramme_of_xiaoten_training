/* pages/coach/feedback/list/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

/* 筛选栏 */
.filter-bar {
  background-color: #fff;
  width: 90%;
  display: flex;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.filter-item.active {
  color: #07c160;
  font-weight: 500;
  position: relative;
}

.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

/* 反馈列表 */
.feedback-list {
  padding: 24rpx;
}

.feedback-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.feedback-card:active {
  transform: scale(0.98);
}

/* 反馈头部 */
.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.child-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.child-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.child-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.child-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.feedback-date {
  font-size: 24rpx;
  color: #999;
}

/* 评分星星 */
.rating {
  display: flex;
  gap: 6rpx;
}

.rating .star {
  font-size: 28rpx;
  color: #e0e0e0;
}

.rating .star.active {
  color: #ffb400;
}

/* 反馈周期 */
.week-range {
  background-color: #f8f9fc;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #07c160;
  margin-bottom: 20rpx;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background-color: #e8f5e8;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #07c160;
}

/* 反馈内容 */
.feedback-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  background-color: #f8f9fc;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

/* 反馈底部 */
.feedback-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.feedback-footer image {
  width: 60rpx;
  height: 60rpx ;
}

.coach-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.coach-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: #f0f0f0;
}

.coach-name {
  font-size: 24rpx;
  color: #999;
}

.edit-btn {
  font-size: 26rpx;
  color: #07c160;
  padding: 8rpx 16rpx;
  background-color: #f0f9f0;
  border-radius: 30rpx;
}

.edit-btn:active {
  background-color: #e0f0e0;
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #999;
}

.load-more {
  color: #07c160;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(0,0,0,0.7);
  padding: 40rpx;
  border-radius: 20rpx;
  color: #fff;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}