/* pages/coach/feedback/list/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
  padding: 8rpx 0 40rpx;
}

/* 筛选栏：iOS 分段控件 */
.filter-bar {
  width: calc(100% - 48rpx);
  margin: 16rpx auto 8rpx;
  display: flex;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 999rpx;
  padding: 6rpx;
  position: sticky;
  top: 8rpx;
  z-index: 10;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  border-radius: 999rpx;
  transition: all 0.2s;
  font-weight: 500;
}

.filter-item.active {
  color: #ffffff;
  font-weight: 600;
  background: #007aff;
}

.filter-item.active::after {
  display: none;
}

/* 反馈列表 */
.feedback-list {
  width: calc(100% - 48rpx);
  margin: 0 auto;
  padding: 12rpx 0;
}

.feedback-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: transform 0.2s;
}

.feedback-card:active {
  transform: scale(0.98);
}

/* 反馈头部 */
.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.child-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.child-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f2f2f7;
}

.child-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.child-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #000;
}

.feedback-date {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 评分星星 */
.rating {
  display: flex;
  gap: 6rpx;
}

.rating .star {
  font-size: 28rpx;
  color: #e5e5ea;
}

.rating .star.active {
  color: #ff9500;
}

/* 反馈周期 */
.week-range {
  background-color: rgba(0, 122, 255, 0.1);
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #007aff;
  margin-bottom: 20rpx;
  font-weight: 500;
}

/* 进步标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 22rpx;
  background-color: rgba(0, 122, 255, 0.1);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #007aff;
  font-weight: 500;
}

/* 反馈内容 */
.feedback-content {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.6;
  background-color: #f2f2f7;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

/* 反馈底部 */
.feedback-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.feedback-footer image {
  width: 60rpx;
  height: 60rpx;
}

.coach-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.coach-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: #f2f2f7;
}

.coach-name {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

.edit-btn {
  font-size: 24rpx;
  color: #007aff;
  padding: 8rpx 24rpx;
  background-color: rgba(0, 122, 255, 0.1);
  border-radius: 999rpx;
  font-weight: 500;
}

.edit-btn:active {
  opacity: 0.8;
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

/* 加载 HUD */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(28, 28, 30, 0.88);
  padding: 40rpx;
  border-radius: 24rpx;
  color: #fff;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.25);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
