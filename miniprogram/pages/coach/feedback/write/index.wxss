/* pages/coach/feedback/write/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.form-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.picker {
  background-color: #f2f2f7;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000;
}

/* 孩子信息 */
.child-info {
  display: flex;
  align-items: center;
  background-color: #f2f2f7;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.child-info .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #ececf0;
}

.child-info .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  display: block;
  margin-bottom: 6rpx;
}

.child-info .hint {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 周期显示 */
.week-range {
  background-color: rgba(0, 122, 255, 0.1);
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #007aff;
  text-align: center;
  font-weight: 600;
}

/* 评分星星 */
.rating {
  display: flex;
  gap: 16rpx;
}

.star {
  font-size: 48rpx;
  color: #e5e5ea;
  transition: color 0.2s;
}

.star.active {
  color: #ff9500;
}

/* 进步标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 14rpx 28rpx;
  background-color: #f2f2f7;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  display: inline-block;
  transition: all 0.2s;
  font-weight: 500;
}

.tag.active {
  background-color: #007aff;
  color: #ffffff;
}

.tag:active {
  opacity: 0.8;
}

/* 本周表现总结 */
.performance-summary {
  background-color: #f2f2f7;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.summary-item {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
}

.summary-item .label {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-bottom: 8rpx;
}

.summary-item .value {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}

.no-data {
  background-color: #f2f2f7;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

/* 文本框 */
textarea {
  background-color: #f2f2f7;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000;
  width: 100%;
  min-height: 300rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

.counter {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-top: 12rpx;
}

/* 提交按钮 → iOS 系统蓝 */
.submit-btn {
  padding: 0;
  background-color: #007aff;
  color: #fff;
  border-radius: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  background-color: #0056cf;
  opacity: 0.85;
}

.submit-btn[disabled] {
  background-color: #e5e5ea;
  color: rgba(60, 60, 67, 0.3);
}
