/* pages/coach/reports/edit/index.wxss — 报告编辑器（iOS 化同色板） */

.page {
  min-height: 100vh;
  background: #f2f2f7;
  padding: 16rpx 24rpx 220rpx;
  box-sizing: border-box;
}

.fail-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 顶部：学员 + 周期选择 */
.head-card {
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.head-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.head-child {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
}

.head-type {
  font-size: 22rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.period-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.period-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

.period-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f7f7fa;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

.period-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #000000;
}

.picker-arrow {
  font-size: 22rpx;
  color: #007aff;
}

/* 积木块卡片 */
.block-card {
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
}

.block-source {
  font-size: 20rpx;
  color: rgba(60, 60, 67, 0.34);
}

.block-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 照片九宫格（编辑态：可删可加）。格宽 200rpx：三列 624rpx
   要塞进卡片内宽 644rpx，208rpx 时 648rpx 放不下会掉到两列 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f2f2f7;
}

.photo-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f7f7fa;
  border: 2rpx dashed rgba(60, 60, 67, 0.2);
  color: rgba(60, 60, 67, 0.34);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.photo-add-icon {
  font-size: 44rpx;
  line-height: 1;
}

.photo-add-txt {
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.5);
}

.photo-add:active {
  background: rgba(0, 122, 255, 0.06);
}

/* 视频证据：照片格下方整宽一条一个 */
.video-list {
  margin-top: 12rpx;
}

.video-cell {
  position: relative;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 12rpx;
  background: #000000;
}

.video-player {
  width: 100%;
  height: 100%;
}

/* 训练照片选择面板（底部弹层） */
.album-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: album-mask-fade 0.18s ease-out;
}

@keyframes album-mask-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.album-panel {
  width: 100%;
  max-height: 78vh;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: album-sheet-up 0.22s cubic-bezier(0.34, 1.3, 0.64, 1);
}

@keyframes album-sheet-up {
  from { transform: translateY(15%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

.album-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.album-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
}

.album-count {
  font-size: 24rpx;
  font-weight: 500;
  color: #007aff;
}

.album-scroll {
  flex: 1;
  min-height: 0;
  max-height: 50vh;
}

.album-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 10rpx;
}

.album-cell {
  position: relative;
  width: 218rpx;
  height: 218rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 4rpx solid transparent;
}

.album-cell.sel {
  border-color: #007aff;
}

.album-img {
  width: 100%;
  height: 100%;
  background: #f2f2f7;
}

.album-check {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #007aff;
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.album-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.34);
}

.album-foot {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.album-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.album-btn.secondary {
  background: #f2f2f7;
  color: #000000;
}

.album-btn.secondary:active {
  background: #e4e4e9;
}

.album-btn.primary {
  background: #007aff;
  color: #ffffff;
  font-weight: 600;
}

.album-btn.primary:active {
  opacity: 0.85;
}

/* 文字编辑块 */
.block-textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f7f7fa;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #000000;
}

.ph {
  color: rgba(60, 60, 67, 0.34);
}

.goal-hint {
  font-size: 24rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 14rpx;
}

.goal-hint:active {
  background: rgba(0, 122, 255, 0.16);
}

/* 标签 / 常用语 */
.tag-row,
.phrase-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag-chip,
.phrase-chip {
  font-size: 24rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.tag-chip.on {
  color: #ffffff;
  background: #007aff;
  font-weight: 500;
}

.tag-chip:active,
.phrase-chip:active {
  opacity: 0.6;
}

/* 预览成品海报 */
.poster {
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.poster-head {
  margin-bottom: 24rpx;
}

.poster-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 10rpx;
}

.poster-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.poster-period {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

.poster-type {
  font-size: 22rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.poster-foot {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  text-align: center;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
  letter-spacing: 2rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.bar-btn.secondary {
  background: #f2f2f7;
  color: #000000;
}

.bar-btn.secondary:active {
  background: #e4e4e9;
}

.bar-btn.primary {
  background: #007aff;
  color: #ffffff;
  font-weight: 600;
}

.bar-btn.primary:active {
  opacity: 0.85;
}

.draft-del {
  text-align: center;
  padding: 10rpx 0 30rpx;
  font-size: 26rpx;
  color: #ff3b30;
}
