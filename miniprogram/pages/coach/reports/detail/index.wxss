/* pages/coach/reports/detail/index.wxss — 成品报告查看页 */

.page {
  min-height: 100vh;
  background: #f2f2f7;
  padding: 16rpx 24rpx 180rpx;
  box-sizing: border-box;
}

/* 海报卡：与编辑器预览同一套头部/底部语言 */
.poster {
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
}

.poster-head {
  margin-bottom: 24rpx;
}

.poster-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 10rpx;
}

.poster-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.poster-period {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

.poster-type,
.poster-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.poster-type {
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
}

.poster-status.published {
  color: #34c759;
  background: rgba(52, 199, 89, 0.12);
}

.poster-status.draft {
  color: rgba(60, 60, 67, 0.6);
  background: rgba(60, 60, 67, 0.08);
}

.poster-foot {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  text-align: center;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
  letter-spacing: 2rpx;
}

/* 草稿操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.bar-btn.secondary {
  background: #f2f2f7;
  color: #ff3b30;
}

.bar-btn.secondary:active {
  background: #e4e4e9;
}

.bar-btn.primary {
  background: #007aff;
  color: #ffffff;
  font-weight: 600;
}

.bar-btn.primary:active {
  opacity: 0.85;
}
