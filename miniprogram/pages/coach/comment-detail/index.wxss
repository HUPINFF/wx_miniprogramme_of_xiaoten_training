/* pages/coach/comment-detail/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.content {
  padding: 24rpx;
}

.section {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

/* 点评信息 */
.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #f2f2f7;
  flex-shrink: 0;
}

.info {
  flex: 1;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #000;
  display: block;
  margin-bottom: 8rpx;
}

.rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.star {
  font-size: 26rpx;
  color: #ff9500;
}

.rating-text {
  font-size: 26rpx;
  color: #ff9500;
  margin-left: 8rpx;
  font-weight: 600;
}

.time {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 24rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.comment-content {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.6;
}

/* 训练信息 */
.training-info {
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}

.value {
  font-size: 28rpx;
  color: #000;
  font-weight: 600;
}

/* 教练反馈 */
.feedback {
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 12rpx;
}

.feedback-content {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.6;
}

/* 媒体区域 */
.media-section {
  margin-top: 24rpx;
}

.media-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 16rpx;
}

.media-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.media-item {
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2f2f7;
}

.media-item image {
  width: 100%;
  height: 100%;
}

.video-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.video-item {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
}

.video-item video {
  width: 100%;
  height: 100%;
}

.no-media {
  text-align: center;
  padding: 40rpx;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

.no-training {
  text-align: center;
  padding: 60rpx;
  background: #ffffff;
  border-radius: 28rpx;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}
