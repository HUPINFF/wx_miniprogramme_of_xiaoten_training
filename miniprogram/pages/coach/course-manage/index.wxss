/* pages/coach/course-manage/index.wxss */

/* ==================== 全局变量（iOS 化） ==================== */
page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --primary-dark: #0056CF;
  --primary-light: rgba(0, 122, 255, 0.1);
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;
}

.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 添加按钮 */
.add-btn {
  width: 50%;
  margin: 40rpx auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  padding: 24rpx;
  border-radius: 48rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.add-icon {
  font-size: 40rpx;
  font-weight: bold;
}

/* 课程列表 */
.course-list {
  width: 90%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.course-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.course-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.course-cover-img {
  width: 100%;
  height: 100%;
}

.course-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e8f5e9;
}

.course-placeholder-text {
  font-size: 48rpx;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.course-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: wrap;
}

.course-sort, .course-hours {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.course-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.edit-btn, .delete-btn {
  background-color: #f8f9fc;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
}

.edit-btn {
  color: #07c160;
  border: 2rpx solid #07c160;
}

.delete-btn {
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 95%;
  max-height: 90vh;
  background-color: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 44rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  width: 100%;
  max-height: 60vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.required {
  color: #ff6b6b;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fc;
  padding-left: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 80rpx;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  background-color: #f8f9fc;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 上传图片区域 */
.upload-area {
  width: 100%;
  background-color: #f8f9fc;
  border-radius: 16rpx;
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 300rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
}

.upload-icon {
  font-size: 60rpx;
  color: #ccc;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 自定义内容编辑器 */
.custom-items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.custom-item-editor {
  background-color: #f8f9fc;
  border-radius: 16rpx;
  padding: 16rpx;
}

.custom-item-media {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #e0e0e0;
  margin-bottom: 12rpx;
}

.custom-item-preview {
  width: 100%;
  height: 100%;
}

.custom-item-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  z-index: 10;
}

.custom-item-discrip-wrapper {
  width: 100%;
}

.custom-item-discrip {
  width: 100%;
  min-height: 80rpx;
  background-color: #fff;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  box-sizing: border-box;
}

.custom-item-add-options {
  display: flex;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.custom-item-add {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background-color: #f8f9fc;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
}

.custom-item-add:active {
  background-color: #f0f0f0;
}

.custom-item-add-icon {
  font-size: 48rpx;
}

.custom-item-add-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.cancel-btn {
  background-color: #f8f9fc;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  color: #fff;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ==================== iOS 精修（追加覆盖，后面规则优先） ==================== */

/* 容器灰底 */
.container {
  background-color: #f2f2f7;
}

/* 添加课程 → iOS 系统蓝胶囊 */
.add-btn {
  background: #007aff;
  border-radius: 999rpx;
  box-shadow: none;
}
.add-btn:active {
  opacity: 0.85;
}

/* 课程行 → 白卡 hairline */
.course-item {
  background-color: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 24rpx;
  box-shadow: none;
}
.course-cover-placeholder {
  background-color: #f2f2f7;
}
.course-title {
  color: #000000;
}
.course-desc,
.course-sort,
.course-hours {
  color: rgba(60, 60, 67, 0.34);
}

/* 行内编辑/删除 → 语义色淡底 chip */
.edit-btn {
  color: #007aff;
  border: none;
  background-color: rgba(0, 122, 255, 0.12);
}
.delete-btn {
  color: #ff3b30;
  border: none;
  background-color: rgba(255, 59, 48, 0.12);
}
.edit-btn::after,
.delete-btn::after {
  border: none;
}

/* 弹窗：标题/文案改深，输入底保持浅灰 */
.modal-header,
.modal-footer {
  border-color: rgba(60, 60, 67, 0.1);
}
.modal-title {
  color: #000000;
}
.modal-close {
  color: rgba(60, 60, 67, 0.34);
}
.label {
  color: rgba(60, 60, 67, 0.6);
}
.required {
  color: #ff3b30;
}
.hint {
  color: rgba(60, 60, 67, 0.34);
}
.input,
.textarea {
  color: #000000;
}
.upload-placeholder,
.custom-item-add {
  border-color: rgba(60, 60, 67, 0.2);
}
.upload-icon {
  color: rgba(60, 60, 67, 0.34);
}
.upload-text,
.custom-item-add-text {
  color: rgba(60, 60, 67, 0.34);
}
.custom-item-media {
  background-color: #e9e9eb;
}
.custom-item-discrip {
  color: #000000;
}

/* 底部按钮 */
.cancel-btn {
  background-color: #f2f2f7;
  color: #000000;
}
.confirm-btn {
  background: #007aff;
}
.cancel-btn::after,
.confirm-btn::after {
  border: none;
}
.confirm-btn:active {
  opacity: 0.85;
}

.empty {
  color: rgba(60, 60, 67, 0.34);
}