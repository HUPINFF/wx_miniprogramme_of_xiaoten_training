/* pages/coach/course-manage/index.wxss 课程管理：首页同款渐变头部 + 白卡课程流 + 弹窗表单。
   变量与首页同源（page 级 wxss 每页独立，要在这份里再声明一遍）；
   原 iOS 蓝双层覆盖样式整体重写为一层，配色统一品牌绿 */
page {
  --primary: #07c160;
  --primary-dark: #05a350;
  --primary-light: #e8f5e9;
  --bg: #f5f7fa;
  --card: #ffffff;
  --text-main: #1a1a2e;
  --text-sub: #6b7280;
  --text-hint: #9ca3af;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn 0.4s ease-out both;
}

/* ==================== 渐变背景（首页同一配方） ==================== */
.gradient-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 460rpx;
  background: linear-gradient(135deg, #07c160 0%, #00d68f 30%, #e8f5e9 80%, rgba(245, 247, 250, 0) 100%);
  z-index: 0;
}

.gradient-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);
}

/* ==================== 页面容器 ==================== */
.container {
  min-height: 100vh;
  background: var(--bg);
  position: relative;
  padding-bottom: 60rpx;
}

/* ==================== 顶部标题区 ==================== */
.header-area {
  position: relative;
  z-index: 1;
  padding: 92rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

/* 副标题胶囊：半透明白底 */
.header-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(10rpx);
}

/* 返回键：白透圆钮浮在标题行左侧 */
.back-btn {
  position: absolute;
  left: 30rpx;
  top: 96rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 40rpx;
  line-height: 60rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.back-btn-active {
  background: rgba(255, 255, 255, 0.32);
}

/* ==================== 内容层 ==================== */
.page-content {
  position: relative;
  z-index: 1;
  padding: 10rpx 24rpx 0;
}

/* ==================== 添加按钮（列表末尾，浅绿虚线轻量款） ==================== */
.add-btn {
  width: 100%;
  margin-top: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--primary-light);
  border: 2rpx dashed rgba(7, 193, 96, 0.45);
  padding: 26rpx;
  border-radius: 999rpx;
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.add-btn:active {
  background: rgba(7, 193, 96, 0.18);
  transform: scale(0.97);
}

.add-icon {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}

/* ==================== 课程列表 ==================== */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.course-item {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}

.course-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background-color: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.course-cover-img {
  width: 100%;
  height: 100%;
}

.course-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-light), #f0fdf4);
}

.course-placeholder-text {
  font-size: 48rpx;
}

.course-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}

.course-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

/* 排序/课时：灰底信息胶囊，课时用品牌绿点睛 */
.course-sort,
.course-hours {
  font-size: 22rpx;
  color: var(--text-sub);
  background: #f7f8fa;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  display: block;
}

.course-hours {
  color: var(--primary);
  background: var(--primary-light);
  font-weight: 600;
}

.course-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 编辑/删除：语义色淡底 chip */
.edit-btn,
.delete-btn {
  background-color: transparent;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 26rpx;
  line-height: 1.4;
  margin: 0;
}

.edit-btn {
  color: var(--primary);
  background-color: var(--primary-light);
}

.delete-btn {
  color: #ff3b30;
  background-color: rgba(255, 59, 48, 0.1);
}

.edit-btn::after,
.delete-btn::after {
  border: none;
}

.edit-btn:active,
.delete-btn:active {
  opacity: 0.75;
  transform: scale(0.95);
}

/* ==================== 空状态 ==================== */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: var(--text-hint);
  font-size: 28rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}

/* ==================== 弹窗 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 92%;
  max-height: 90vh;
  background-color: var(--card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.modal-close {
  font-size: 44rpx;
  color: var(--text-hint);
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  width: 100%;
  max-height: 60vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  display: block;
  margin-bottom: 12rpx;
}

.required {
  color: #ff3b30;
}

.hint {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-hint);
  margin-left: 8rpx;
}

/* 输入框：浅灰底圆角，聚焦绿描边 */
.input {
  width: 100%;
  height: 84rpx;
  background-color: #f7f8fa;
  padding-left: 24rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
  line-height: 84rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  background-color: #f7f8fa;
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
  line-height: 1.6;
  border: 2rpx solid transparent;
}

/* ==================== 上传图片区域 ==================== */
.upload-area {
  width: 100%;
  background-color: #f7f8fa;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 300rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  border: 2rpx dashed rgba(60, 60, 67, 0.2);
  border-radius: var(--radius-md);
}

.upload-icon {
  font-size: 60rpx;
  color: var(--text-hint);
  line-height: 1;
}

.upload-text {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

/* ==================== 自定义内容编辑器 ==================== */
.custom-items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.custom-item-editor {
  background-color: #f7f8fa;
  border-radius: var(--radius-md);
  padding: 16rpx;
}

.custom-item-media {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #e9e9eb;
  margin-bottom: 12rpx;
}

.custom-item-preview {
  width: 100%;
  height: 100%;
}

.custom-item-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  z-index: 10;
}

.custom-item-discrip-wrapper {
  width: 100%;
}

.custom-item-discrip {
  width: 100%;
  min-height: 80rpx;
  background-color: #fff;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.5;
  box-sizing: border-box;
}

/* 添加图片/视频：虚线框，绿点缀 */
.custom-item-add-options {
  display: flex;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.custom-item-add {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background-color: #f7f8fa;
  border: 2rpx dashed rgba(7, 193, 96, 0.35);
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
}

.custom-item-add:active {
  background-color: var(--primary-light);
  transform: scale(0.98);
}

.custom-item-add-icon {
  font-size: 48rpx;
}

.custom-item-add-text {
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 8rpx;
  font-weight: 500;
}

/* ==================== 弹窗底部按钮 ==================== */
.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 24rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  line-height: 88rpx;
}

.cancel-btn {
  background-color: #f2f3f5;
  color: var(--text-sub);
}

.confirm-btn {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.25);
}

.cancel-btn::after,
.confirm-btn::after {
  border: none;
}

.cancel-btn:active,
.confirm-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}
