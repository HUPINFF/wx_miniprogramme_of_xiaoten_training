/* pages/coach/growth-detail/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #f8fafc 0%, #eef4ff 50%, #f0f7ff 100%);
}

.page-content {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8faff 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 217, 0.08);
  border: 1rpx solid rgba(74, 144, 217, 0.1);
}

.header-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a90d9 0%, #67b26f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 217, 0.3);
}

.avatar-icon {
  font-size: 48rpx;
  color: #fff;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.main-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.3;
}

.category-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.category-badge.fitness {
  color: #07c160;
  background: #e8f5e9;
}

.category-badge.height {
  color: #ff9800;
  background: #fff3e0;
}

.sub-title {
  font-size: 24rpx;
  color: #8896a6;
  letter-spacing: 1rpx;
}

/* 描述卡片 */
.desc-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f5;
}

.card-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.label-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.label-dot.blue {
  background: linear-gradient(135deg, #4a90d9, #6ba3ff);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 217, 0.4);
}

.label-dot.green {
  background: linear-gradient(135deg, #67b26f, #89d499);
  box-shadow: 0 2rpx 8rpx rgba(103, 178, 111, 0.4);
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

.item-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #aab4be;
  font-weight: 400;
}

.desc-body {
  background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e8f0fe;
}

.desc-body text {
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.8;
}

/* 时间线卡片 */
.timeline-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f5;
}

.timeline-body {
  position: relative;
}

.timeline-track {
  position: absolute;
  left: 31rpx;
  top: 36rpx;
  bottom: 36rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #4a90d9 0%, #67b26f 100%);
  border-radius: 2rpx;
}

.track-line {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #4a90d9 0%, #67b26f 50%, #89d499 100%);
}

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-left: 0;
}

/* 时间线项 */
.timeline-item {
  display: flex;
  gap: 28rpx;
  position: relative;
}

.timeline-item.first {
  
}

.timeline-item.last {
  
}

.item-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 24rpx;
}

.indicator-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a90d9, #67b26f);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.3);
  margin-left: 18rpx;
  z-index: 2;
}

.dot-inner {
  width: 12rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 50%;
}

.item-card {
  flex: 1;
  background: linear-gradient(135deg, #ffffff 0%, #fafbff 100%);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f2f7;
}

.card-media {
  position: relative;
  width: 100%;
}

.media-image {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #f5f5f5;
}

.media-video {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #f5f5f5;
}

.media-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-icon {
  color: #fff;
  font-size: 32rpx;
  margin-left: 6rpx;
}

.card-content {
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f2f7;
}

.content-text {
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.7;
}

.card-footer {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #f8faff 0%, #f5f7ff 100%);
  display: flex;
  justify-content: flex-end;
}

.item-index {
  font-size: 22rpx;
  color: #aab4be;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f0f0f5;
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f0f7ff 0%, #e8f4ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.8;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #8896a6;
}

/* 加载状态 */
.loading-cover {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 60rpx 80rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e8f0fe;
  border-top-color: #4a90d9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #8896a6;
}