/* pages/coach/common.wxss - 通用样式（iOS 化），可在各页面导入 */
page {
  background-color: #F2F2F7;
}

.container {
  min-height: 100vh;
  background-color: #F2F2F7;
  padding: 24rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: none;
}

/* 区块标题 */
.section {
  width: 100%;
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: none;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #000000;
}

.section-more {
  color: #007aff;
}

.section-count {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 60rpx 0;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #ECECF0;
  border-top-color: #007aff;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 按钮 */
.btn-primary {
  background-color: #007aff;
  color: #fff;
  border-radius: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background-color: #0056cf;
}
