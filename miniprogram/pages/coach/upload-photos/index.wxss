/* pages/coach/upload-photos/index.wxss — iOS 风格 */
@import "../common.wxss";

.container {
  padding: 0;
}

.content {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* 提示信息 */
.tips {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tips-text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  line-height: 1.6;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.photo-item {
  width: 220rpx;
  height: 220rpx;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn text {
  font-size: 26rpx;
  color: #fff;
}

/* 添加按钮 */
.add-btn {
  width: 220rpx;
  height: 220rpx;
  background: #ffffff;
  border: 1rpx dashed rgba(60, 60, 67, 0.25);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.add-btn text:first-child {
  font-size: 60rpx;
  color: #007aff;
  line-height: 1;
}

.add-text {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(249, 249, 251, 0.92);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(60, 60, 67, 0.12);
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background: #007aff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn:active {
  background-color: #0056cf;
}

.save-btn.disabled {
  background: #e5e5ea;
}

.save-btn text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.save-btn.disabled text {
  color: rgba(60, 60, 67, 0.3);
}
