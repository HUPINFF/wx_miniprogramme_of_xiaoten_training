/* pages/coach/content-manage/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* Tab切换 */
.tabs {
  width: 100%;
  display: flex;
  background-color: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  position: relative;
  white-space: nowrap;
}

.tab-item.active {
  color: #07c160;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

/* 内容面板 */
.content-panel {
  width: 90%;
  margin: 0 auto;
  padding: 20rpx;
}

/* 添加按钮 */
.add-btn {
  width: 50%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 48rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.add-icon {
  font-size: 40rpx;
  font-weight: bold;
}

/* 轮播图列表 */
.banner-list, .news-list, .moment-list, .growth-list {
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.banner-item, .news-item, .moment-item, .growth-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.banner-img, .moment-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.moment-video {
  width: 200rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.banner-info, .moment-info, .news-info, .growth-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.banner-text, .moment-title, .news-title, .growth-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-category-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.growth-category-tag.fitness {
  color: #07c160;
  background: #e8f5e9;
}

.growth-category-tag.height {
  color: #ff9800;
  background: #fff3e0;
}

.growth-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: wrap;
}

.banner-sort, .moment-sort, .news-sort, .news-time, .growth-sort, .growth-count {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.media-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f5e9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.banner-actions, .moment-actions, .news-actions, .growth-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.edit-btn, .delete-btn {
  background-color: #f8f9fc;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
}

.edit-btn {
  color: #07c160;
  border: 2rpx solid #07c160;
}

.delete-btn {
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
}

/* 成长案例封面 */
.growth-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.growth-cover-img {
  width: 100%;
  height: 100%;
}

.growth-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e8f5e9;
}

.growth-placeholder-text {
  font-size: 20rpx;
  color: #07c160;
  text-align: center;
  padding: 8rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 85%;
  max-height: 90vh;
  background-color: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-container.growth-modal {
  width: 95%;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 44rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.required {
  color: #ff6b6b;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.input, .picker {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fc;
  padding-left: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 80rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background-color: #f8f9fc;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 媒体类型选择 */
.media-type-selector {
  display: flex;
  gap: 20rpx;
}

.media-type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background-color: #f8f9fc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.media-type-item.active {
  background-color: #e8f5e9;
  color: #07c160;
  border-color: #07c160;
}

/* 成长案例分类选择 */
.category-selector {
  display: flex;
  gap: 20rpx;
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 20rpx;
  background-color: #f8f9fc;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.category-item.active {
  background-color: #e8f5e9;
  border-color: #07c160;
}

.category-icon {
  font-size: 48rpx;
}

.category-text {
  font-size: 26rpx;
  color: #666;
}

.category-item.active .category-text {
  color: #07c160;
  font-weight: 500;
}

/* 上传图片区域 */
.upload-area {
  width: 100%;
  background-color: #f8f9fc;
  border-radius: 16rpx;
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 300rpx;
}

.upload-video {
  width: 100%;
  height: 300rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
}

.upload-icon {
  font-size: 60rpx;
  color: #ccc;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 成长案例记录编辑器 */
.growth-items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.growth-item-editor {
  background-color: #f8f9fc;
  border-radius: 16rpx;
  padding: 16rpx;
}

.growth-item-media {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #e0e0e0;
  margin-bottom: 12rpx;
}

.growth-item-preview {
  width: 100%;
  height: 100%;
}

.growth-item-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  z-index: 10;
}

.growth-item-discrip-wrapper {
  width: 100%;
}

.growth-item-discrip {
  width: 100%;
  min-height: 80rpx;
  background-color: #fff;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  box-sizing: border-box;
}

.growth-item-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background-color: #f8f9fc;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
}

.growth-item-add:active {
  background-color: #f0f0f0;
}

.growth-item-add-icon {
  font-size: 60rpx;
  color: #07c160;
}

.growth-item-add-text {
  font-size: 26rpx;
  color: #07c160;
  margin-top: 8rpx;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.cancel-btn {
  background-color: #f8f9fc;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  color: #fff;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
