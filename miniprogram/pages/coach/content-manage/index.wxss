/* pages/coach/content-manage/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
  padding-bottom: 40rpx;
}

/* Tab切换：iOS 分段控件 */
.tabs {
  width: calc(100% - 48rpx);
  margin: 24rpx auto 8rpx;
  display: flex;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 999rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  padding: 16rpx 0;
  border-radius: 999rpx;
  position: relative;
  white-space: nowrap;
  font-weight: 500;
  transition: all 0.2s;
}

.tab-item.active {
  color: #ffffff;
  font-weight: 600;
  background: #007aff;
}

.tab-item.active::after {
  display: none;
}

/* 内容面板 */
.content-panel {
  padding: 20rpx 24rpx;
}

/* 添加按钮 → iOS 系统蓝 */
.add-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #007aff;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.add-btn:active {
  background-color: #0056cf;
}

.add-icon {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1;
}

/* 列表卡片 */
.banner-list,
.news-list,
.moment-list,
.growth-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.banner-item,
.news-item,
.moment-item,
.growth-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
}

.banner-img,
.moment-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: #f2f2f7;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.moment-video {
  width: 200rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: #f2f2f7;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.banner-info,
.moment-info,
.news-info,
.growth-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.banner-text,
.moment-title,
.news-title,
.growth-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #000;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-desc {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-category-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  width: fit-content;
  font-weight: 500;
}

.growth-category-tag.fitness {
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
}

.growth-category-tag.height {
  color: #ff9500;
  background: rgba(255, 149, 0, 0.14);
}

.growth-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: wrap;
}

.banner-sort,
.moment-sort,
.news-sort,
.news-time,
.growth-sort,
.growth-count {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  display: block;
}

.media-tag {
  font-size: 22rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  width: fit-content;
  font-weight: 500;
}

.banner-actions,
.moment-actions,
.news-actions,
.growth-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.edit-btn,
.delete-btn {
  background-color: rgba(0, 122, 255, 0.1);
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  line-height: 56rpx;
  height: 56rpx;
  margin: 0;
  font-weight: 500;
  border: none;
}

.edit-btn::after,
.delete-btn::after {
  border: none;
}

.edit-btn {
  color: #007aff;
}

.delete-btn {
  color: #ff3b30;
  background-color: rgba(255, 59, 48, 0.12);
}

.edit-btn:active,
.delete-btn:active {
  opacity: 0.8;
}

/* 成长案例封面 */
.growth-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: #f2f2f7;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.growth-cover-img {
  width: 100%;
  height: 100%;
}

.growth-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 122, 255, 0.1);
}

.growth-placeholder-text {
  font-size: 20rpx;
  color: #007aff;
  text-align: center;
  padding: 8rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 85%;
  max-height: 90vh;
  background-color: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-container.growth-modal {
  width: 95%;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
}

.modal-close {
  font-size: 40rpx;
  color: rgba(60, 60, 67, 0.34);
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #ff3b30;
}

.hint {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-left: 8rpx;
  font-weight: 400;
}

.input,
.picker {
  width: 100%;
  height: 88rpx;
  background-color: #f2f2f7;
  padding-left: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000;
  box-sizing: border-box;
  line-height: 88rpx;
}

.picker {
  display: flex;
  align-items: center;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background-color: #f2f2f7;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 媒体类型选择：分段控件 */
.media-type-selector {
  display: flex;
  background: #f2f2f7;
  border-radius: 999rpx;
  padding: 6rpx;
}

.media-type-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  font-weight: 500;
  transition: all 0.2s;
}

.media-type-item.active {
  background-color: #007aff;
  color: #fff;
}

/* 成长案例分类选择 */
.category-selector {
  display: flex;
  gap: 20rpx;
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 20rpx;
  background-color: #f2f2f7;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.category-item.active {
  background-color: rgba(0, 122, 255, 0.1);
  border-color: #007aff;
}

.category-icon {
  font-size: 48rpx;
}

.category-text {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  font-weight: 500;
}

.category-item.active .category-text {
  color: #007aff;
  font-weight: 600;
}

/* 上传图片区域 */
.upload-area {
  width: 100%;
  background-color: #f2f2f7;
  border-radius: 20rpx;
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 300rpx;
}

.upload-video {
  width: 100%;
  height: 300rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border: 1rpx dashed rgba(60, 60, 67, 0.2);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.upload-icon {
  font-size: 60rpx;
  color: #007aff;
  line-height: 1;
}

.upload-text {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  margin-top: 12rpx;
}

/* 成长案例记录编辑器 */
.growth-items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.growth-item-editor {
  background-color: #f2f2f7;
  border-radius: 20rpx;
  padding: 16rpx;
}

.growth-item-media {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #ececf0;
  margin-bottom: 12rpx;
}

.growth-item-preview {
  width: 100%;
  height: 100%;
}

.growth-item-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  z-index: 10;
}

.growth-item-discrip-wrapper {
  width: 100%;
}

.growth-item-discrip {
  width: 100%;
  min-height: 80rpx;
  background-color: #ffffff;
  padding: 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #000;
  line-height: 1.5;
  box-sizing: border-box;
}

.growth-item-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background-color: #ffffff;
  border: 1rpx dashed rgba(60, 60, 67, 0.2);
  border-radius: 20rpx;
}

.growth-item-add:active {
  background-color: #f7f7fa;
}

.growth-item-add-icon {
  font-size: 60rpx;
  color: #007aff;
  line-height: 1;
}

.growth-item-add-text {
  font-size: 26rpx;
  color: #007aff;
  margin-top: 8rpx;
  font-weight: 500;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 20rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
}

.cancel-btn::after,
.confirm-btn::after {
  border: none;
}

.cancel-btn {
  background-color: #f2f2f7;
  color: rgba(60, 60, 67, 0.6);
}

.confirm-btn {
  background-color: #007aff;
  color: #fff;
}

.confirm-btn:active {
  background-color: #0056cf;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}
