/* pages/coach/change-coach-requests/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.request-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.request-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
}

.request-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.child-info {
  display: flex;
  flex-direction: column;
}

.child-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 8rpx;
}

.request-time {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-badge.status-pending {
  background: rgba(255, 149, 0, 0.14);
  color: #ff9500;
}

.status-badge.status-approved,
.status-badge.status-approval {
  background: rgba(52, 199, 89, 0.14);
  color: #34c759;
}

.status-badge.status-rejected {
  background: rgba(255, 59, 48, 0.12);
  color: #ff3b30;
}

.request-body {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.34);
  flex-shrink: 0;
  margin-right: 20rpx;
}

.value {
  font-size: 26rpx;
  color: #000;
  font-weight: 500;
}

.request-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 24rpx;
  text-align: center;
}

.action-btn text {
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn.approve {
  background: #007aff;
}

.action-btn.approve text {
  color: #ffffff;
}

.action-btn.approve:active {
  background-color: #0056cf;
}

.action-btn.reject {
  background: rgba(255, 59, 48, 0.12);
}

.action-btn.reject text {
  color: #ff3b30;
}

.action-btn.reject:active {
  opacity: 0.8;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.34);
}
