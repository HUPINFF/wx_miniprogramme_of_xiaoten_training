/* pages/coach/post-class/index.wxss — iOS 风格 */
@import "../common.wxss";

.container {
  padding: 0;
}

.content {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* 课程卡片 */
.course-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.course-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
}

.course-status {
  font-size: 24rpx;
  color: #34c759;
  background: rgba(52, 199, 89, 0.14);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.course-info {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
}

.info-item .value {
  font-size: 28rpx;
  color: #000;
  font-weight: 600;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

/* 选项列表 */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.option-item:active {
  background: #f7f7fa;
}

.option-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-icon text {
  font-size: 40rpx;
  color: #007aff;
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}

.option-desc {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
}

.option-arrow {
  width: 40rpx;
  text-align: right;
}

.option-arrow text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.25);
  font-weight: 500;
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(249, 249, 251, 0.92);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(60, 60, 67, 0.12);
}

.finish-btn {
  width: 100%;
  height: 96rpx;
  background: #007aff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.finish-btn:active {
  background-color: #0056cf;
}

.finish-btn text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.finish-btn.disabled {
  opacity: 0.5;
}

/* ==================== 课后反馈版块（自 feedback/lesson 内联迁入） ==================== */

/* 课次日期 + 训练重点 */
.section-date {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(60, 60, 67, 0.34);
  margin-left: 12rpx;
}

.fb-focus {
  font-size: 25rpx;
  color: rgba(60, 60, 67, 0.6);
  margin: -8rpx 8rpx 20rpx;
  line-height: 1.6;
}

/* 本地 .card 覆盖 common.wxss（阴影改描边，与 reports/edit 卡片同款） */
.card {
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: none;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
  margin-bottom: 22rpx;
}

.title-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(60, 60, 67, 0.34);
  margin-left: 12rpx;
}

.card-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.card-head-row .card-title {
  margin-bottom: 0;
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-link {
  font-size: 24rpx;
  font-weight: 500;
  color: #007aff;
}

/* AI 生成入口：品牌绿强调 + 绿底白字 AI 角标，请求中整组置灰（防抖的同时给出可见状态）。
   角标不用第三方模型厂商 logo（商标风险），纯文字样式零资源 */
.ai-link {
  color: #00c26e;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ai-badge {
  flex-shrink: 0;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
  background: #00c26e;
  padding: 5rpx 8rpx;
  border-radius: 6rpx;
}

.ai-link.ai-busy {
  color: #9aa5b1;
}

.ai-link.ai-busy .ai-badge {
  background: #9aa5b1;
}

/* 评分 */
.stars {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 6rpx 0 10rpx;
}

.star {
  font-size: 64rpx;
  line-height: 1;
  color: rgba(60, 60, 67, 0.22);
  transition: color 0.15s ease, transform 0.15s ease;
}

.star.on {
  color: #ff9500;
}

.rating-word {
  font-size: 25rpx;
  color: #ff9500;
  font-weight: 500;
}

.rating-word.dim {
  color: rgba(60, 60, 67, 0.34);
  font-weight: 400;
}

/* 标签 chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.chip {
  padding: 12rpx 28rpx;
  font-size: 25rpx;
  color: #007aff;
  background: rgba(0, 122, 255, 0.08);
  border-radius: 999rpx;
  transition: all 0.15s ease;
}

.chip.on {
  color: #ffffff;
  background: #007aff;
  font-weight: 500;
}

/* 一句话记录 */
.note-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 140rpx;
  padding: 20rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #000000;
  background: #f7f7fa;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
}

.char-count {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 照片 / 视频 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.video-thumb {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.75);
  border-radius: 16rpx;
}

.video-play {
  font-size: 48rpx;
  color: #ffffff;
  line-height: 1;
}

.photo-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #f7f7fa;
  border: 2rpx dashed rgba(60, 60, 67, 0.2);
  border-radius: 16rpx;
}

.add-icon {
  font-size: 48rpx;
  color: rgba(60, 60, 67, 0.34);
  line-height: 1;
}

.add-label {
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 两版文案 */
.template-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.tpl-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.6);
}

.tpl-scroll {
  flex: 1;
  white-space: nowrap;
}

.tpl-chip {
  display: inline-block;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 14rpx;
  font-size: 22rpx;
}

.version-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 220rpx;
  padding: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #000000;
  background: #f7f7fa;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
}

.regen-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
}

.ph {
  color: rgba(60, 60, 67, 0.34);
}

/* 训练项目完成情况（可补勾） */
.check-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}

.check-row:last-child {
  border-bottom: none;
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid rgba(60, 60, 67, 0.22);
  background: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.check-circle.done {
  background: #34c759;
  border-color: #34c759;
}

.check-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 27rpx;
  color: #000;
}

/* 组数/个数（如「3组×12次」）右对齐灰字，选填没填就不显示 */
.check-amount {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: rgba(60, 60, 67, 0.34);
}

.check-name.done {
  color: rgba(60, 60, 67, 0.6);
}

.items-summary {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  text-align: right;
}
