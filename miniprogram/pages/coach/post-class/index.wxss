/* pages/coach/post-class/index.wxss */
@import "../common.wxss";

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.content {
  padding: 24rpx;
}

/* 课程卡片 */
.course-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.course-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.course-status {
  font-size: 26rpx;
  color: #07c160;
  background: #e8f8f0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.course-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  color: #999;
}

.info-item .value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

/* 选项列表 */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 200rpx;
}

.option-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.option-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-icon text {
  font-size: 40rpx;
  color: #fff;
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.option-desc {
  font-size: 26rpx;
  color: #999;
}

.option-arrow {
  width: 40rpx;
}

.option-arrow text {
  font-size: 28rpx;
  color: #ccc;
}

/* 底部区域 */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
}

.finish-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.finish-btn text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}