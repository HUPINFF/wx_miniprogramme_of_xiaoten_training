/* pages/coach/all-growth/index.wxss */

/* ==================== 全局变量（iOS 化） ==================== */
page {
  --bg: #F2F2F7;
  --primary: #007AFF;
  --primary-dark: #0056CF;
  --primary-light: rgba(0, 122, 255, 0.1);
  --card: #ffffff;
  --text-main: #000000;
  --text-sub: rgba(60, 60, 67, 0.6);
  --text-hint: rgba(60, 60, 67, 0.34);
  --border: rgba(60, 60, 67, 0.1);
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e8f8f5 100%);
}

.page-content {
  padding: 20rpx;
}

/* 分类筛选 */
.category-filter {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
  background: #fff;
  padding: 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-item.active {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  color: #fff;
  font-weight: 500;
}

/* 成长案例容器 */
.growth-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 成长案例卡片 */
.growth-item {
  background: linear-gradient(180deg, #ffffff 0%, #f8fffe 100%);
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.1);
  border: 3rpx solid rgba(7, 193, 96, 0.12);
  transition: all 0.3s ease;
}

.growth-item.featured {
  border: 4rpx solid rgba(255, 152, 0, 0.4);
  box-shadow: 0 12rpx 40rpx rgba(255, 152, 0, 0.12);
}

.growth-item:active {
  transform: scale(0.98);
}

/* 封面 */
.growth-cover {
  position: relative;
  width: 100%;
  height: 350rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
}

.growth-item.featured .growth-cover {
  background: linear-gradient(135deg, #ff9800 0%, #ff5722 100%);
  height: 400rpx;
}

.growth-cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.growth-no-cover {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.growth-no-cover text {
  font-size: 120rpx;
  opacity: 0.6;
}

/* 徽章 */
.growth-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: linear-gradient(135deg, #ff9800 0%, #ff5722 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 25rpx;
  box-shadow: 0 4rpx 15rpx rgba(255, 152, 0, 0.4);
}

.growth-badge.fitness {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  box-shadow: 0 4rpx 15rpx rgba(7, 193, 96, 0.4);
}

.growth-badge.height {
  background: linear-gradient(135deg, #ff9800 0%, #ff5722 100%);
  box-shadow: 0 4rpx 15rpx rgba(255, 152, 0, 0.4);
}

.growth-item.featured .growth-badge {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  box-shadow: 0 4rpx 15rpx rgba(7, 193, 96, 0.4);
}

/* 媒体数量指示器 */
.growth-media-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

/* 详情区域 */
.growth-details {
  padding: 30rpx;
}

.growth-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.growth-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  flex: 1;
  line-height: 1.3;
}

.growth-item.featured .growth-title {
  color: #d32f2f;
  font-size: 36rpx;
}

.growth-time {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
  white-space: nowrap;
}

/* 描述 */
.growth-desc {
  background: linear-gradient(90deg, rgba(7, 193, 96, 0.06) 0%, rgba(6, 163, 77, 0.06) 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.growth-item.featured .growth-desc {
  background: linear-gradient(90deg, rgba(255, 152, 0, 0.06) 0%, rgba(255, 87, 34, 0.06) 100%);
}

.growth-desc text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 标签 */
.growth-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 24rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 8rpx 18rpx;
  border-radius: 15rpx;
  font-weight: 500;
}

.growth-item.featured .tag {
  color: #ff5722;
  background: rgba(255, 87, 34, 0.1);
}

/* 底部区域 */
.growth-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.growth-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  font-size: 26rpx;
  color: #999;
}

.growth-actions {
  display: flex;
  gap: 16rpx;
}

.action-edit {
  font-size: 26rpx;
  color: #07c160;
  background: #e8f5e9;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.action-delete {
  font-size: 26rpx;
  color: #ff5722;
  background: #fdeae4;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 空状态 */
.empty-growth {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background: #fff;
  border-radius: 30rpx;
  margin-top: 40rpx;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 30rpx;
}

.empty-hint {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  padding: 16rpx 32rpx;
  border-radius: 25rpx;
}

.empty-hint text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* ==================== iOS 精修（追加覆盖，后面规则优先） ==================== */

/* 容器灰底 */
.container {
  background: #f2f2f7;
}

/* 分类筛选 → 白底胶囊 chip */
.category-filter {
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  box-shadow: none;
  padding: 12rpx;
}
.filter-item {
  background: transparent;
  color: rgba(60, 60, 67, 0.6);
  border-radius: 999rpx;
}
.filter-item.active {
  background: #007aff;
  color: #ffffff;
}

/* 成长卡片：去绿渐变边框投影 */
.growth-item {
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  box-shadow: none;
}
.growth-item.featured {
  border-color: rgba(60, 60, 67, 0.14);
  box-shadow: none;
}
.growth-cover {
  background: linear-gradient(135deg, #eef2ff 0%, #e7f1fb 100%);
}
.growth-item.featured .growth-cover {
  background: linear-gradient(135deg, #eef2ff 0%, #e7f1fb 100%);
}
.growth-no-cover {
  background: #f0f2f5;
}
.growth-badge,
.growth-badge.fitness,
.growth-badge.height,
.growth-item.featured .growth-badge {
  background: #007aff;
  box-shadow: none;
}
.growth-title,
.growth-item.featured .growth-title {
  color: #000000;
}
.growth-time {
  color: rgba(60, 60, 67, 0.34);
}
.growth-desc,
.growth-item.featured .growth-desc {
  background: #f7f7fa;
}
.growth-desc text {
  color: rgba(60, 60, 67, 0.6);
}
.tag {
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
}
.growth-item.featured .tag {
  color: #ff9500;
  background: rgba(255, 149, 0, 0.14);
}
.growth-footer {
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}
.stat-item {
  color: rgba(60, 60, 67, 0.34);
}
.action-edit {
  color: #007aff;
  background: rgba(0, 122, 255, 0.12);
}
.action-delete {
  color: #ff3b30;
  background: rgba(255, 59, 48, 0.12);
}

/* 空状态 */
.empty-growth {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: none;
}
.empty-title {
  color: #000000;
}
.empty-desc {
  color: rgba(60, 60, 67, 0.34);
}
.empty-hint {
  background: #007aff;
}
