/* pages/coach/performance/list/index.wxss — iOS 风格 */
page {
  background-color: #f2f2f7;
}

.container {
  min-height: 100vh;
  background-color: #f2f2f7;
  padding: 8rpx 0 40rpx;
}

/* 筛选栏：iOS 分段控件 */
.filter-bar {
  width: calc(100% - 48rpx);
  margin: 16rpx auto 8rpx;
  display: flex;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 999rpx;
  padding: 6rpx;
  position: sticky;
  top: 8rpx;
  z-index: 10;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
  border-radius: 999rpx;
  transition: all 0.2s;
  font-weight: 500;
}

.filter-item.active {
  color: #ffffff;
  font-weight: 600;
  background: #007aff;
}

.filter-item.active::after {
  display: none;
}

/* 统计信息 */
.stats-info {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  text-align: center;
  padding: 12rpx 0 4rpx;
}

/* 表现列表 */
.performance-list {
  width: calc(100% - 48rpx);
  margin: 0 auto;
  padding: 12rpx 0;
}

/* 表现卡片 */
.performance-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: transform 0.2s;
}

.performance-card:active {
  transform: scale(0.98);
}

/* 卡片头部 */
.performance-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.week-date {
  font-size: 30rpx;
  font-weight: 700;
  color: #000;
}

.arrow {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.25);
  font-weight: 500;
}

/* 表现数据网格 */
.performance-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.performance-item {
  background-color: #f2f2f7;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
}

.performance-item .label {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  display: block;
  margin-bottom: 8rpx;
}

.performance-item .value {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}

/* 趋势分析 */
.trend-analysis {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.trend-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f2f2f7;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
}

.trend-label {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.6);
}

.trend-value {
  font-size: 26rpx;
  font-weight: 600;
}

.trend-value.up {
  color: #ff9500;
}

.trend-value.down {
  color: #34c759;
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.34);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: rgba(60, 60, 67, 0.34);
  font-size: 28rpx;
}

/* 加载 HUD */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background-color: rgba(28, 28, 30, 0.88);
  padding: 40rpx;
  border-radius: 24rpx;
  color: #fff;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.25);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
