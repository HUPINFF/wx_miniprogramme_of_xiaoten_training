/* pages/coach/performance/weekly/index.wxss — iOS 风格 */
@import "../../common.wxss";

/* 表单 */
.form {
  background-color: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.warning-text {
  color: #ff9500;
}

/* 字段（picker + input 统一为 iOS 浅灰输入框） */
.picker,
.form input,
.stage-items input {
  background-color: #f2f2f7;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000;
  box-sizing: border-box;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}

.form input,
.stage-items input {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}

.hint,
.tips-text {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-top: 12rpx;
  display: block;
}

.slider {
  margin: 16rpx 0;
}

/* 提交按钮 → iOS 系统蓝 */
.submit-btn {
  background-color: #007aff;
  color: #fff;
  border-radius: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 40rpx;
  padding: 0;
  width: 100%;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  background-color: #0056cf;
  opacity: 0.85;
}

/* 骨架屏 */
.skeleton-form {
  background-color: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.skeleton-item {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.skeleton-label,
.skeleton-input {
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f2f2f7 25%, #ececf1 45%, #f2f2f7 65%);
  background-size: 300% 100%;
  animation: shimmer 1.2s ease-in-out infinite;
}

.skeleton-label {
  width: 160rpx;
  height: 24rpx;
}

.skeleton-input {
  width: 100%;
  height: 88rpx;
}

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 阶段选择：分段控件 */
.stage-selector {
  display: flex;
  gap: 0;
  background: #f2f2f7;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-top: 16rpx;
}

.stage-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 999rpx;
  text-align: center;
  transition: all 0.2s;
  background: transparent;
}

.stage-btn text {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  font-weight: 500;
}

.stage-btn.active {
  background: #007aff;
}

.stage-btn.active text {
  color: #ffffff;
}

/* 性别提示 */
.gender-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background-color: #f2f2f7;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.gender-label {
  font-size: 26rpx;
  color: rgba(60, 60, 67, 0.6);
}

.gender-value {
  font-size: 28rpx;
  color: #007aff;
  font-weight: 600;
}

/* 阶段项目容器 */
.stage-items {
  background-color: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.stage-items .form-item:last-child {
  margin-bottom: 0;
}

/* 提示条 */
.tips-tag {
  background: rgba(0, 122, 255, 0.06);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 24rpx;
}

.tips-tag .tips-text {
  color: rgba(60, 60, 67, 0.6);
  margin-top: 0;
  line-height: 1.5;
}
