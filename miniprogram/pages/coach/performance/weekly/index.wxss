/* pages/coach/performance/weekly/index.wxss */
@import "../../common.wxss";

/* 表单 */
.form {
  width: 90%;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin:0 auto ;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.warning-text {
  color: #ff9500;
}

.picker {
  background-color: #f8f9fc;
  padding: 24rpx;
  height: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

input {
  background-color: #f8f9fc;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.slider {
  margin: 16rpx 0;
}

.submit-btn {
  background-color: #07c160;
  color: #fff;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
  padding: 0;
}

.skeleton-list {
  width: 95%;
  padding: 0 20rpx;
}

.skeleton-item {
  /* background-color: #fff; */
}

/* 阶段选择器 */
.stage-selector {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.stage-btn {
  flex: 1;
  padding: 24rpx;
  background-color: #f0f0f0;
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s;
}

.stage-btn text {
  font-size: 28rpx;
  color: #666;
}

.stage-btn.active {
  background: linear-gradient(135deg, #07c160 0%, #05a350 100%);
}

.stage-btn.active text {
  color: #ffffff;
}

/* 性别显示 */
.gender-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background-color: #e8f5e9;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.gender-label {
  font-size: 26rpx;
  color: #666;
}

.gender-value {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
}

/* 阶段项目容器 */
.stage-items {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}