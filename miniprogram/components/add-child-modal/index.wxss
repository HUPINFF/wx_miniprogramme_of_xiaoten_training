/* components/add-child-modal/index.wxss */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 85%;
  max-height: 85%;
  background-color: #ffffff;
  border-radius: 36rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
}

.modal-close {
  font-size: 44rpx;
  color: rgba(60, 60, 67, 0.34);
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #ff3b30;
  margin-left: 4rpx;
}

.input, .picker, .textarea {
  width: 100%;
  height: 88rpx;
  background-color: #f7f7fa;
  padding: 0 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000000;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.input:focus, .picker:focus, .textarea:focus {
  border-color: #007aff;
  background-color: #ffffff;
}

.textarea {
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
  height: auto;
}

.gender-group {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background-color: #f7f7fa;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  transition: all 0.2s;
  border: 1rpx solid transparent;
}

.gender-option.active {
  background-color: rgba(0, 122, 255, 0.12);
  color: #007aff;
  border-color: transparent;
  font-weight: 600;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 36rpx;
  gap: 24rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.cancel-btn {
  background-color: #f2f2f7;
  color: #000000;
}

.cancel-btn::after {
  border: none;
}

.cancel-btn:active {
  background-color: #e4e4e9;
}

.confirm-btn {
  background-color: #007aff;
  color: #ffffff;
  font-weight: 600;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  opacity: 0.85;
}
