/* components/add-child-modal/index.wxss */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 85%;
  max-height: 85%;
  background-color: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 44rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #ff6b6b;
  margin-left: 4rpx;
}

.input, .picker, .textarea {
  width: 100%;
  height: 90rpx;
  background-color: #f8f9fc;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.input:focus, .picker:focus, .textarea:focus {
  border-color: #07c160;
}

.textarea {
  min-height: 140rpx;
  line-height: 1.5;
}

.gender-group {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background-color: #f8f9fc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.gender-option.active {
  background-color: #07c160;
  color: #fff;
  border-color: #07c160;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 32rpx;
  gap: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.cancel-btn {
  background-color: #f8f9fc;
  color: #666;
}

.cancel-btn::after {
  border: none;
}

.confirm-btn {
  background: linear-gradient(135deg, #07c160 0%, #06a34d 100%);
  color: #fff;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  opacity: 0.9;
}

.cancel-btn:active {
  background-color: #f0f0f0;
}