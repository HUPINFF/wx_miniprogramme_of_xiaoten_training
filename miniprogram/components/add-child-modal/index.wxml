<!-- components/add-child-modal/index.wxml -->
<view class="modal-mask" wx:if="{{show}}" bindtap="close">
  <view class="modal-container" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">{{isEdit ? '编辑孩子' : '添加孩子'}}</text>
      <text class="modal-close" bindtap="close">✕</text>
    </view>
    
    <view class="modal-body">
      <!-- 孩子姓名 -->
      <view class="form-item">
        <text class="label">孩子姓名 <text class="required">*</text></text>
        <input 
          class="input" 
          placeholder="请输入孩子姓名" 
          value="{{formData.name}}" 
          bindinput="onNameInput" 
        />
      </view>
      
      <!-- 年龄 -->
      <view class="form-item">
        <text class="label">年龄 <text class="required">*</text></text>
        <input 
          class="input" 
          type="number" 
          placeholder="请输入年龄" 
          value="{{formData.age}}" 
          bindinput="onAgeInput" 
        />
      </view>
      
      <!-- 性别 -->
      <view class="form-item">
        <text class="label">性别</text>
        <view class="gender-group">
          <view 
            class="gender-option {{formData.gender === 'male' ? 'active' : ''}}" 
            bindtap="selectGender" 
            data-gender="male"
          >
            <text>👦 男孩</text>
          </view>
          <view 
            class="gender-option {{formData.gender === 'female' ? 'active' : ''}}" 
            bindtap="selectGender" 
            data-gender="female"
          >
            <text>👧 女孩</text>
          </view>
        </view>
      </view>
      
      <!-- 生日 -->
      <view class="form-item">
        <text class="label">生日</text>
        <picker mode="date" value="{{formData.birthday}}" bindchange="onBirthdayChange">
          <view class="picker">{{formData.birthday || '请选择生日'}}</view>
        </picker>
      </view>
      
      <!-- 备注 -->
      <view class="form-item">
        <text class="label">备注</text>
        <textarea 
          class="textarea" 
          placeholder="选填" 
          value="{{formData.remark}}" 
          bindinput="onRemarkInput" 
          maxlength="100"
        />
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="close">取消</button>
      <button class="confirm-btn" bindtap="confirm">确定</button>
    </view>
  </view>
</view>