.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(249, 249, 251, 0.82);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  z-index: 999;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.navbar-left {
  width: 76rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.navbar-back {
  min-width: 76rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 4rpx;
}

.back-icon {
  font-size: 52rpx;
  font-weight: 300;
  color: #007AFF;
  line-height: 1;
}

.navbar-center {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  overflow: hidden;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
  letter-spacing: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.brand-sub {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.6);
  margin-left: 12rpx;
}

.navbar-right {
  width: 76rpx;
}

.navbar-placeholder {
  width: 100%;
  background-color: transparent;
}
