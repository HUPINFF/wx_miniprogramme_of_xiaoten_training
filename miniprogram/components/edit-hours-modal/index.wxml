<!-- components/edit-hours-modal/index.wxml -->
<view class="modal-mask" wx:if="{{show}}" bindtap="close">
  <view class="modal-container" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">编辑剩余学时</text>
      <text class="modal-close" bindtap="close">✕</text>
    </view>
    
    <view class="modal-body">
      <view class="form-item">
        <text class="label">学员：{{childName}}</text>
      </view>
      <view class="form-item">
        <text class="label">剩余学时（课时）</text>
        <input class="input" type="number" placeholder="请输入剩余学时" value="{{tempHours}}" bindinput="onHoursInput" />
        <!-- <text class="hint">每课时为1小时训练</text> -->
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="close">取消</button>
      <button class="confirm-btn" bindtap="confirm" loading="{{submitting}}">保存</button>
    </view>
  </view>
</view>