/* components/edit-profile-modal/index.wxss */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 85%;
  background-color: #ffffff;
  border-radius: 36rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
}

.modal-close {
  font-size: 44rpx;
  color: rgba(60, 60, 67, 0.34);
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: rgba(60, 60, 67, 0.6);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 头像上传 */
.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #f7f7fa;
  border-radius: 20rpx;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #e9e9eb;
}

.upload-tip {
  font-size: 26rpx;
  color: #007aff;
}

/* 输入框 */
.input {
  width: 100%;
  background-color: #f7f7fa;
  padding: 0 24rpx;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #000000;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.input:focus {
  border-color: #007aff;
  background-color: #ffffff;
}

.hint {
  font-size: 24rpx;
  color: rgba(60, 60, 67, 0.34);
  margin-top: 12rpx;
  display: block;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx 36rpx;
  gap: 24rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.cancel-btn {
  background-color: #f2f2f7;
  color: #000000;
}

.cancel-btn::after {
  border: none;
}

.cancel-btn:active {
  background-color: #e4e4e9;
}

.confirm-btn {
  background-color: #007aff;
  color: #ffffff;
  font-weight: 600;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  opacity: 0.85;
}

.confirm-btn[disabled] {
  background-color: #d1d1d6;
  color: rgba(255, 255, 255, 0.9);
  opacity: 1;
}
